@model FollowUpListViewModel
@{
    ViewData["Title"] = "Follow Ups";
}
<div class="space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <div class="flex items-center gap-2 text-sm font-semibold text-sky-600">
                <span class="material-symbols-outlined text-[20px]">notification_important</span>
                <span>Medical records</span>
            </div>
            <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Follow Ups</h2>
            <p class="mt-1 text-sm text-slate-500">@Model.TotalCount pending follow-up(s)</p>
        </div>
    </div>

    @* Date filter form *@
    <form asp-action="Index" method="get" class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
        <div class="grid gap-4 md:grid-cols-3 items-end">
            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="DateFrom">From date</label>
                <input asp-for="DateFrom" type="date"
                       class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
            </div>
            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="DateTo">To date</label>
                <input asp-for="DateTo" type="date"
                       class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
            </div>
            <div class="flex gap-2">
                <button type="submit"
                        class="flex-1 rounded-lg bg-sky-600 px-5 py-3 text-sm font-bold text-white hover:bg-sky-700">
                    Filter
                </button>
                <a asp-action="Index" class="rounded-lg border border-slate-300 px-4 py-3 text-sm font-bold text-slate-600 hover:bg-slate-50">
                    Clear
                </a>
            </div>
        </div>
    </form>

    @* Follow-ups table *@
    <div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
        <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Patient</th>
                    <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Doctor</th>
                    <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Follow-up date</th>
                    <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Diagnosis</th>
                    <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Visit date</th>
                    <th class="px-4 py-3"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (!Model.MedicalRecords.Any())
                {
                    <tr>
                        <td colspan="6" class="px-4 py-12 text-center text-sm text-slate-400">
                            <span class="material-symbols-outlined text-4xl block mb-2">event_available</span>
                            No follow-ups found in the selected range.
                        </td>
                    </tr>
                }
                @foreach (var record in Model.MedicalRecords)
                {
                    var isOverdue = record.FollowUpDate.HasValue && record.FollowUpDate.Value < DateTime.Now;
                    var isToday = record.FollowUpDate.HasValue && record.FollowUpDate.Value.Date == DateTime.Today;
                    <tr class="hover:bg-slate-50 transition-colors @(isOverdue ? "bg-red-50" : isToday ? "bg-amber-50" : "")">
                        <td class="px-4 py-4">
                            <a asp-controller="Patient" asp-action="Details" asp-route-id="@record.PatientId"
                               class="text-sm font-semibold text-sky-600 hover:underline">
                                @record.PatientName
                            </a>
                        </td>
                        <td class="px-4 py-4 text-sm text-slate-600">@record.DoctorName</td>
                        <td class="px-4 py-4">
                            @if (record.FollowUpDate.HasValue)
                            {
                                <span class="text-sm font-bold @(isOverdue ? "text-red-600" : isToday ? "text-amber-600" : "text-slate-700")">
                                    @record.FollowUpDate.Value.ToString("dd MMM yyyy")
                                    @if (isToday)
                                    {
                                        <span class="ml-1 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-bold text-amber-700">Today</span>
                                    }
                                    else if (isOverdue)
                                    {
                                        <span class="ml-1 rounded-full bg-red-100 px-2 py-0.5 text-xs font-bold text-red-700">Overdue</span>
                                    }
                                </span>
                            }
                            else
                            {
                                <span class="text-sm text-slate-400">—</span>
                            }
                        </td>
                        <td class="px-4 py-4 text-sm text-slate-700 max-w-xs truncate">@record.Diagnosis</td>
                        <td class="px-4 py-4 text-sm text-slate-500">@record.VisitDate.ToString("dd MMM yyyy")</td>
                        <td class="px-4 py-4 text-right">
                            <a asp-controller="MedicalRecord" asp-action="Details" asp-route-id="@record.Id"
                               class="inline-flex items-center gap-1 rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-50">
                                <span class="material-symbols-outlined text-[14px]">open_in_new</span>
                                View record
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>