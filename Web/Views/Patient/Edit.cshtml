<body class="bg-background text-on-background font-body-md selection:bg-primary/20"><input id="CurrentMvcView" type="hidden" value="Views/Patient/Edit.cshtml"/>
<!-- Suppressing SideNav and TopAppBar as per "The Destination Rule" for Transactional Screens -->
<main class="min-h-screen flex items-center justify-center p-xl relative overflow-hidden bg-gradient-to-br from-[#1A73E8] to-[#0F1F35]">
<!-- Abstract Decorative Elements -->
<div class="absolute top-0 left-0 w-full h-full opacity-10 pointer-events-none">
<div class="absolute -top-24 -left-24 w-96 h-96 bg-primary-fixed-dim rounded-full blur-3xl"></div>
<div class="absolute bottom-1/4 right-0 w-64 h-64 bg-secondary-fixed rounded-full blur-3xl"></div>
</div>
<div class="w-full max-w-2xl z-10">
<!-- Brand Logo / Header -->
<div class="flex flex-col items-center mb-lg">
<div class="w-16 h-16 bg-white rounded-xl shadow-lg flex items-center justify-center mb-md">
<span class="material-symbols-outlined text-primary text-4xl" data-icon="medical_services">medical_services</span>
</div>
<h1 class="font-h1 text-white text-center">ClinicSystem</h1>
<p class="font-body-lg text-primary-fixed/80 text-center mt-xs">Patient Registration Portal</p>
</div>
<!-- Registration Card -->
<div class="bg-white/95 backdrop-blur-md rounded-2xl shadow-2xl p-xxl border border-white/20">
<div class="mb-lg">
<h2 class="font-h2 text-on-surface">Create New Patient Account</h2>
<p class="font-body-md text-on-surface-variant mt-xs">Please provide your details to securely access your medical records.</p>
</div>
<!-- Registration Form -->
<form class="space-y-lg">
<div class="grid grid-cols-1 md:grid-cols-2 gap-lg"><!-- Full Name -->
<div class="flex flex-col gap-xs md:col-span-2">
<label class="font-label-md text-on-surface-variant">Full Name</label>
<input class="w-full h-12 px-md bg-surface-container-lowest rounded-lg border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary transition-all outline-none text-on-surface font-body-md" placeholder="Johnathan Doe" type="text"/>
</div>
<!-- National ID -->
<div class="flex flex-col gap-xs">
<label class="font-label-md text-on-surface-variant">National ID</label>
<input class="w-full h-12 px-md bg-surface-container-lowest rounded-lg border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary transition-all outline-none text-on-surface font-body-md" placeholder="X-XXXXXXX-X" type="text"/>
</div>
<!-- DOB -->
<div class="flex flex-col gap-xs">
<label class="font-label-md text-on-surface-variant">Date of Birth</label>
<input class="w-full h-12 px-md bg-surface-container-lowest rounded-lg border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary transition-all outline-none text-on-surface font-body-md" type="date"/>
</div>
<!-- Gender -->
<div class="flex flex-col gap-xs">
<label class="font-label-md text-on-surface-variant">Gender</label>
<select class="w-full h-12 px-md bg-surface-container-lowest rounded-lg border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary transition-all outline-none text-on-surface font-body-md">
<option disabled="" selected="" value="">Select Gender</option>
<option value="male">Male</option>
<option value="female">Female</option>
<option value="other">Other</option>
<option value="prefer_not_to_say">Prefer not to say</option>
</select>
</div>
<!-- Blood Type -->
<div class="flex flex-col gap-xs">
<label class="font-label-md text-on-surface-variant">Blood Type</label>
<select class="w-full h-12 px-md bg-surface-container-lowest rounded-lg border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary transition-all outline-none text-on-surface font-body-md">
<option disabled="" selected="" value="">Select Blood Type</option>
<option value="A+">A+</option>
<option value="A-">A-</option>
<option value="B+">B+</option>
<option value="B-">B-</option>
<option value="AB+">AB+</option>
<option value="AB-">AB-</option>
<option value="O+">O+</option>
<option value="O-">O-</option>
</select>
</div>
<!-- Phone -->
<div class="flex flex-col gap-xs">
<label class="font-label-md text-on-surface-variant">Phone Number</label>
<input class="w-full h-12 px-md bg-surface-container-lowest rounded-lg border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary transition-all outline-none text-on-surface font-body-md" placeholder="+1 (555) 000-0000" type="tel"/>
</div>
<!-- Email -->
<div class="flex flex-col gap-xs">
<label class="font-label-md text-on-surface-variant">Email Address</label>
<input class="w-full h-12 px-md bg-surface-container-lowest rounded-lg border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary transition-all outline-none text-on-surface font-body-md" placeholder="john.doe&#64;example.com" type="email"/>
</div>
<!-- Password -->
<div class="flex flex-col gap-xs">
<label class="font-label-md text-on-surface-variant">Password</label>
<input class="w-full h-12 px-md bg-surface-container-lowest rounded-lg border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary transition-all outline-none text-on-surface font-body-md" placeholder="••••••••" type="password"/>
</div>
<!-- Confirm Password -->
<div class="flex flex-col gap-xs">
<label class="font-label-md text-on-surface-variant">Confirm Password</label>
<input class="w-full h-12 px-md bg-surface-container-lowest rounded-lg border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary transition-all outline-none text-on-surface font-body-md" placeholder="••••••••" type="password"/>
</div></div>
<!-- Note Section -->
<div class="flex gap-sm bg-surface-container-low p-md rounded-lg items-center border border-outline-variant/30">
<span class="material-symbols-outlined text-primary/60 text-lg">info</span>
<p class="font-body-sm text-on-surface-variant/80">Existing patient files will be linked automatically via National ID.</p>
</div>
<!-- Action Button -->
<div class="pt-md">
<button class="w-full h-14 bg-primary text-on-primary font-label-md rounded-lg shadow-lg hover:bg-primary/90 active:scale-[0.98] transition-all flex items-center justify-center gap-xs hover:shadow-primary/20 hover:shadow-xl" type="submit">
                            Create Account
                            <span class="material-symbols-outlined" data-icon="arrow_forward">arrow_forward</span>
</button>
</div>
<div class="text-center">
<p class="font-body-md text-on-surface-variant">Already registered? <a class="text-primary font-label-md hover:underline" href="#">Login here</a></p>
</div>
</form>
</div>
<!-- Footer Decorative/Trust Badges -->
<div class="mt-lg grid grid-cols-2 gap-lg md:flex md:justify-center md:gap-xxl opacity-60">
<div class="flex items-center gap-xs text-white">
<span class="material-symbols-outlined" data-icon="security">security</span>
<span class="font-label-sm">Secure Encryption</span>
</div>
<div class="flex items-center gap-xs text-white">
<span class="material-symbols-outlined" data-icon="verified_user">verified_user</span>
<span class="font-label-sm">HIPAA Compliant</span>
</div>
</div>
</div>
<!-- Asymmetric Background Visual -->
<div class="hidden lg:block absolute -right-20 top-1/4 w-80 h-[500px] bg-white/5 border border-white/10 rounded-[60px] rotate-12 backdrop-blur-sm p-lg overflow-hidden">
<img class="w-full h-full object-cover rounded-3xl opacity-40 grayscale" data-alt="A macro close-up of a digital medical interface showing abstract DNA strands and health metrics in a professional blue and white color palette. The lighting is soft and corporate, creating a sterile yet inviting professional medical atmosphere. The composition is clean and minimalist, emphasizing high-end healthcare technology." src="https://lh3.googleusercontent.com/aida-public/AB6AXuAZTLTV4tAEwhUDuHcKrIrgx5_bMtpZdx0UzFIOohOHuaejCLmOmKsoSwuJyP2HxkMy7-gt6faMZlLRUpIKxRdEypmHkwBzEKFHDJ-LULVX1fx5T7I6XL1hS5N7rROy2JyE3mG_0Wo6-1YXSnksAdPHR9pG2FEUtIZ0S0Ym6NaHr1QRNx9mteQvC-iq0BarP9HNWu8bj60RV45OVK-xbrrTJLpzoALOeVpfCT1X2NB8D6hxfhKkUXwz4MuGu5WCPHROsHK3hQe_YOY"/>
</div>
</main>
<script src="/js/site.js"></script><script src="/js/schedule-form.js"></script><script src="/js/slot-picker.js"></script><script src="/js/invoice-builder.js"></script><script src="/js/appointment-calendar.js"></script></body></html>
