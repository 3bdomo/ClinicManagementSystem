<body class="bg-background text-on-background font-body-md selection:bg-primary/20 overflow-x-hidden"><input id="CurrentMvcView" type="hidden" value="Views/Patient/Create.cshtml"/>
<main class="min-h-screen flex flex-col lg:flex-row">
<!-- Brand/Hero Area (Left Side) -->
