@model PatientFormViewModel
@{
    ViewData["Title"] = "Create Patient File";
}
<div class="space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <div class="flex items-center gap-2 text-sm font-semibold text-sky-600">
                <span class="material-symbols-outlined text-[20px]">person_add</span>
                <a asp-action="Index" class="hover:underline">Patients</a>
                <span class="text-slate-300">/</span>
                <span>Create</span>
            </div>
            <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Create Patient File</h2>
        </div>
    </div>

    <form asp-action="Create" method="post" class="space-y-6">
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="mb-5 text-base font-black text-slate-900">Personal information</h3>
            <div class="grid gap-5 md:grid-cols-2">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2" asp-for="FullName">Full name</label>
                    <input asp-for="FullName" type="text" placeholder="Patient full name"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                    <span asp-validation-for="FullName" class="text-xs font-semibold text-red-600 mt-1 block"></span>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2" asp-for="NationalId">National ID</label>
                    <input asp-for="NationalId" type="text" placeholder="14 digits"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                    <span asp-validation-for="NationalId" class="text-xs font-semibold text-red-600 mt-1 block"></span>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2" asp-for="Phone">Phone</label>
                    <input asp-for="Phone" type="tel" placeholder="01000000000"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                    <span asp-validation-for="Phone" class="text-xs font-semibold text-red-600 mt-1 block"></span>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2" asp-for="DateOfBirth">Date of birth</label>
                    <input asp-for="DateOfBirth" type="date" value="2000-04-01"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                    <span asp-validation-for="DateOfBirth" class="text-xs font-semibold text-red-600 mt-1 block"></span>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2" asp-for="Gender">Gender</label>
                    <select asp-for="Gender" asp-items="Html.GetEnumSelectList<Common.Enums.Gender>()"
                            class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600">
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2" asp-for="BloodType">Blood type</label>
                    <select asp-for="BloodType" class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" asp-items="ViewBag.BloodTypes">
                        <option value="">Unknown</option>
                    </select>
                </div>
                <div class="md:col-span-2">
                    <label class="block text-sm font-semibold text-slate-700 mb-2" asp-for="Address">Address</label>
                    <textarea asp-for="Address" rows="3" placeholder="Patient home address"
                              class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600"></textarea>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2" asp-for="EmergencyContact">Emergency contact</label>
                    <input asp-for="EmergencyContact" type="tel" placeholder="Name - Phone"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                </div>
            </div>
        </div>

        <div class="flex justify-end gap-3 border-t border-slate-200 pt-5">
            <a asp-action="Index" class="rounded-lg px-5 py-3 text-sm font-bold text-slate-600 hover:bg-slate-100">
                Cancel
            </a>
            <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-sky-600 px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-sky-700">
                <span class="material-symbols-outlined text-[18px]">person_add</span>
                Create patient
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScripts")
}