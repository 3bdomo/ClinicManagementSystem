<div class="absolute bottom-0 right-0 w-full h-full bg-[radial-gradient(circle_at_bottom_right,_var(--tw-gradient-stops))] from-secondary-container/20 to-transparent"></div>
<div class="absolute inset-0" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDGwboeOPCcLqANivntsyoIIuk1g0AQkJl69O6jeZUKmn7NnkkgExu60HGeLWe8rC8BC0SJ4Jlw6yiQOBKA-MuMOmM6LZ1smDzdHlNW90dnksW29tXlaEcadVlSo74AF1cWGBv3A47GSBAFwKw5v5MNsLnul0KUUabgzp_2U5Z7tzio9WsWOHSB2wau_TrmBOA15WGUlozDeRK42ODAmDOew0Wph0DhXMJk00M5Ekp5Y95tDGrCEgey_n7i1Uw4V7gdEDlrXEtsHVo'); opacity: 0.05;"></div>
</div>
<!-- Content -->
<div class="relative z-10">
<div class="flex items-center gap-md mb-xxl">
<div class="w-12 h-12 bg-white rounded-xl shadow-lg flex items-center justify-center">
<span class="material-symbols-outlined text-primary text-3xl" data-icon="medical_services">medical_services</span>
</div>
<span class="font-h2 tracking-tight">ClinicSystem</span>
</div>
<div class="space-y-lg max-w-md">
<h1 class="font-h1 leading-tight">Advanced Healthcare, Simplified.</h1>
<p class="font-body-lg text-primary-fixed/70">Join thousands of patients who manage their health journey with our intuitive, secure, and HIPAA-compliant platform.</p>
<ul class="space-y-md pt-lg">
<li class="flex items-center gap-md">
<span class="material-symbols-outlined text-secondary-fixed shrink-0" data-icon="check_circle">check_circle</span>
<span class="font-body-md text-white/90">Instant access to medical records</span>
</li>
<li class="flex items-center gap-md">
<span class="material-symbols-outlined text-secondary-fixed shrink-0" data-icon="check_circle">check_circle</span>
<span class="font-body-md text-white/90">Direct communication with specialists</span>
</li>
<li class="flex items-center gap-md">
<span class="material-symbols-outlined text-secondary-fixed shrink-0" data-icon="check_circle">check_circle</span>
<span class="font-body-md text-white/90">24/7 online appointment booking</span>
</li>
</ul>
</div>
</div>
<div class="relative z-10 pt-xxl">
<div class="p-lg bg-white/5 backdrop-blur-md rounded-2xl border border-white/10 flex items-center gap-md">
<img alt="Doctor profile" class="w-12 h-12 rounded-full object-cover border-2 border-white/20" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCqNCrzdUrjciKZMCbIOW0y_-W0dKaIrxe5fTkZHR8IgVS469CTDp42d_4iL9ICesD3BmWlbnmcrn-bykbQISnH77e1_oltL2U0qkWxOdBFKQblVUAWJqtpI1x4R5XvghYtWvs1weCIZwrVa7l02LqevKJAG6kvH6RkzB4BypZGXfJs484qivfu03KN7aVzALMlihGAQQN6GnyLRuMAnZ6Myx6LJ_r2zoWKCPW1Enf6D8ea4CihzXvA8eIsBl0pYVTZHFiAteh_52E"/>
<div>
<p class="font-label-md text-white">Trust and Security</p>
<p class="font-body-sm text-white/60">Your data is encrypted and protected by enterprise-grade security protocols.</p>
</div>
</div>
<div class="mt-lg flex items-center gap-xxl opacity-40">
<div class="flex items-center gap-xs">
<span class="material-symbols-outlined text-sm" data-icon="security">security</span>
<span class="font-label-sm uppercase tracking-wider">Secure</span>
</div>
<div class="flex items-center gap-xs">
<span class="material-symbols-outlined text-sm" data-icon="verified_user">verified_user</span>
<span class="font-label-sm uppercase tracking-wider">HIPAA Compliant</span>
</div>
</div>
