</div>
</section>
<!-- Registration Form (Right Side) -->
<section class="lg:w-[60%] flex items-center justify-center p-xl lg:p-xxl bg-white">
<div class="w-full max-w-xl">
<div class="mb-xxl">
<h2 class="font-h1 text-on-surface mb-xs">Create Patient Account</h2>
<p class="font-body-lg text-on-surface-variant">Welcome! Let's get your profile set up in a few easy steps.</p>
</div>
<form class="space-y-xl">
<!-- Section: Personal Information -->
<div class="space-y-lg">
<div class="flex items-center gap-sm pb-xs border-b border-outline-variant">
<span class="material-symbols-outlined text-primary" data-icon="person">person</span>
<h3 class="font-h3 text-on-surface">Personal Information</h3>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-lg">
<div class="flex flex-col gap-xs md:col-span-2 group form-input-focus">
<label class="font-label-md text-on-surface-variant transition-colors">Full Name</label>
<input class="w-full h-12 px-md bg-surface-container-lowest rounded-lg border border-outline-variant focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all outline-none text-on-surface font-body-md" placeholder="Johnathan Doe" type="text"/>
</div>
<div class="flex flex-col gap-xs group form-input-focus">
<label class="font-label-md text-on-surface-variant transition-colors">National ID</label>
<input class="w-full h-12 px-md bg-surface-container-lowest rounded-lg border border-outline-variant focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all outline-none text-on-surface font-body-md" placeholder="X-XXXXXXX-X" type="text"/>
</div>
<div class="flex flex-col gap-xs group form-input-focus">
<label class="font-label-md text-on-surface-variant transition-colors">Date of Birth</label>
<input class="w-full h-12 px-md bg-surface-container-lowest rounded-lg border border-outline-variant focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all outline-none text-on-surface font-body-md" type="date"/>
</div>
<div class="flex flex-col gap-xs group form-input-focus">
<label class="font-label-md text-on-surface-variant transition-colors">Gender</label>
<select class="w-full h-12 px-md bg-surface-container-lowest rounded-lg border border-outline-variant focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all outline-none text-on-surface font-body-md">
<option disabled="" selected="" value="">Select Gender</option>
<option value="male">Male</option>
<option value="female">Female</option>
<option value="other">Other</option>
<option value="prefer_not_to_say">Prefer not to say</option>
</select>
</div>
<div class="flex flex-col gap-xs group form-input-focus">
<label class="font-label-md text-on-surface-variant transition-colors">Blood Type</label>
<select class="w-full h-12 px-md bg-surface-container-lowest rounded-lg border border-outline-variant focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all outline-none text-on-surface font-body-md">
<option disabled="" selected="" value="">Select Blood Type</option>
<option value="A+">A+</option>
<option value="A-">A-</option>
<option value="B+">B+</option>
<option value="B-">B-</option>
<option value="AB+">AB+</option>
<option value="AB-">AB-</option>
<option value="O+">O+</option>
<option value="O-">O-</option>
</select>
</div>
</div>
</div>
<!-- Section: Contact & Security -->
<div class="space-y-lg">
<div class="flex items-center gap-sm pb-xs border-b border-outline-variant">
<span class="material-symbols-outlined text-primary" data-icon="contact_page">contact_page</span>
<h3 class="font-h3 text-on-surface">Contact &amp; Security</h3>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-lg">
<div class="flex flex-col gap-xs group form-input-focus">
<label class="font-label-md text-on-surface-variant transition-colors">Phone Number</label>
<input class="w-full h-12 px-md bg-surface-container-lowest rounded-lg border border-outline-variant focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all outline-none text-on-surface font-body-md" placeholder="+1 (555) 000-0000" type="tel"/>
</div>
<div class="flex flex-col gap-xs group form-input-focus">
<label class="font-label-md text-on-surface-variant transition-colors">Email Address</label>
<input class="w-full h-12 px-md bg-surface-container-lowest rounded-lg border border-outline-variant focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all outline-none text-on-surface font-body-md" placeholder="john.doe&#64;example.com" type="email"/>
</div>
<div class="flex flex-col gap-xs group form-input-focus">
<label class="font-label-md text-on-surface-variant transition-colors">Password</label>
<input class="w-full h-12 px-md bg-surface-container-lowest rounded-lg border border-outline-variant focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all outline-none text-on-surface font-body-md" placeholder="••••••••" type="password"/>
</div>
<div class="flex flex-col gap-xs group form-input-focus">
<label class="font-label-md text-on-surface-variant transition-colors">Confirm Password</label>
<input class="w-full h-12 px-md bg-surface-container-lowest rounded-lg border border-outline-variant focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all outline-none text-on-surface font-body-md" placeholder="••••••••" type="password"/>
</div>
</div>
</div>
<!-- Informational Note -->
<div class="flex gap-md bg-primary-fixed/10 p-md rounded-xl items-center">
<span class="material-symbols-outlined text-primary text-xl">info</span>
<p class="font-body-sm text-on-surface">Existing patient files will be linked automatically via National ID.</p>
</div>
<!-- Action Buttons -->
<div class="pt-lg space-y-md">
<button class="w-full h-14 bg-primary text-on-primary font-label-md rounded-xl shadow-[0_8px_30px_rgb(0,91,191,0.2)] hover:shadow-[0_8px_35px_rgb(0,91,191,0.4)] active:scale-[0.98] transition-all flex items-center justify-center gap-xs" type="submit">
                            Create Account
                            <span class="material-symbols-outlined" data-icon="arrow_forward">arrow_forward</span>
</button>
<div class="text-center">
<p class="font-body-md text-on-surface-variant">Already registered? <a class="text-primary font-label-md hover:underline decoration-2 underline-offset-4" href="#">Login here</a></p>
</div>
</div>
</form>
</div>
</section>
</main>
<script src="/js/site.js"></script><script src="/js/schedule-form.js"></script><script src="/js/slot-picker.js"></script><script src="/js/invoice-builder.js"></script><script src="/js/appointment-calendar.js"></script></body></html>
