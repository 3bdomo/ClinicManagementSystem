@model PatientDetailsViewModel
@{
    ViewData["Title"] = "Patient Details";
    var p = Model.Patient;
}
<div class="space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div>
            <div class="flex items-center gap-2 text-sm font-semibold text-sky-600">
                <span class="material-symbols-outlined text-[20px]">clinical_notes</span>
                <a asp-action="Index" class="hover:underline">Patients</a>
                <span class="text-slate-300">/</span>
                <span>@p.FullName</span>
            </div>
            <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">@p.FullName</h2>
            <p class="mt-1 text-sm text-slate-500">Patient file · ID #@p.Id</p>
        </div>
        <div class="flex flex-wrap gap-2">
            @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
            {
                <a asp-action="Edit" asp-route-id="@p.Id"
                   class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-700 shadow-sm hover:bg-slate-50">
                    <span class="material-symbols-outlined text-[16px]">edit</span>
                    Edit file
                </a>
                <a asp-controller="Appointment" asp-action="Book"
                   class="inline-flex items-center gap-2 rounded-lg bg-sky-600 px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-sky-700">
                    <span class="material-symbols-outlined text-[16px]">event_available</span>
                    Book appointment
                </a>
            }
        </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
        @* Patient Info Card *@
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-4 border-b border-slate-100 pb-4">
                <div class="flex h-14 w-14 items-center justify-center rounded-full bg-sky-100 text-2xl font-black text-sky-600">
                    @p.FullName.FirstOrDefault()
                </div>
                <div>
                    <h3 class="text-lg font-black text-slate-950">@p.FullName</h3>
                    @if (p.HasPortalAccount)
                    {
                        <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-bold text-emerald-700">
                            <span class="material-symbols-outlined text-[12px]">check_circle</span> Portal active
                        </span>
                    }
                </div>
            </div>
            <dl class="mt-4 space-y-3 text-sm">
                <div class="flex justify-between">
                    <dt class="font-bold text-slate-500">Gender</dt>
                    <dd class="font-semibold text-slate-900">@p.Gender</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="font-bold text-slate-500">Age</dt>
                    <dd class="font-semibold text-slate-900">@p.Age years old</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="font-bold text-slate-500">Date of birth</dt>
                    <dd class="font-semibold text-slate-900">@p.DateOfBirth.ToString("yyyy-MM-dd")</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="font-bold text-slate-500">National ID</dt>
                    <dd class="font-mono font-semibold text-slate-900">@p.NationalId</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="font-bold text-slate-500">Phone</dt>
                    <dd class="font-semibold text-slate-900">@p.Phone</dd>
                </div>
                @if (!string.IsNullOrWhiteSpace(p.BloodType))
                {
                    <div class="flex justify-between">
                        <dt class="font-bold text-slate-500">Blood type</dt>
                        <dd class="font-bold text-red-600">@p.BloodType</dd>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(p.Address))
                {
                    <div>
                        <dt class="font-bold text-slate-500">Address</dt>
                        <dd class="mt-1 text-slate-700">@p.Address</dd>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(p.EmergencyContact))
                {
                    <div>
                        <dt class="font-bold text-slate-500">Emergency contact</dt>
                        <dd class="mt-1 text-slate-700">@p.EmergencyContact</dd>
                    </div>
                }
            </dl>
        </div>

        @* Summary Cards *@
        <div class="lg:col-span-2 space-y-4">
            <div class="grid gap-4 sm:grid-cols-3">
                <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm text-center">
                    <span class="material-symbols-outlined text-2xl text-sky-600">event</span>
                    <p class="mt-2 text-2xl font-black">@Model.Appointments.Count()</p>
                    <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Appointments</p>
                </div>
                <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm text-center">
                    <span class="material-symbols-outlined text-2xl text-sky-600">clinical_notes</span>
                    <p class="mt-2 text-2xl font-black">@Model.MedicalRecords.Count()</p>
                    <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Medical Records</p>
                </div>
                <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm text-center">
                    <span class="material-symbols-outlined text-2xl text-amber-500">receipt_long</span>
                    <p class="mt-2 text-2xl font-black">@Model.Invoices.Count(i => i.Status == Common.Enums.InvoiceStatus.Unpaid)</p>
                    <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Unpaid Invoices</p>
                </div>
            </div>
            @await Component.InvokeAsync("AuditInfo", Model.AuditInfo)
        </div>
    </div>

    @* Appointments Table *@
    <div class="rounded-lg border border-slate-200 bg-white shadow-sm">
        <div class="flex items-center justify-between border-b border-slate-100 px-6 py-4">
            <h3 class="text-lg font-black">Appointments</h3>
            @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
            {
                <a asp-controller="Appointment" asp-action="Book"
                   class="inline-flex items-center gap-2 rounded-lg bg-sky-600 px-3 py-1.5 text-xs font-bold text-white">
                    <span class="material-symbols-outlined text-[14px]">add</span>
                    Book
                </a>
            }
        </div>
        @if (Model.Appointments.Any())
        {
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Date</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Doctor</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Type</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Status</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Record</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Invoice</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var a in Model.Appointments)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-4 py-4 text-sm text-slate-700">@a.AppointmentDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="px-4 py-4 text-sm text-slate-700">@a.DoctorName</td>
                            <td class="px-4 py-4 text-sm text-slate-600">@a.AppointmentType</td>
                            <td class="px-4 py-4">
                                <span class="inline-flex rounded-full px-2 py-0.5 text-xs font-bold
                                    @(a.Status == Common.Enums.AppointmentStatus.Completed ? "bg-emerald-50 text-emerald-700" :
                                      a.Status == Common.Enums.AppointmentStatus.InProgress ? "bg-blue-50 text-blue-700" :
                                      a.Status == Common.Enums.AppointmentStatus.Cancelled ? "bg-red-50 text-red-700" :
                                      "bg-amber-50 text-amber-700")">
                                    @a.Status
                                </span>
                            </td>
                            <td class="px-4 py-4 text-sm">
                                @if (a.HasMedicalRecord)
                                {
                                    <span class="font-bold text-emerald-600">Recorded</span>
                                }
                                else if (a.Status == Common.Enums.AppointmentStatus.Completed && User.IsInRole("Doctor"))
                                {
                                    <a asp-controller="MedicalRecord" asp-action="Create"
                                       class="font-bold text-sky-600 hover:underline">Add record</a>
                                }
                                else
                                {
                                    <span class="text-slate-400">—</span>
                                }
                            </td>
                            <td class="px-4 py-4 text-sm">
                                @if (a.HasInvoice)
                                {
                                    <span class="font-bold text-emerald-600">Invoiced</span>
                                }
                                else if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
                                {
                                    <a asp-controller="Billing" asp-action="Create"
                                       class="font-bold text-sky-600 hover:underline">Create invoice</a>
                                }
                                else
                                {
                                    <span class="text-slate-400">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="p-8 text-center text-sm text-slate-500">No appointments for this patient.</div>
        }
    </div>

    @* Medical Records *@
    @if (Model.MedicalRecords.Any())
    {
        <div class="rounded-lg border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-100 px-6 py-4">
                <h3 class="text-lg font-black">Medical Records</h3>
            </div>
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Visit date</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Doctor</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Diagnosis</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Follow-up</th>
                        <th class="px-4 py-3"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var r in Model.MedicalRecords)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-4 py-4 text-sm text-slate-700">@r.VisitDate.ToString("yyyy-MM-dd")</td>
                            <td class="px-4 py-4 text-sm text-slate-700">@r.DoctorName</td>
                            <td class="px-4 py-4 text-sm text-slate-700 max-w-xs truncate">@r.Diagnosis</td>
                            <td class="px-4 py-4 text-sm text-slate-600">
                                @(r.FollowUpDate.HasValue ? r.FollowUpDate.Value.ToString("yyyy-MM-dd") : "—")
                            </td>
                            <td class="px-4 py-4 text-right">
                                <a asp-controller="MedicalRecord" asp-action="Details" asp-route-id="@r.Id"
                                   class="text-sm font-bold text-sky-600 hover:underline">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* Invoices *@
    @if (Model.Invoices.Any())
    {
        <div class="rounded-lg border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-100 px-6 py-4">
                <h3 class="text-lg font-black">Invoices</h3>
            </div>
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Invoice #</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Amount</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Status</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Date</th>
                        <th class="px-4 py-3"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var inv in Model.Invoices)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-4 py-4 text-sm font-mono font-bold text-slate-700">#@inv.Id</td>
                            <td class="px-4 py-4 text-sm font-bold text-slate-900">@inv.TotalAmount.ToString("N0") EGP</td>
                            <td class="px-4 py-4">
                                <span class="inline-flex rounded-full px-2 py-0.5 text-xs font-bold
                                    @(inv.Status == Common.Enums.InvoiceStatus.Paid ? "bg-emerald-50 text-emerald-700" :
                                      inv.Status == Common.Enums.InvoiceStatus.PartiallyPaid ? "bg-blue-50 text-blue-700" :
                                      "bg-amber-50 text-amber-700")">
                                    @inv.Status
                                </span>
                            </td>
                            <td class="px-4 py-4 text-sm text-slate-600">@inv.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td class="px-4 py-4 text-right">
                                <a asp-controller="Billing" asp-action="Details" asp-route-id="@inv.Id"
                                   class="text-sm font-bold text-sky-600 hover:underline">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>