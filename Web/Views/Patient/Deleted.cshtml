@model DeletedPatientsViewModel
@{
    ViewData["Title"] = "Deleted Patients";
}
<div class="space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <div class="flex items-center gap-2 text-sm font-semibold text-sky-600">
                <span class="material-symbols-outlined text-[20px]">restore_from_trash</span>
                <a asp-action="Index" class="hover:underline">Patients</a>
                <span class="text-slate-300">/</span>
                <span>Deleted</span>
            </div>
            <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Deleted Patients</h2>
            <p class="mt-2 text-sm text-slate-500">
                @Model.DeletedPatients.Count() soft-deleted patient file(s). Admin can restore any record.
            </p>
        </div>
    </div>

    <div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
        @if (Model.DeletedPatients.Any())
        {
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Patient</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">National ID</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Phone</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Deleted at</th>
                        <th class="px-4 py-3"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var p in Model.DeletedPatients)
                    {
                        <tr class="hover:bg-slate-50 bg-red-50/30 transition-colors">
                            <td class="px-4 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="flex h-9 w-9 items-center justify-center rounded-full bg-red-100 text-sm font-black text-red-500">
                                        @p.FullName.FirstOrDefault()
                                    </div>
                                    <div>
                                        <p class="text-sm font-semibold text-slate-700 line-through">@p.FullName</p>
                                        <p class="text-xs text-slate-500">@p.Gender · @p.Age y</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-4 py-4 text-sm font-mono text-slate-600">@p.NationalId</td>
                            <td class="px-4 py-4 text-sm text-slate-600">@p.Phone</td>
                            <td class="px-4 py-4 text-sm text-slate-600">
                                @(p.DeletedAt.HasValue ? p.DeletedAt.Value.ToString("yyyy-MM-dd") : "—")
                            </td>
                            <td class="px-4 py-4 text-right">
                                <form asp-action="Restore" asp-route-id="@p.Id" method="post" class="inline">
                                    <button type="submit"
                                            class="inline-flex items-center gap-1 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-xs font-bold text-emerald-700 hover:bg-emerald-100"
                                            onclick="return confirm('Restore @p.FullName?')">
                                        <span class="material-symbols-outlined text-[14px]">restore_from_trash</span>
                                        Restore
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="p-10 text-center">
                <span class="material-symbols-outlined text-5xl text-slate-300">check_circle</span>
                <p class="mt-3 text-sm font-semibold text-slate-500">No deleted patients. All records are active.</p>
                <a asp-action="Index" class="mt-4 inline-flex items-center gap-2 rounded-lg bg-sky-600 px-4 py-2 text-sm font-bold text-white">
                    Back to patients
                </a>
            </div>
        }
    </div>
</div>