@model PatientListViewModel
@{
    ViewData["Title"] = "Patient Search";
}
<div class="space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <div class="flex items-center gap-2 text-sm font-semibold text-sky-600">
                <span class="material-symbols-outlined text-[20px]">manage_search</span>
                <span>Patient management</span>
            </div>
            <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Patient Search</h2>
            <p class="mt-2 text-sm text-slate-500">Find a patient, then open details, edit, appointments, billing, or records.</p>
        </div>
 
        @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
        {
            <a asp-action="Create" class="inline-flex items-center gap-2 rounded-lg bg-sky-600 px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-sky-700">
                <span class="material-symbols-outlined text-[18px]">person_add</span>
                Create patient
            </a>
        }
    </div>
   

    <form method="get" asp-action="Index" class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
        <div class="grid gap-4 md:grid-cols-[1fr_auto] md:items-end">
            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700" for="SearchQuery">
                    Search by patient name, national ID, or phone
                </label>
                <input id="SearchQuery" name="SearchQuery" value="@Model.SearchQuery" type="search"
                       class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600"
                       placeholder="Ahmed, 29901011234567, 010..." />
            </div>
            <button class="inline-flex items-center justify-center gap-2 rounded-lg bg-slate-950 px-5 py-3 text-sm font-bold text-white hover:bg-slate-800" type="submit">
                <span class="material-symbols-outlined text-[18px]">search</span>
                Search
            </button>
        </div>
    </form>

    <div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
        @if (Model.Patients.Any())
        {
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Patient</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Age / Gender</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">National ID</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Phone</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Portal</th>
                        <th class="px-4 py-3"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var p in Model.Patients)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-4 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="flex h-9 w-9 items-center justify-center rounded-full bg-sky-100 text-sm font-black text-sky-600">
                                        @p.FullName.FirstOrDefault()
                                    </div>
                                    <span class="text-sm font-semibold text-slate-900">@p.FullName</span>
                                </div>
                            </td>
                            <td class="px-4 py-4 text-sm text-slate-600">@p.Age y / @p.Gender</td>
                            <td class="px-4 py-4 text-sm font-mono text-slate-700">@p.NationalId</td>
                            <td class="px-4 py-4 text-sm text-slate-700">@p.Phone</td>
                            <td class="px-4 py-4">
                                @if (p.HasPortalAccount)
                                {
                                    <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-bold text-emerald-700">
                                        <span class="material-symbols-outlined text-[12px]">check_circle</span> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-0.5 text-xs font-bold text-slate-500">
                                        No portal
                                    </span>
                                }
                            </td>
                            <td class="px-4 py-4 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <a asp-action="Details" asp-route-id="@p.Id"
                                       class="rounded-lg px-3 py-1.5 text-xs font-bold text-sky-600 hover:bg-sky-50">
                                        Details
                                    </a>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@p.Id"
                                           class="rounded-lg px-3 py-1.5 text-xs font-bold text-slate-600 hover:bg-slate-100">
                                            Edit
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="p-10 text-center">
                <span class="material-symbols-outlined text-5xl text-slate-300">person_search</span>
                <p class="mt-3 text-sm font-semibold text-slate-500">
                    @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                    {
                        <text>No patients found for "@Model.SearchQuery".</text>
                    }
                    else
                    {
                        <text>No patients registered yet.</text>
                    }
                </p>
                @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
                {
                    <a asp-action="Create" class="mt-4 inline-flex items-center gap-2 rounded-lg bg-sky-600 px-4 py-2 text-sm font-bold text-white">
                        <span class="material-symbols-outlined text-[16px]">person_add</span>
                        Create first patient
                    </a>
                }
            </div>
        }
    </div>
</div>
