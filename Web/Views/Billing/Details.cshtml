@model InvoiceDetailsViewModel
@{
    ViewData["Title"] = "Invoice Details";
    var inv = Model.Invoice;
}
<div class="space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div>
            <div class="flex items-center gap-2 text-sm font-semibold text-sky-600">
                <span class="material-symbols-outlined text-[20px]">receipt_long</span>
                <a asp-action="Index" class="hover:underline">Billing</a>
                <span class="text-slate-300">/</span>
                <span>Invoice #@inv.Id</span>
            </div>
            <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Invoice #@inv.Id</h2>
        </div>
        @if (inv.Status != Common.Enums.InvoiceStatus.Paid && (User.IsInRole("Admin") || User.IsInRole("Receptionist")))
        {
            <form asp-action="MarkAsPaid" asp-route-id="@inv.Id" method="post" class="inline">
                <button type="submit"
                        class="inline-flex items-center gap-2 rounded-lg bg-emerald-600 px-5 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-emerald-700"
                        onclick="return confirm('Mark invoice #@inv.Id as paid?')">
                    <span class="material-symbols-outlined text-[18px]">check_circle</span>
                    Mark as paid
                </button>
            </form>
        }
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
        @* Invoice Header *@
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-black">Invoice information</h3>
            <dl class="mt-4 space-y-4 text-sm">
                <div>
                    <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Patient</dt>
                    <dd class="mt-0.5">
                        <a asp-controller="Patient" asp-action="Details" asp-route-id="@inv.PatientId"
                           class="font-semibold text-sky-600 hover:underline">@inv.PatientName</a>
                    </dd>
                </div>
                @if (!string.IsNullOrWhiteSpace(inv.DoctorName))
                {
                    <div>
                        <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Doctor</dt>
                        <dd class="mt-0.5 font-semibold text-slate-900">@inv.DoctorName</dd>
                    </div>
                }
                <div>
                    <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Appointment</dt>
                    <dd class="mt-0.5 font-mono text-slate-700">#@inv.AppointmentId</dd>
                </div>
                <div>
                    <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Total amount</dt>
                    <dd class="mt-0.5 text-3xl font-black text-slate-900">@inv.TotalAmount.ToString("N0") EGP</dd>
                </div>
                <div>
                    <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Created at</dt>
                    <dd class="mt-0.5 text-slate-700">@inv.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                </div>
            </dl>
        </div>

        @* Payment Status *@
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-black">Payment status</h3>
            <div class="mt-5 rounded-lg p-5 text-center
                @(inv.Status == Common.Enums.InvoiceStatus.Paid ? "bg-emerald-50" :
                  inv.Status == Common.Enums.InvoiceStatus.PartiallyPaid ? "bg-blue-50" : "bg-amber-50")">
                <span class="material-symbols-outlined text-4xl
                    @(inv.Status == Common.Enums.InvoiceStatus.Paid ? "text-emerald-600" :
                      inv.Status == Common.Enums.InvoiceStatus.PartiallyPaid ? "text-blue-600" : "text-amber-600")">
                    @(inv.Status == Common.Enums.InvoiceStatus.Paid ? "check_circle" :
                      inv.Status == Common.Enums.InvoiceStatus.PartiallyPaid ? "pending" : "schedule")
                </span>
                <p class="mt-2 text-lg font-black
                    @(inv.Status == Common.Enums.InvoiceStatus.Paid ? "text-emerald-700" :
                      inv.Status == Common.Enums.InvoiceStatus.PartiallyPaid ? "text-blue-700" : "text-amber-700")">
                    @inv.Status
                </p>
                @if (inv.PaidAt.HasValue)
                {
                    <p class="mt-1 text-sm text-slate-500">Paid on @inv.PaidAt.Value.ToString("yyyy-MM-dd")</p>
                }
            </div>
        </div>
    </div>

    @* Invoice Items *@
    <div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-100 px-6 py-4">
            <h3 class="text-lg font-black">Invoice items</h3>
        </div>
        @if (Model.Items.Any())
        {
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Description</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Type</th>
                        <th class="px-4 py-3 text-right text-xs font-black uppercase tracking-wider text-slate-500">Qty</th>
                        <th class="px-4 py-3 text-right text-xs font-black uppercase tracking-wider text-slate-500">Unit price</th>
                        <th class="px-4 py-3 text-right text-xs font-black uppercase tracking-wider text-slate-500">Total</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var item in Model.Items)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-4 py-4 text-sm font-semibold text-slate-900">@item.Description</td>
                            <td class="px-4 py-4 text-sm text-slate-600">@item.ItemType</td>
                            <td class="px-4 py-4 text-right text-sm text-slate-700">@item.Quantity</td>
                            <td class="px-4 py-4 text-right text-sm text-slate-700">@item.UnitPrice.ToString("N0") EGP</td>
                            <td class="px-4 py-4 text-right text-sm font-bold text-slate-900">@item.Total.ToString("N0") EGP</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="bg-slate-50 border-t-2 border-slate-200">
                    <tr>
                        <td colspan="4" class="px-4 py-4 text-right text-sm font-black text-slate-700">Grand Total:</td>
                        <td class="px-4 py-4 text-right text-base font-black text-slate-900">@inv.TotalAmount.ToString("N0") EGP</td>
                    </tr>
                </tfoot>
            </table>
        }
        else
        {
            <div class="p-8 text-center text-sm text-slate-500">No items on this invoice.</div>
        }
    </div>

    @* Audit Info *@
    <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        <h3 class="text-lg font-black mb-4">Audit information</h3>
        @await Html.PartialAsync("_AuditInfo", Model.AuditInfo)
    </div>
</div>