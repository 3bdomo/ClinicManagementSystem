@model InvoiceListViewModel
@{
    ViewData["Title"] = "Billing";
}
<div class="space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <div class="flex items-center gap-2 text-sm font-semibold text-sky-600">
                <span class="material-symbols-outlined text-[20px]">receipt_long</span>
                <span>Billing</span>
            </div>
            <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Billing &amp; Invoices</h2>
            <p class="mt-1 text-sm text-slate-500">@Model.TotalCount invoice(s) · Revenue: @Model.TotalRevenue.ToString("N0") EGP</p>
        </div>
    </div>

    @* Stats *@
    <div class="grid gap-4 md:grid-cols-3">
        <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
            <span class="material-symbols-outlined text-xl text-sky-600">receipt_long</span>
            <p class="mt-3 text-sm font-bold text-slate-500">Total invoices</p>
            <p class="mt-1 text-2xl font-black">@Model.TotalCount</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
            <span class="material-symbols-outlined text-xl text-emerald-500">check_circle</span>
            <p class="mt-3 text-sm font-bold text-slate-500">Paid</p>
            <p class="mt-1 text-2xl font-black text-emerald-600">@Model.PaidCount</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
            <span class="material-symbols-outlined text-xl text-amber-500">pending</span>
            <p class="mt-3 text-sm font-bold text-slate-500">Unpaid</p>
            <p class="mt-1 text-2xl font-black text-amber-600">@Model.UnpaidCount</p>
        </div>
    </div>

    @* Filters + New Invoice *@
    <form method="get" asp-action="Index" class="grid gap-4 rounded-lg border border-slate-200 bg-white p-4 shadow-sm md:grid-cols-4 md:items-end">
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2" for="Status">Status</label>
            <select id="Status" name="Status" class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600">
                <option value="">All</option>
                @foreach (var s in Html.GetEnumSelectList<Common.Enums.InvoiceStatus>())
                {
                    <option value="@s.Value" selected="@(s.Value == Model.Status?.ToString())">@s.Text</option>
                }
            </select>
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2" for="DateFrom">From</label>
            <input id="DateFrom" name="DateFrom" type="date"
                   value="@Model.DateFrom?.ToString("yyyy-MM-dd")"
                   class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2" for="DateTo">To</label>
            <input id="DateTo" name="DateTo" type="date"
                   value="@Model.DateTo?.ToString("yyyy-MM-dd")"
                   class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
        </div>
        <div class="flex gap-2">
            <button type="submit" class="flex-1 rounded-lg bg-slate-950 px-3 py-3 text-sm font-bold text-white hover:bg-slate-800">
                Filter
            </button>
            <a asp-action="Create" class="flex-1 rounded-lg bg-sky-600 px-3 py-3 text-center text-sm font-bold text-white hover:bg-sky-700">
                + New
            </a>
        </div>
    </form>

    @* Invoices Table *@
    <div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
        @if (Model.Invoices.Any())
        {
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Invoice #</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Patient</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Doctor</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Amount</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Status</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Date</th>
                        <th class="px-4 py-3"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var inv in Model.Invoices)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-4 py-4 text-sm font-mono font-bold text-slate-700">#@inv.Id</td>
                            <td class="px-4 py-4">
                                <a asp-controller="Patient" asp-action="Details" asp-route-id="@inv.PatientId"
                                   class="text-sm font-semibold text-slate-900 hover:text-sky-600">@inv.PatientName</a>
                            </td>
                            <td class="px-4 py-4 text-sm text-slate-600">@(inv.DoctorName ?? "—")</td>
                            <td class="px-4 py-4 text-sm font-bold text-slate-900">@inv.TotalAmount.ToString("N0") EGP</td>
                            <td class="px-4 py-4">
                                <span class="inline-flex rounded-full px-2 py-0.5 text-xs font-bold
                                    @(inv.Status == Common.Enums.InvoiceStatus.Paid ? "bg-emerald-50 text-emerald-700" :
                                      inv.Status == Common.Enums.InvoiceStatus.PartiallyPaid ? "bg-blue-50 text-blue-700" :
                                      "bg-amber-50 text-amber-700")">
                                    @inv.Status
                                </span>
                            </td>
                            <td class="px-4 py-4 text-sm text-slate-600">@inv.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td class="px-4 py-4 text-right">
                                <a asp-action="Details" asp-route-id="@inv.Id"
                                   class="text-sm font-bold text-sky-600 hover:underline">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="p-10 text-center">
                <span class="material-symbols-outlined text-5xl text-slate-300">receipt_long</span>
                <p class="mt-3 text-sm font-semibold text-slate-500">No invoices found for the selected filters.</p>
            </div>
        }
    </div>
</div>