@model DailyReportViewModel
@{
    ViewData["Title"] = "Daily Billing Report";
}
<div class="space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <div class="flex items-center gap-2 text-sm font-semibold text-sky-600">
                <span class="material-symbols-outlined text-[20px]">summarize</span>
                <span>Billing reports</span>
            </div>
            <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Daily Billing Report</h2>
            <p class="mt-1 text-sm text-slate-500">
                Showing report for <strong>@Model.SelectedDate.ToString("dd MMM yyyy")</strong>
            </p>
        </div>
        <a asp-action="Index" class="inline-flex items-center gap-2 rounded-lg border border-slate-300 px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50">
            <span class="material-symbols-outlined text-[18px]">receipt_long</span>
            All Invoices
        </a>
    </div>

    @* Date picker form *@
    <form asp-action="DailyReport" method="get" class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
        <div class="grid gap-4 md:grid-cols-3 items-end">
            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="SelectedDate">Report date</label>
                <input asp-for="SelectedDate" type="date"
                       class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
            </div>
            <button type="submit"
                    class="self-end rounded-lg bg-sky-600 px-5 py-3 text-sm font-bold text-white hover:bg-sky-700">
                Load report
            </button>
        </div>
    </form>

    @* Stats cards *@
    <div class="grid gap-4 md:grid-cols-4">
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-sm font-bold text-slate-500">Total invoices</p>
            <p class="mt-2 text-2xl font-black text-sky-600">@Model.TotalInvoices</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-sm font-bold text-slate-500">Revenue</p>
            <p class="mt-2 text-2xl font-black text-emerald-600">@Model.TotalRevenue.ToString("N0") EGP</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-sm font-bold text-slate-500">Paid</p>
            <p class="mt-2 text-2xl font-black text-emerald-600">@Model.PaidCount</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-sm font-bold text-slate-500">Unpaid</p>
            <p class="mt-2 text-2xl font-black text-amber-600">@Model.UnpaidCount</p>
        </div>
    </div>

    @* Breakdown table *@
    <div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
        <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Category</th>
                    <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Count</th>
                    <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Notes</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                <tr class="hover:bg-slate-50">
                    <td class="px-4 py-4 text-sm font-semibold text-slate-700">Procedures performed</td>
                    <td class="px-4 py-4 text-sm text-slate-700">@Model.TotalProcedures</td>
                    <td class="px-4 py-4 text-sm text-slate-500">Included in revenue</td>
                </tr>
                <tr class="hover:bg-slate-50">
                    <td class="px-4 py-4 text-sm font-semibold text-slate-700">Consultations</td>
                    <td class="px-4 py-4 text-sm text-slate-700">@Model.TotalConsultations</td>
                    <td class="px-4 py-4 text-sm text-slate-500">Doctor fees</td>
                </tr>
                <tr class="hover:bg-slate-50">
                    <td class="px-4 py-4 text-sm font-semibold text-slate-700">Unpaid amount</td>
                    <td class="px-4 py-4 text-sm text-amber-600 font-bold">@Model.UnpaidAmount.ToString("N0") EGP</td>
                    <td class="px-4 py-4 text-sm text-slate-500">Outstanding balance</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>