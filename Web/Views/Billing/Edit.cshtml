@model BLL.DTOs.Billing.UpdateInvoiceDto
@{
    ViewData["Title"] = "Edit Invoice";
}
<div class="space-y-6">
    <div>
        <div class="flex items-center gap-2 text-sm font-semibold text-sky-600">
            <span class="material-symbols-outlined text-[20px]">edit</span>
            <span>Billing</span>
        </div>
        <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Edit Invoice</h2>
    </div>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="space-y-6">
        <input type="hidden" asp-for="Id" />
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <div class="mb-4 flex items-center justify-between gap-3">
                <h3 class="text-lg font-black">Invoice items</h3>
                <button id="addInvoiceItem" type="button"
                        class="inline-flex items-center gap-2 rounded-lg border border-sky-600 px-4 py-2 text-sm font-bold text-sky-600 hover:bg-sky-50">
                    <span class="material-symbols-outlined text-[18px]">add</span>
                    Add item
                </button>
            </div>
            <div id="invoiceItems" class="space-y-3">
                @if (Model.Items != null && Model.Items.Any())
                {
                    for (int i = 0; i < Model.Items.Count; i++)
                    {
                        <div class="invoice-row grid gap-3 md:grid-cols-5 items-end p-3 rounded-lg bg-slate-50">
                            <div>
                                <label class="mb-2 block text-sm font-semibold text-slate-700">Description</label>
                                <input asp-for="Items[i]!.Description" type="text" placeholder="Consultation fee"
                                       class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                                <span asp-validation-for="Items[i]!.Description" class="mt-1 text-xs text-red-500"></span>
                            </div>
                            <div>
                                <label class="mb-2 block text-sm font-semibold text-slate-700">Quantity</label>
                                <input asp-for="Items[i]!.Quantity" type="number" min="1"
                                       class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                                <span asp-validation-for="Items[i]!.Quantity" class="mt-1 text-xs text-red-500"></span>
                            </div>
                            <div>
                                <label class="mb-2 block text-sm font-semibold text-slate-700">Unit price (EGP)</label>
                                <input asp-for="Items[i]!.UnitPrice" type="number" step="0.01"
                                       class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                                <span asp-validation-for="Items[i]!.UnitPrice" class="mt-1 text-xs text-red-500"></span>
                            </div>
                            <div>
                                <label class="mb-2 block text-sm font-semibold text-slate-700">Type</label>
                                <select asp-for="Items[i]!.ItemType" asp-items="Html.GetEnumSelectList<InvoiceItemType>()"
                                        class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600">
                                </select>
                                <span asp-validation-for="Items[i]!.ItemType" class="mt-1 text-xs text-red-500"></span>
                            </div>
                            <div>
                                <button type="button" class="remove-item inline-flex items-center gap-2 rounded-lg border border-red-600 px-3 py-2 text-sm font-bold text-red-600 hover:bg-red-50">
                                    <span class="material-symbols-outlined text-[18px]">delete</span>
                                    Remove
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="flex justify-end gap-3 border-t border-slate-200 pt-5">
            <a asp-action="Details" asp-route-id="@Model.Id" class="rounded-lg px-5 py-3 text-sm font-bold text-slate-600 hover:bg-slate-100">Cancel</a>
            <button type="submit"
                    class="inline-flex items-center gap-2 rounded-lg bg-sky-600 px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-sky-700">
                <span class="material-symbols-outlined text-[18px]">save</span>
                Update invoice
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let itemIndex = @((Model.Items?.Count ?? 0));
        document.getElementById('addInvoiceItem')?.addEventListener('click', () => {
            const row = document.createElement('div');
            row.className = 'invoice-row grid gap-3 md:grid-cols-5 items-end p-3 rounded-lg bg-slate-50';
            row.innerHTML = `
                <div><label class="mb-2 block text-sm font-semibold text-slate-700">Description</label>
                    <input name="Items[${itemIndex}].Description" type="text" class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" /></div>
                <div><label class="mb-2 block text-sm font-semibold text-slate-700">Quantity</label>
                    <input name="Items[${itemIndex}].Quantity" type="number" value="1" min="1" class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" /></div>
                <div><label class="mb-2 block text-sm font-semibold text-slate-700">Unit price (EGP)</label>
                    <input name="Items[${itemIndex}].UnitPrice" type="number" step="0.01" placeholder="0.00" class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" /></div>
                <div><label class="mb-2 block text-sm font-semibold text-slate-700">Type</label>
                    <select name="Items[${itemIndex}].ItemType" class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600">
                        <option value="0">Consultation</option><option value="1">Procedure</option>
                        <option value="2">Lab</option><option value="3">Other</option>
                    </select></div>
                <div><button type="button" class="remove-item inline-flex items-center gap-2 rounded-lg border border-red-600 px-3 py-2 text-sm font-bold text-red-600 hover:bg-red-50">
                    <span class="material-symbols-outlined text-[18px]">delete</span> Remove</button></div>`;
            document.getElementById('invoiceItems').appendChild(row);
            itemIndex++;
        });

        document.addEventListener('click', (e) => {
            if (e.target.classList.contains('remove-item') || e.target.closest('.remove-item')) {
                e.target.closest('.invoice-row').remove();
            }
        });
    </script>
}
