@model InvoiceFormViewModel
@{
    ViewData["Title"] = "Create Invoice";
}
<div class="space-y-6">
    <div>
        <div class="flex items-center gap-2 text-sm font-semibold text-sky-600">
            <span class="material-symbols-outlined text-[20px]">add_card</span>
            <span>Billing</span>
        </div>
        <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Create Invoice</h2>
    </div>
    <form asp-action="Create" method="post" class="space-y-6">
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <div class="grid gap-5 md:grid-cols-2">
                <div class="md:col-span-2">
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="AppointmentId">Appointment</label>
                    <select id="AppointmentId" asp-for="AppointmentId" asp-items="Model.Appointments"
                            class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600">
                        <option value="">Select appointment...</option>
                    </select>
                    <span asp-validation-for="AppointmentId" class="mt-1 text-xs text-red-500"></span>
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700">Patient</label>
                    <input id="PatientNameDisplay" type="text" readonly
                           class="w-full rounded-lg border-slate-300 bg-slate-50 focus:border-sky-600 focus:ring-sky-600"
                           placeholder="Filled after appointment selection" />
                    <input type="hidden" asp-for="PatientId" />
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700">Doctor</label>
                    <input id="DoctorNameDisplay" type="text" readonly
                           class="w-full rounded-lg border-slate-300 bg-slate-50 focus:border-sky-600 focus:ring-sky-600"
                           placeholder="Filled after appointment selection" />
                </div>
            </div>
        </div>

        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <div class="mb-4 flex items-center justify-between gap-3">
                <h3 class="text-lg font-black">Invoice items</h3>
                <button id="addInvoiceItem" type="button"
                        class="inline-flex items-center gap-2 rounded-lg border border-sky-600 px-4 py-2 text-sm font-bold text-sky-600 hover:bg-sky-50">
                    <span class="material-symbols-outlined text-[18px]">add</span>
                    Add item
                </button>
            </div>
            <div id="invoiceItems" class="space-y-3">
                <div class="invoice-row grid gap-3 md:grid-cols-4 items-end p-3 rounded-lg bg-slate-50">
                    <div>
                        <label class="mb-2 block text-sm font-semibold text-slate-700">Description</label>
                        <input name="Items[0].Description" type="text" placeholder="Consultation fee"
                               class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                    </div>
                    <div>
                        <label class="mb-2 block text-sm font-semibold text-slate-700">Quantity</label>
                        <input name="Items[0].Quantity" type="number" value="1" min="1"
                               class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                    </div>
                    <div>
                        <label class="mb-2 block text-sm font-semibold text-slate-700">Unit price (EGP)</label>
                        <input name="Items[0].UnitPrice" type="number" step="0.01" placeholder="0.00"
                               class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                    </div>
                    <div>
                        <label class="mb-2 block text-sm font-semibold text-slate-700">Type</label>
                        <select name="Items[0].ItemType" class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600">
                            <option value="0">Consultation</option>
                            <option value="1">Procedure</option>
                            <option value="2">Lab</option>
                            <option value="3">Other</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex justify-end gap-3 border-t border-slate-200 pt-5">
            <a asp-action="Index" class="rounded-lg px-5 py-3 text-sm font-bold text-slate-600 hover:bg-slate-100">Cancel</a>
            <button type="submit"
                    class="inline-flex items-center gap-2 rounded-lg bg-sky-600 px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-sky-700">
                <span class="material-symbols-outlined text-[18px]">receipt_long</span>
                Create invoice
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Auto-fill patient/doctor from appointment option text (format: "DATE - PatientName | DoctorName")
        const apptSelect = document.getElementById('AppointmentId');
        apptSelect?.addEventListener('change', () => {
            const text = apptSelect.selectedOptions[0]?.text ?? '';
            const parts = text.split(' | ');
            const patientPart = parts[0]?.split(' - ')[1]?.trim() ?? '';
            const doctorPart = parts[1]?.trim() ?? '';
            document.getElementById('PatientNameDisplay').value = patientPart;
            document.getElementById('DoctorNameDisplay').value = doctorPart;
        });

        let itemIndex = 1;
        document.getElementById('addInvoiceItem')?.addEventListener('click', () => {
            const row = document.createElement('div');
            row.className = 'invoice-row grid gap-3 md:grid-cols-4 items-end p-3 rounded-lg bg-slate-50';
            row.innerHTML = `
                <div><label class="mb-2 block text-sm font-semibold text-slate-700">Description</label>
                    <input name="Items[${itemIndex}].Description" type="text" class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" /></div>
                <div><label class="mb-2 block text-sm font-semibold text-slate-700">Quantity</label>
                    <input name="Items[${itemIndex}].Quantity" type="number" value="1" min="1" class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" /></div>
                <div><label class="mb-2 block text-sm font-semibold text-slate-700">Unit price (EGP)</label>
                    <input name="Items[${itemIndex}].UnitPrice" type="number" step="0.01" placeholder="0.00" class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" /></div>
                <div><label class="mb-2 block text-sm font-semibold text-slate-700">Type</label>
                    <select name="Items[${itemIndex}].ItemType" class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600">
                        <option value="0">Consultation</option><option value="1">Procedure</option>
                        <option value="2">Lab</option><option value="3">Other</option>
                    </select></div>`;
            document.getElementById('invoiceItems').appendChild(row);
            itemIndex++;
        });
    </script>
}
