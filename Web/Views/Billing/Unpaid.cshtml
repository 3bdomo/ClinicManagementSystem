@model IEnumerable<BLL.DTOs.Billing.InvoiceDto>
@{
    ViewData["Title"] = "Unpaid Invoices";
}
<div class="space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <div class="flex items-center gap-2 text-sm font-semibold text-amber-600">
                <span class="material-symbols-outlined text-[20px]">pending</span>
                <span>Billing</span>
            </div>
            <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Unpaid Invoices</h2>
            <p class="mt-1 text-sm text-slate-500">@Model.Count() unpaid invoice(s) · Total: @Model.Sum(i => i.TotalAmount).ToString("N0") EGP</p>
        </div>
        <div class="flex gap-2">
            <a asp-action="Index" class="rounded-lg bg-slate-950 px-4 py-2 text-sm font-bold text-white hover:bg-slate-800">
                All Invoices
            </a>
        </div>
    </div>

    @* Stats *@
    <div class="grid gap-4 md:grid-cols-3">
        <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
            <span class="material-symbols-outlined text-xl text-amber-600">pending</span>
            <p class="mt-3 text-sm font-bold text-slate-500">Unpaid invoices</p>
            <p class="mt-1 text-2xl font-black">@Model.Count()</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
            <span class="material-symbols-outlined text-xl text-blue-500">partially_paid</span>
            <p class="mt-3 text-sm font-bold text-slate-500">Partially Paid</p>
            <p class="mt-1 text-2xl font-black text-blue-600">@Model.Count(i => i.Status == InvoiceStatus.PartiallyPaid)</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
            <span class="material-symbols-outlined text-xl text-red-500">cancel</span>
            <p class="mt-3 text-sm font-bold text-slate-500">Unpaid</p>
            <p class="mt-1 text-2xl font-black text-red-600">@Model.Count(i => i.Status == InvoiceStatus.Unpaid)</p>
        </div>
    </div>

    @* Invoices Table *@
    <div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
        @if (Model.Any())
        {
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Invoice #</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Patient</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Amount</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Status</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Date</th>
                        <th class="px-4 py-3"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var inv in Model)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-4 py-4 text-sm font-mono font-bold text-slate-700">#@inv.Id</td>
                            <td class="px-4 py-4">
                                <a asp-controller="Patient" asp-action="Details" asp-route-id="@inv.PatientId"
                                   class="text-sm font-semibold text-slate-900 hover:text-sky-600">@inv.PatientName</a>
                            </td>
                            <td class="px-4 py-4 text-sm font-bold text-slate-900">@inv.TotalAmount.ToString("N0") EGP</td>
                            <td class="px-4 py-4">
                                <span class="inline-flex rounded-full px-2 py-0.5 text-xs font-bold
                                    @(inv.Status == InvoiceStatus.Paid ? "bg-emerald-50 text-emerald-700" :
                                      inv.Status == InvoiceStatus.PartiallyPaid ? "bg-blue-50 text-blue-700" :
                                      "bg-amber-50 text-amber-700")">
                                    @inv.Status
                                </span>
                            </td>
                            <td class="px-4 py-4 text-sm text-slate-600">@inv.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td class="px-4 py-4 text-right">
                                <a asp-action="Details" asp-route-id="@inv.Id"
                                   class="text-sm font-bold text-sky-600 hover:underline">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="p-10 text-center">
                <span class="material-symbols-outlined text-5xl text-slate-300">receipt_long</span>
                <p class="mt-3 text-sm font-semibold text-slate-500">No unpaid invoices found.</p>
            </div>
        }
    </div>
</div>
