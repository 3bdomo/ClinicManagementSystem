@model BLL.DTOs.MedicalRecord.UpdateMedicalRecordDto

@{
    Layout = null;
    ViewData["Title"] = "Edit Medical Record";
}

<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Edit Medical Record - ClinicSystem</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .material-symbols-outlined {
            vertical-align: middle;
        }

        .field-error {
            color: #dc2626;
            font-size: 12px;
            margin-top: 4px;
            display: block;
        }

        .input-error {
            border-color: #dc2626 !important;
        }
    </style>
</head>

<body class="bg-slate-50 text-slate-900 min-h-screen">

    <!-- Sidebar -->
    <aside class="fixed left-0 top-0 h-full w-[240px] bg-slate-950 border-r border-slate-800 flex flex-col py-6 z-50">

        <div class="px-6 mb-8 flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-blue-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-white">
                    medical_services
                </span>
            </div>

            <div>
                <h1 class="text-lg font-black text-white leading-none">
                    ClinicSystem
                </h1>

                <p class="text-[10px] text-slate-400 uppercase tracking-widest mt-1">
                    Medical Management
                </p>
            </div>
        </div>

        <nav class="flex-1 px-4 space-y-1">

            <a href="/Home/Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-slate-400 hover:bg-slate-900 hover:text-white transition-colors">
                <span class="material-symbols-outlined">dashboard</span>
                <span class="text-sm">Dashboard</span>
            </a>

            <a href="/Patient/Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-slate-400 hover:bg-slate-900 hover:text-white transition-colors">
                <span class="material-symbols-outlined">person</span>
                <span class="text-sm">Patients</span>
            </a>

            <a href="/Appointment/Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-slate-400 hover:bg-slate-900 hover:text-white transition-colors">
                <span class="material-symbols-outlined">event</span>
                <span class="text-sm">Appointments</span>
            </a>

            <a href="/MedicalRecord/Index"
               class="flex items-center gap-3 px-4 py-3 rounded-r-lg border-l-4 border-blue-600 bg-blue-600/10 text-white">
                <span class="material-symbols-outlined text-blue-500">
                    clinical_notes
                </span>
                <span class="text-sm font-medium">
                    Medical Records
                </span>
            </a>
        </nav>
    </aside>

    <!-- Header -->
    <header class="fixed top-0 right-0 w-[calc(100%-240px)] h-16 bg-white border-b border-slate-200 shadow-sm flex items-center justify-between px-8 z-40">

        <div class="flex items-center gap-3">

            <a href="/MedicalRecord/Details/@Model.Id"
               class="p-2 rounded-lg hover:bg-slate-100 text-slate-500 transition-colors">

                <span class="material-symbols-outlined">
                    arrow_back
                </span>
            </a>

            <span class="text-slate-300">|</span>

            <span class="text-sm text-slate-500">
                Edit Medical Record #@Model.Id
            </span>
        </div>

        <p class="text-sm font-semibold text-slate-900">
            Clinic System
        </p>
    </header>

    <!-- Main -->
    <main class="ml-[240px] pt-16 p-8 min-h-screen">

        <div class="max-w-3xl mx-auto">

            <!-- Heading -->
            <div class="mb-8">
                <h2 class="text-3xl font-bold text-slate-900">
                    Edit Medical Record
                </h2>

                <p class="mt-1 text-sm text-slate-500">
                    Update diagnosis, notes, and follow-up information.
                </p>
            </div>

            <!-- Validation -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mb-6 rounded-xl border border-red-200 bg-red-50 p-4">

                    <div class="flex items-center gap-2 mb-2">

                        <span class="material-symbols-outlined text-red-600">
                            error
                        </span>

                        <span class="text-sm font-semibold text-red-800">
                            Please fix the following errors:
                        </span>
                    </div>

                    <ul class="list-disc list-inside space-y-1">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li class="text-sm text-red-700">
                                @error.ErrorMessage
                            </li>
                        }
                    </ul>
                </div>
            }

            <!-- Form -->
            <form asp-action="Edit"
                  method="post"
                  class="space-y-6">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <!-- Card -->
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 space-y-5">

                    <!-- Diagnosis -->
                    <div>
                        <label asp-for="Diagnosis"
                               class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2">
                            Diagnosis
                        </label>

                        <textarea asp-for="Diagnosis"
                                  id="Diagnosis"
                                  rows="4"
                                  maxlength="1000"
                                  class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm resize-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/10 @(ViewData.ModelState["Diagnosis"]?.Errors.Any() == true ? "input-error" : "")"></textarea>

                        <div class="flex justify-between mt-1">

                            <span asp-validation-for="Diagnosis"
                                  class="field-error"></span>

                            <span id="diagnosisCount"
                                  class="text-xs text-slate-400">
                                0 / 1000
                            </span>
                        </div>
                    </div>

                    <!-- Notes -->
                    <div>
                        <label asp-for="Notes"
                               class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2">
                            Clinical Notes
                        </label>

                        <textarea asp-for="Notes"
                                  id="Notes"
                                  rows="5"
                                  maxlength="2000"
                                  class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm resize-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/10"></textarea>

                        <div class="flex justify-end mt-1">

                            <span id="notesCount"
                                  class="text-xs text-slate-400">
                                0 / 2000
                            </span>
                        </div>
                    </div>

                    <!-- Follow-up -->
                    <div>
                        <label asp-for="FollowUpDate"
                               class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2">
                            Follow-up Date
                        </label>

                        <input asp-for="FollowUpDate"
                               type="datetime-local"
                               class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500/10" />

                        <span asp-validation-for="FollowUpDate"
                              class="field-error"></span>
                    </div>
                </div>

                <!-- Actions -->
                <div class="flex justify-end gap-3">

                    <a asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="px-6 py-3 rounded-lg border border-slate-300 text-sm font-medium text-slate-600 hover:bg-slate-100 transition-colors">

                        Cancel
                    </a>

                    <button type="submit"
                            class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-6 py-3 text-sm font-medium text-white shadow-sm hover:bg-blue-700 transition-colors">

                        <span class="material-symbols-outlined text-[18px]">
                            save
                        </span>

                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </main>

    <script>
        function updateCount(textarea, counterId) {
            document.getElementById(counterId).textContent =
                textarea.value.length + ' / ' + textarea.maxLength;
        }

        const diagnosisEl = document.getElementById('Diagnosis');
        const notesEl = document.getElementById('Notes');

        diagnosisEl.addEventListener('input', () => {
            updateCount(diagnosisEl, 'diagnosisCount');
        });

        notesEl.addEventListener('input', () => {
            updateCount(notesEl, 'notesCount');
        });

        updateCount(diagnosisEl, 'diagnosisCount');
        updateCount(notesEl, 'notesCount');
    </script>

</body>
</html>