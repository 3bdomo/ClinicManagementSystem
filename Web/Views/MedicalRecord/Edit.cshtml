@model MedicalRecordFormViewModel
@{
    ViewData["Title"] = "Edit Medical Record";
}
<div class="space-y-6">
    <div>
        <div class="flex items-center gap-2 text-sm font-semibold text-sky-600">
            <span class="material-symbols-outlined text-[20px]">edit_note</span>
            <span>Medical records</span>
            <span class="text-slate-300">/</span>
            <span>Edit #@Model.Id</span>
        </div>
        <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Edit Medical Record</h2>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="space-y-6">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="RowVersion" />
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <div class="grid gap-5 md:grid-cols-2">
                <div class="md:col-span-2">
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="AppointmentId">Appointment</label>
                    <select asp-for="AppointmentId" asp-items="Model.Appointments"
                            class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600">
                        <option value="">Select appointment...</option>
                    </select>
                    <span asp-validation-for="AppointmentId" class="text-xs font-semibold text-red-600 mt-1 block"></span>
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="FollowUpDate">Follow-up date</label>
                    <input asp-for="FollowUpDate" type="datetime-local"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="NewAttachments">New attachments</label>
                    <input asp-for="NewAttachments" type="file" multiple
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                </div>
                <div class="md:col-span-2">
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="Diagnosis">Diagnosis</label>
                    <textarea asp-for="Diagnosis" rows="4"
                              class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600"></textarea>
                    <span asp-validation-for="Diagnosis" class="text-xs font-semibold text-red-600 mt-1 block"></span>
                </div>
                <div class="md:col-span-2">
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="Notes">Doctor notes</label>
                    <textarea asp-for="Notes" rows="4"
                              class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600"></textarea>
                </div>
            </div>
        </div>

        <div class="flex justify-end gap-3 border-t border-slate-200 pt-5">
            <a asp-action="Details" asp-route-id="@Model.Id"
               class="rounded-lg px-5 py-3 text-sm font-bold text-slate-600 hover:bg-slate-100">Cancel</a>
            <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-sky-600 px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-sky-700">
                <span class="material-symbols-outlined text-[18px]">edit_note</span>
                Save changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScripts")
}
