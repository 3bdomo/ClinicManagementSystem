@model BLL.DTOs.MedicalRecord.PatientMedicalStatisticsDto
@{
    ViewData["Title"] = "Patient Medical Statistics";
}
<div class="space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <div class="flex items-center gap-2 text-sm font-semibold text-blue-600">
                <span class="material-symbols-outlined text-[20px]">analytics</span>
                <span>Statistics</span>
            </div>
            <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Patient Medical Statistics</h2>
            <p class="mt-1 text-sm text-slate-500">Patient ID: @Model.PatientId</p>
        </div>
        <div class="flex gap-2">
            <a asp-controller="Patient" asp-action="Details" asp-route-id="@Model.PatientId"
               class="rounded-lg bg-slate-600 px-4 py-2 text-sm font-bold text-white hover:bg-slate-700">
                View Patient
            </a>
            <a asp-action="ByPatient" asp-route-patientId="@Model.PatientId"
               class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-bold text-white hover:bg-emerald-700">
                Medical Records
            </a>
            <a asp-action="Index" class="rounded-lg bg-slate-950 px-4 py-2 text-sm font-bold text-white hover:bg-slate-800">
                All Records
            </a>
        </div>
    </div>

    @* Stats Grid *@
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <span class="material-symbols-outlined text-3xl text-blue-600">medical_information</span>
            <p class="mt-4 text-sm font-bold text-slate-500">Total Records</p>
            <p class="mt-2 text-4xl font-black text-slate-900">@Model.TotalRecords</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <span class="material-symbols-outlined text-3xl text-green-600">local_hospital</span>
            <p class="mt-4 text-sm font-bold text-slate-500">Total Visits</p>
            <p class="mt-2 text-4xl font-black text-slate-900">@Model.TotalVisits</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <span class="material-symbols-outlined text-3xl text-purple-600">healing</span>
            <p class="mt-4 text-sm font-bold text-slate-500">Total Procedures</p>
            <p class="mt-2 text-4xl font-black text-slate-900">@Model.TotalProcedures</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <span class="material-symbols-outlined text-3xl text-red-600">sick</span>
            <p class="mt-4 text-sm font-bold text-slate-500">Unique Conditions</p>
            <p class="mt-2 text-4xl font-black text-slate-900">@Model.UniqueConditions</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <span class="material-symbols-outlined text-3xl text-amber-600">schedule</span>
            <p class="mt-4 text-sm font-bold text-slate-500">Pending Follow-ups</p>
            <p class="mt-2 text-4xl font-black text-slate-900">@Model.PendingFollowUps</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <span class="material-symbols-outlined text-3xl text-indigo-600">trending_up</span>
            <p class="mt-4 text-sm font-bold text-slate-500">Avg Visits/Record</p>
            <p class="mt-2 text-4xl font-black text-slate-900">@Model.AverageVisitsPerRecord.ToString("F1")</p>
        </div>
    </div>

    @* Additional Info *@
    <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-black text-slate-900">Latest Diagnosis</h3>
            <p class="mt-2 text-sm text-slate-600">@(Model.LatestDiagnosis ?? "No diagnosis recorded")</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-black text-slate-900">Visit History</h3>
            <div class="mt-2 space-y-2">
                <p class="text-sm text-slate-600">Last Visit: @(Model.LastVisitDate?.ToString("yyyy-MM-dd") ?? "N/A")</p>
                <p class="text-sm text-slate-600">First Record: @(Model.FirstRecordDate?.ToString("yyyy-MM-dd") ?? "N/A")</p>
            </div>
        </div>
    </div>
</div>
