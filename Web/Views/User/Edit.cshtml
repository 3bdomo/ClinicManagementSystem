@model EditUserViewModel
@{
    ViewData["Title"] = "Edit Staff User";
}
<div class="space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <div class="flex items-center gap-2 text-sm font-semibold text-sky-600">
                <span class="material-symbols-outlined text-[20px]">edit</span>
                <span>User management</span>
            </div>
            <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Edit Staff User</h2>
        </div>
        <a asp-action="Index" class="inline-flex items-center gap-2 rounded-lg border border-slate-300 px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            Back to Users
        </a>
    </div>

    <form asp-action="Edit" method="post" class="space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <p class="mb-5 rounded-lg bg-blue-50 p-4 text-sm font-semibold text-blue-800">
                <span class="material-symbols-outlined align-middle text-[18px]">info</span>
                You are editing an existing staff account. Email cannot be changed here.
            </p>
            <div class="grid gap-5 md:grid-cols-2">
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="FullName">Full name</label>
                    <input asp-for="FullName" type="text" placeholder="Updated staff name"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                    <span asp-validation-for="FullName" class="mt-1 text-xs text-red-500"></span>
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="PhoneNumber">Phone number</label>
                    <input asp-for="PhoneNumber" type="tel" placeholder="01000000000"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                </div>
            </div>
            <div class="mt-5">
                <label class="flex items-center gap-3 text-sm font-semibold text-slate-700 cursor-pointer">
                    <input asp-for="IsActive" type="checkbox"
                           class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-600" />
                    Account active
                </label>
            </div>
        </div>

        <div class="flex justify-end gap-3 border-t border-slate-200 pt-5">
            <a asp-action="Index" class="rounded-lg px-5 py-3 text-sm font-bold text-slate-600 hover:bg-slate-100">Cancel</a>
            <button type="submit"
                    class="inline-flex items-center gap-2 rounded-lg bg-sky-600 px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-sky-700">
                <span class="material-symbols-outlined text-[18px]">save</span>
                Save changes
            </button>
        </div>
    </form>
</div>