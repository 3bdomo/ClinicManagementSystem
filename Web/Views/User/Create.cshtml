@model CreateUserViewModel
@{
    ViewData["Title"] = "Create Staff User";
}
<div class="space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <div class="flex items-center gap-2 text-sm font-semibold text-sky-600">
                <span class="material-symbols-outlined text-[20px]">person_add</span>
                <span>User management</span>
            </div>
            <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Create Staff User</h2>
        </div>
        <a asp-action="Index" class="inline-flex items-center gap-2 rounded-lg border border-slate-300 px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            Back to Users
        </a>
    </div>

    <form asp-action="Create" method="post" class="space-y-6">
        @Html.AntiForgeryToken()

        @* Account Details *@
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="mb-5 text-lg font-black text-slate-800">Account details</h3>
            <div class="grid gap-5 md:grid-cols-2">
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="FullName">Full name</label>
                    <input asp-for="FullName" type="text" placeholder="Staff member full name"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                    <span asp-validation-for="FullName" class="mt-1 text-xs text-red-500"></span>
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="Email">Email</label>
                    <input asp-for="Email" type="email" placeholder="staff@clinic.com"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                    <span asp-validation-for="Email" class="mt-1 text-xs text-red-500"></span>
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="PhoneNumber">Phone number</label>
                    <input asp-for="PhoneNumber" type="tel" placeholder="01000000000"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="UserRole">Role</label>
                    <select id="UserRole" asp-for="UserRole"
                            class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600">
                        <option value="">Select role…</option>
                        @foreach (var role in Enum.GetValues<Common.Enums.UserRole>())
                        {
                            <option value="@role">@role</option>
                        }
                    </select>
                    <span asp-validation-for="UserRole" class="mt-1 text-xs text-red-500"></span>
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="Password">Password</label>
                    <input asp-for="Password" type="password" placeholder="Min 8 characters"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                    <span asp-validation-for="Password" class="mt-1 text-xs text-red-500"></span>
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="ConfirmPassword">Confirm password</label>
                    <input asp-for="ConfirmPassword" type="password" placeholder="Repeat password"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                    <span asp-validation-for="ConfirmPassword" class="mt-1 text-xs text-red-500"></span>
                </div>
            </div>
        </div>

        @* Doctor Details (hidden until Doctor role is selected) *@
        <div id="doctorSection" class="rounded-lg border border-blue-200 bg-blue-50 p-6 shadow-sm hidden">
            <h3 class="mb-4 text-lg font-black text-blue-800">
                <span class="material-symbols-outlined align-middle text-[20px]">stethoscope</span>
                Doctor details
            </h3>
            <div class="grid gap-5 md:grid-cols-2">
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="Specialization">Specialization</label>
                    <select asp-for="Specialization"
                            class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600">
                        <option value="">Select specialization…</option>
                        @foreach (var spec in Enum.GetValues<Common.Enums.Specialization>())
                        {
                            <option value="@spec">@spec</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="ConsultationFee">Consultation fee (EGP)</label>
                    <input asp-for="ConsultationFee" type="number" step="0.01" placeholder="500.00"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                </div>
                <div class="md:col-span-2">
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="Bio">Bio</label>
                    <textarea asp-for="Bio" rows="3" placeholder="Short doctor profile…"
                              class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600"></textarea>
                </div>
            </div>
        </div>

        @* Patient Details (hidden until Patient role is selected) *@
        <div id="patientSection" class="rounded-lg border border-emerald-200 bg-emerald-50 p-6 shadow-sm hidden">
            <h3 class="mb-4 text-lg font-black text-emerald-800">
                <span class="material-symbols-outlined align-middle text-[20px]">person</span>
                Patient details
            </h3>
            <div class="grid gap-5 md:grid-cols-2">
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="NationalId">National ID</label>
                    <input asp-for="NationalId" type="text" placeholder="14-digit National ID"
                           class="w-full rounded-lg border-slate-300 focus:border-emerald-600 focus:ring-emerald-600" />
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="DateOfBirth">Date of birth</label>
                    <input asp-for="DateOfBirth" type="date"
                           class="w-full rounded-lg border-slate-300 focus:border-emerald-600 focus:ring-emerald-600" />
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="Gender">Gender</label>
                    <select asp-for="Gender" class="w-full rounded-lg border-slate-300 focus:border-emerald-600 focus:ring-emerald-600">
                        <option value="">Select gender…</option>
                        @foreach (var gender in Enum.GetValues<Common.Enums.Gender>())
                        {
                            <option value="@gender">@gender</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="BloodType">Blood type</label>
                    <select asp-for="BloodType" asp-items="ViewBag.BloodTypes" 
                            class="w-full rounded-lg border-slate-300 focus:border-emerald-600 focus:ring-emerald-600">
                        <option value="">Select type…</option>
                    </select>
                </div>
                <div class="md:col-span-2">
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="Address">Address</label>
                    <input asp-for="Address" type="text" placeholder="Street, City..."
                           class="w-full rounded-lg border-slate-300 focus:border-emerald-600 focus:ring-emerald-600" />
                </div>
                <div class="md:col-span-2">
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="EmergencyContact">Emergency contact</label>
                    <input asp-for="EmergencyContact" type="text" placeholder="Name and Phone..."
                           class="w-full rounded-lg border-slate-300 focus:border-emerald-600 focus:ring-emerald-600" />
                </div>
            </div>
        </div>

        <div class="flex justify-end gap-3 border-t border-slate-200 pt-5">
            <a asp-action="Index" class="rounded-lg px-5 py-3 text-sm font-bold text-slate-600 hover:bg-slate-100">Cancel</a>
            <button type="submit"
                    class="inline-flex items-center gap-2 rounded-lg bg-sky-600 px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-sky-700">
                <span class="material-symbols-outlined text-[18px]">person_add</span>
                Create user
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const roleSelect = document.getElementById('UserRole');
        const doctorSection = document.getElementById('doctorSection');
        const patientSection = document.getElementById('patientSection');
        
        function toggleSections() {
            doctorSection.classList.toggle('hidden', roleSelect.value !== 'Doctor');
            patientSection.classList.toggle('hidden', roleSelect.value !== 'Patient');
        }
        
        roleSelect?.addEventListener('change', toggleSections);
        toggleSections();
    </script>
}