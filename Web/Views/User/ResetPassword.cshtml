@model ResetPasswordViewModel
@{ Layout = null; ViewData["Title"] = "Reset Password"; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Reset Password - ClinicSystem</title><script src="https://cdn.tailwindcss.com?plugins=forms"></script><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap" rel="stylesheet" /><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" /><link rel="stylesheet" href="~/css/site.css" /></head><body class="grid min-h-screen place-items-center bg-slate-50 p-6" style="font-family:Inter,sans-serif"><form asp-action="ResetPassword" method="post" class="w-full max-w-md rounded-lg border border-slate-200 bg-white p-8 shadow-xl"><a asp-controller="Account" asp-action="Login" class="inline-flex items-center gap-2 text-sm font-bold text-sky-600"><span class="material-symbols-outlined text-[18px]">arrow_back</span>Login</a><h1 class="mt-5 text-3xl font-black">Reset password</h1><p class="mt-2 text-sm text-slate-500">Set a new password for your account.</p><div class="mt-6 space-y-5"><div><label class="block text-sm font-semibold text-slate-700 mb-2" for="NewPassword">New password</label><input id="NewPassword" name="NewPassword" type="password" placeholder="********" class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" /></div><div><label class="block text-sm font-semibold text-slate-700 mb-2" for="ConfirmPassword">Confirm new password</label><input id="ConfirmPassword" name="ConfirmPassword" type="password" placeholder="********" class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" /></div><button class="w-full rounded-lg bg-sky-600 px-5 py-3 font-bold text-white" type="submit">Reset password</button></div></form></body></html>