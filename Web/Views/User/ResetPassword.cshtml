<div class="space-y-md">
<div class="relative">
<label class="block text-label-md font-label-md text-on-surface mb-xs">Initial Password</label>
<div class="relative">
<input class="w-full px-md py-sm rounded-lg border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all text-body-md font-body-md" placeholder="••••••••" type="password"/>
<button class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-primary" type="button">
<span class="material-symbols-outlined text-[20px]">visibility</span>
</button>
</div>
</div>
<div>
<label class="block text-label-md font-label-md text-on-surface mb-xs">Confirm Password</label>
<input class="w-full px-md py-sm rounded-lg border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all text-body-md font-body-md" placeholder="••••••••" type="password"/>
</div>
<div class="pt-sm">
<label class="block text-label-md font-label-md text-on-surface mb-md">Permission Groups</label>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-md">
<label class="flex items-center gap-3 p-md border border-slate-100 rounded-lg hover:bg-slate-50 cursor-pointer transition-all group">
<input class="rounded border-slate-300 text-primary focus:ring-primary/20" type="checkbox"/>
<span class="text-body-md font-body-md text-on-surface group-hover:text-primary">Patient Records</span>
</label>
<label class="flex items-center gap-3 p-md border border-slate-100 rounded-lg hover:bg-slate-50 cursor-pointer transition-all group">
<input class="rounded border-slate-300 text-primary focus:ring-primary/20" type="checkbox"/>
<span class="text-body-md font-body-md text-on-surface group-hover:text-primary">Billing</span>
</label>
<label class="flex items-center gap-3 p-md border border-slate-100 rounded-lg hover:bg-slate-50 cursor-pointer transition-all group">
<input class="rounded border-slate-300 text-primary focus:ring-primary/20" type="checkbox"/>
<span class="text-body-md font-body-md text-on-surface group-hover:text-primary">Scheduling</span>
</label>
<label class="flex items-center gap-3 p-md border border-slate-100 rounded-lg hover:bg-slate-50 cursor-pointer transition-all group">
<input class="rounded border-slate-300 text-primary focus:ring-primary/20" type="checkbox"/>
<span class="text-body-md font-body-md text-on-surface group-hover:text-primary">System Settings</span>
</label>
</div>
</div>
</div>
</div>
