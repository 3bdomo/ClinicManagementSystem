<span class="material-symbols-outlined text-md">person_add</span>
                        Create Account
                    </button>
</div>
</form>
<!-- Extra UX Hint: Professional Bento Info -->
<div class="mt-xxl grid grid-cols-1 md:grid-cols-3 gap-lg opacity-80">
<div class="p-md bg-surface-container-low rounded-lg flex items-start gap-3">
<span class="material-symbols-outlined text-secondary">info</span>
<div>
<p class="text-label-sm font-label-sm">Automatic Invitation</p>
<p class="text-body-sm font-body-sm text-on-surface-variant">An email invitation will be sent automatically with login credentials.</p>
</div>
</div>
<div class="p-md bg-surface-container-low rounded-lg flex items-start gap-3">
