<div class="grid grid-cols-2 gap-4">
<div class="space-y-2">
<label class="font-label-md text-on-surface">Full Name</label>
<input class="w-full rounded-lg border-slate-200 focus:border-primary focus:ring-2 focus:ring-primary/10 text-sm px-4 py-2.5" placeholder="e.g. John Doe" type="text"/>
</div>
<div class="space-y-2">
<label class="font-label-md text-on-surface">Email Address</label>
<input class="w-full rounded-lg border-slate-200 focus:border-primary focus:ring-2 focus:ring-primary/10 text-sm px-4 py-2.5" placeholder="john&#64;clinicsystem.com" type="email"/>
</div>
</div>
<div class="grid grid-cols-2 gap-4">
<div class="space-y-2">
<label class="font-label-md text-on-surface">Role</label>
<select class="w-full rounded-lg border-slate-200 focus:border-primary focus:ring-2 focus:ring-primary/10 text-sm px-4 py-2.5">
<option selected="" value="doctor">Doctor</option>
<option value="receptionist">Receptionist</option>
<option value="admin">Administrator</option>
</select>
</div>
<div class="space-y-2">
<label class="font-label-md text-on-surface">Initial Password</label>
<div class="relative">
<input class="w-full rounded-lg border-slate-200 focus:border-primary focus:ring-2 focus:ring-primary/10 text-sm px-4 py-2.5" type="password" value="••••••••"/>
<span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm cursor-pointer" data-icon="visibility">visibility</span>
</div>
</div>
</div>
</div>
<!-- Divider -->
<div class="h-px bg-slate-100"></div>
<!-- Professional Info Section (Conditional for Doctor) -->
<div class="space-y-4">
<h4 class="text-[11px] uppercase tracking-[0.1em] font-bold text-primary flex items-center gap-2">
<span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
