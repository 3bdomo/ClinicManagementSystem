@model DoctorScheduleFormViewModel
@{
    ViewData["Title"] = "Create Doctor Schedule";
}
<div class="space-y-6">
    <div>
        <div class="flex items-center gap-2 text-sm font-semibold text-sky-600">
            <span class="material-symbols-outlined text-[20px]">calendar_add_on</span>
            <a asp-action="Index" class="hover:underline">Schedules</a>
            <span class="text-slate-300">/</span>
            <span>Create</span>
        </div>
        <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Create Doctor Schedule</h2>
    </div>

    <form asp-action="Create" method="post" class="space-y-6">
        <div asp-validation-summary="All" class="text-sm font-semibold text-red-600"></div>
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <div class="grid gap-5 md:grid-cols-2">
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="DoctorId">Doctor</label>
                    <select asp-for="DoctorId" asp-items="Model.Doctors"
                            class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600">
                        <option value="">Select doctor...</option>
                    </select>
                    <span asp-validation-for="DoctorId" class="text-xs font-semibold text-red-600 mt-1 block"></span>
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="ScheduleType">Schedule type</label>
                    <select asp-for="ScheduleType" asp-items="Html.GetEnumSelectList<Common.Enums.ScheduleType>()"
                            class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600">
                    </select>
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="DayOfWeek">Weekly day (recurring)</label>
                    <select asp-for="DayOfWeek" asp-items="Html.GetEnumSelectList<DayOfWeek>()"
                            class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600">
                        <option value="">One-time schedule</option>
                    </select>
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="SpecificDate">Specific date (one-time)</label>
                    <input asp-for="SpecificDate" type="date"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                    <span asp-validation-for="SpecificDate" class="text-xs font-semibold text-red-600 mt-1 block"></span>
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="StartTime">Start time</label>
                    <input asp-for="StartTime" type="time"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                    <span asp-validation-for="StartTime" class="text-xs font-semibold text-red-600 mt-1 block"></span>
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="EndTime">End time</label>
                    <input asp-for="EndTime" type="time"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                    <span asp-validation-for="EndTime" class="text-xs font-semibold text-red-600 mt-1 block"></span>
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="SlotMinutes">Slot duration (minutes)</label>
                    <input asp-for="SlotMinutes" type="number" min="5" max="240" step="5"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                    <span asp-validation-for="SlotMinutes" class="text-xs font-semibold text-red-600 mt-1 block"></span>
                </div>
                <div class="flex items-center gap-3 self-end pb-1">
                    <input asp-for="IsActive" type="checkbox"
                           class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-600" />
                    <label asp-for="IsActive" class="text-sm font-semibold text-slate-700">Active schedule</label>
                </div>
                <div class="md:col-span-2">
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="Notes">Notes</label>
                    <textarea asp-for="Notes" rows="3" placeholder="Optional notes"
                              class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600"></textarea>
                </div>
            </div>
        </div>

        <div class="flex justify-end gap-3 border-t border-slate-200 pt-5">
            <a asp-action="Index" class="rounded-lg px-5 py-3 text-sm font-bold text-slate-600 hover:bg-slate-100">Cancel</a>
            <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-sky-600 px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-sky-700">
                <span class="material-symbols-outlined text-[18px]">calendar_add_on</span>
                Create schedule
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScripts")
}
