@model DoctorScheduleFormViewModel
@{
    ViewData["Title"] = "Edit Doctor Schedule";
}
<div class="space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <div class="flex items-center gap-2 text-sm font-semibold text-sky-600">
                <span class="material-symbols-outlined text-[20px]">edit_calendar</span>
                <span>Doctor schedules</span>
            </div>
            <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Edit Doctor Schedule</h2>
            @if (!string.IsNullOrEmpty(Model.DoctorName))
            {
                <p class="mt-1 text-sm text-slate-500">for <strong>@Model.DoctorName</strong></p>
            }
        </div>
        <a asp-action="Index" class="inline-flex items-center gap-2 rounded-lg border border-slate-300 px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            Back to schedules
        </a>
    </div>

    <form asp-action="Edit" method="post" class="space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="DoctorId" />

        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <p class="mb-5 rounded-lg bg-blue-50 p-4 text-sm font-semibold text-blue-800">
                <span class="material-symbols-outlined align-middle text-[18px]">info</span>
                Update the working slot: type, day/date, start/end time, slot duration, and active status.
            </p>
            <div class="grid gap-5 md:grid-cols-2">
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="ScheduleType">Schedule type</label>
                    <select asp-for="ScheduleType"
                            class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600">
                        @foreach (var t in Enum.GetValues<Common.Enums.ScheduleType>())
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                    <span asp-validation-for="ScheduleType" class="mt-1 text-xs text-red-500"></span>
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="DayOfWeek">Weekly day (recurring)</label>
                    <select asp-for="DayOfWeek"
                            class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600">
                        <option value="">— one-time date instead —</option>
                        @foreach (DayOfWeek d in Enum.GetValues<DayOfWeek>())
                        {
                            <option value="@d">@d</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="SpecificDate">Specific date (one-time)</label>
                    <input asp-for="SpecificDate" type="date"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="SlotMinutes">Slot duration (minutes)</label>
                    <input asp-for="SlotMinutes" type="number" min="5" max="240" placeholder="30"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                    <span asp-validation-for="SlotMinutes" class="mt-1 text-xs text-red-500"></span>
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="StartTime">Start time</label>
                    <input asp-for="StartTime" type="time"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                    <span asp-validation-for="StartTime" class="mt-1 text-xs text-red-500"></span>
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="EndTime">End time</label>
                    <input asp-for="EndTime" type="time"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                    <span asp-validation-for="EndTime" class="mt-1 text-xs text-red-500"></span>
                </div>
                <div class="md:col-span-2">
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="Notes">Notes</label>
                    <textarea asp-for="Notes" rows="2" placeholder="Any additional notes…"
                              class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600"></textarea>
                </div>
                <div class="md:col-span-2">
                    <label class="flex items-center gap-3 text-sm font-semibold text-slate-700 cursor-pointer">
                        <input asp-for="IsActive" type="checkbox"
                               class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-600" />
                        Active schedule (accepts bookings)
                    </label>
                </div>
            </div>
        </div>

        <div class="flex justify-end gap-3 border-t border-slate-200 pt-5">
            <a asp-action="Index" class="rounded-lg px-5 py-3 text-sm font-bold text-slate-600 hover:bg-slate-100">Cancel</a>
            <button type="submit"
                    class="inline-flex items-center gap-2 rounded-lg bg-sky-600 px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-sky-700">
                <span class="material-symbols-outlined text-[18px]">save</span>
                Save schedule
            </button>
        </div>
    </form>
</div>