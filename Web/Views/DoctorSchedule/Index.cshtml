<button class="w-10 h-10 rounded-lg border border-outline-variant hover:border-primary hover:text-primary transition-all font-bold text-xs">T</button>
<button class="w-10 h-10 rounded-lg border border-outline-variant hover:border-primary hover:text-primary transition-all font-bold text-xs">W</button>
