@model DoctorScheduleListViewModel
@{
    ViewData["Title"] = "Doctor Schedules";
}
<div class="space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <div class="flex items-center gap-2 text-sm font-semibold text-sky-600">
                <span class="material-symbols-outlined text-[20px]">calendar_month</span>
                <span>Doctor schedules</span>
            </div>
            <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Doctor Schedules</h2>
            <p class="mt-1 text-sm text-slate-500">@Model.Schedules.Count() schedule(s) found</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="inline-flex items-center gap-2 rounded-lg bg-sky-600 px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-sky-700">
                <span class="material-symbols-outlined text-[18px]">calendar_add_on</span>
                New schedule
            </a>
        }
    </div>

    <form method="get" asp-action="Index" class="grid gap-4 rounded-lg border border-slate-200 bg-white p-4 shadow-sm md:grid-cols-3 md:items-end">
        <div>
            <label class="mb-2 block text-sm font-semibold text-slate-700" for="DoctorId">Doctor</label>
            <select id="DoctorId" name="DoctorId" class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600">
                <option value="">All doctors</option>
                @foreach (var d in Model.Doctors)
                {
                    <option value="@d.Value" selected="@(d.Value == Model.DoctorId?.ToString())">@d.Text</option>
                }
            </select>
        </div>
        <div>
            <label class="mb-2 block text-sm font-semibold text-slate-700" for="ScheduleType">Type</label>
            <select id="ScheduleType" name="ScheduleType" class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600">
                <option value="">All types</option>
                @foreach (var t in Html.GetEnumSelectList<Common.Enums.ScheduleType>())
                {
                    <option value="@t.Value" selected="@(t.Value == Model.ScheduleType?.ToString())">@t.Text</option>
                }
            </select>
        </div>
        <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg bg-slate-950 px-5 py-3 text-sm font-bold text-white hover:bg-slate-800">
            <span class="material-symbols-outlined text-[18px]">filter_list</span>
            Filter
        </button>
    </form>

    <div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
        @if (Model.Schedules.Any())
        {
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Doctor</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Type</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Day / Date</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Time</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Slot</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Status</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th class="px-4 py-3"></th>
                        }
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var s in Model.Schedules)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-4 py-4 text-sm font-semibold text-slate-900">@s.DoctorName</td>
                            <td class="px-4 py-4 text-sm text-slate-700">@s.ScheduleType</td>
                            <td class="px-4 py-4 text-sm text-slate-700">
                                @if (s.DayOfWeek.HasValue)
                                {
                                    @s.DayOfWeek.Value.ToString()
                                }
                                else if (s.SpecificDate.HasValue)
                                {
                                    @s.SpecificDate.Value.ToString("yyyy-MM-dd")
                                }
                                else
                                {
                                    <span class="text-slate-400">—</span>
                                }
                            </td>
                            <td class="px-4 py-4 text-sm text-slate-700">@s.StartTime.ToString("HH:mm") – @s.EndTime.ToString("HH:mm")</td>
                            <td class="px-4 py-4 text-sm text-slate-600">@s.SlotMinutes min</td>
                            <td class="px-4 py-4">
                                @if (s.IsActive)
                                {
                                    <span class="inline-flex rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-bold text-emerald-700">Active</span>
                                }
                                else
                                {
                                    <span class="inline-flex rounded-full bg-slate-100 px-2 py-0.5 text-xs font-bold text-slate-500">Inactive</span>
                                }
                            </td>
                            @if (User.IsInRole("Admin"))
                            {
                                <td class="px-4 py-4 text-right">
                                    <a asp-action="Edit" asp-route-id="@s.Id"
                                       class="text-sm font-bold text-sky-600 hover:underline">Edit</a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="p-10 text-center">
                <span class="material-symbols-outlined text-5xl text-slate-300">calendar_month</span>
                <p class="mt-3 text-sm font-semibold text-slate-500">No schedules found for the selected filters.</p>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Create" class="mt-4 inline-flex items-center gap-2 rounded-lg bg-sky-600 px-4 py-2 text-sm font-bold text-white">
                        Create first schedule
                    </a>
                }
            </div>
        }
    </div>
</div>
