@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ClinicSystem - Modern Medical Care</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet" />
    <style>
        body { font-family: 'Outfit', sans-serif; background-color: #f8fafc; }

        .glass-nav {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.4);
        }

        .hero-bg {
            background: radial-gradient(circle at top right, #e0f2fe 0%, #f0fdf4 100%);
            position: relative;
            overflow: hidden;
        }

        .hero-shape {
            position: absolute;
            background: linear-gradient(135deg, #38bdf8 0%, #0284c7 100%);
            border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
            animation: morph 8s ease-in-out infinite;
            opacity: 0.1;
            z-index: 0;
        }

        @@keyframes morph {
            0%, 100% { border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; transform: rotate(0deg); }
            34% { border-radius: 70% 30% 50% 50% / 30% 30% 70% 70%; transform: rotate(10deg); }
            67% { border-radius: 100% 60% 60% 100% / 100% 100% 60% 60%; transform: rotate(-5deg); }
        }

        .btn-primary {
            background: linear-gradient(135deg, #0ea5e9, #0284c7);
            box-shadow: 0 4px 14px rgba(14, 165, 233, 0.3);
            transition: all 0.3s ease;
        }
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(14, 165, 233, 0.4);
        }

        .btn-secondary {
            background: white;
            color: #0ea5e9;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease;
        }
        .btn-secondary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
            color: #0284c7;
        }

        .feature-card {
            background: white;
            border-radius: 24px;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
            border: 1px solid rgba(226, 232, 240, 0.8);
        }
        .feature-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px -5px rgba(14, 165, 233, 0.1);
            border-color: rgba(14, 165, 233, 0.3);
        }
    </style>
</head>
<body class="text-slate-800 antialiased selection:bg-sky-200 selection:text-sky-900">

    @* Navigation *@
    <nav class="glass-nav fixed w-full z-50 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-sky-500 text-white flex items-center justify-center shadow-lg shadow-sky-500/30">
                    <span class="material-symbols-rounded">medical_services</span>
                </div>
                <span class="text-xl font-extrabold tracking-tight text-slate-900">ClinicSystem</span>
            </div>
            
            <div class="hidden md:flex items-center gap-8 text-sm font-semibold text-slate-600">
                <a href="#services" class="hover:text-sky-600 transition-colors">Services</a>
                <a asp-controller="Doctor"
                   asp-action="TopDoctorsByPatients"
                   class="hover:text-sky-600 transition-colors">
                    Our Doctors
                </a>
                <a href="#contact" class="hover:text-sky-600 transition-colors">Contact</a>
            </div>

            <div class="flex items-center gap-4">
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <a asp-controller="Home" asp-action="Dashboard" class="btn-primary px-5 py-2.5 rounded-full text-sm font-bold text-white flex items-center gap-2">
                        Dashboard
                        <span class="material-symbols-rounded text-[18px]">arrow_forward</span>
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="LoginDoctor" class="text-sm font-bold text-slate-600 hover:text-sky-600 transition-colors hidden sm:block">
                        Staff Login
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn-primary px-6 py-2.5 rounded-full text-sm font-bold text-white flex items-center gap-2">
                        <span class="material-symbols-rounded text-[18px]">person</span>
                        Patient Portal
                    </a>
                }
            </div>
        </div>
    </nav>

    @* Hero Section *@
    <section class="hero-bg min-h-screen flex items-center pt-20">
        <div class="hero-shape w-[600px] h-[600px] top-10 right-[-100px]"></div>
        <div class="hero-shape w-[400px] h-[400px] bottom-10 left-[-50px] !bg-emerald-500 animation-delay-2000"></div>

        <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-12 items-center relative z-10 w-full py-12">
            <div class="max-w-2xl">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-sky-100 text-sky-700 font-bold text-xs uppercase tracking-widest mb-6">
                    <span class="w-2 h-2 rounded-full bg-sky-500 animate-pulse"></span>
                    Accepting New Patients
                </div>
                <h1 class="text-5xl lg:text-7xl font-black text-slate-900 leading-[1.1] mb-6">
                    Modern Healthcare, <br/>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-500 to-emerald-500">Built Around You.</span>
                </h1>
                <p class="text-lg lg:text-xl text-slate-600 mb-10 leading-relaxed font-medium max-w-lg">
                    Experience world-class medical care with our advanced clinic management system. Book appointments, view your records, and connect with top doctors effortlessly.
                </p>
                <div class="flex flex-col sm:flex-row gap-4">
                    <a asp-controller="Account" asp-action="Register" class="btn-primary px-8 py-4 rounded-full text-base font-bold text-white flex justify-center items-center gap-2">
                        Join Our Clinic
                        <span class="material-symbols-rounded">arrow_forward</span>
                    </a>
                    <a href="#services" class="btn-secondary px-8 py-4 rounded-full text-base font-bold flex justify-center items-center">
                        Explore Services
                    </a>
                </div>

                <div class="mt-12 flex items-center gap-6">
                    <div class="flex -space-x-4">
                        <img class="w-12 h-12 rounded-full border-4 border-[#f0fdf4] object-cover" src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=100&q=80" alt="Doctor" />
                        <img class="w-12 h-12 rounded-full border-4 border-[#f0fdf4] object-cover" src="https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&w=100&q=80" alt="Doctor" />
                        <img class="w-12 h-12 rounded-full border-4 border-[#f0fdf4] object-cover" src="https://images.unsplash.com/photo-1594824436998-d40de398d8be?auto=format&fit=crop&w=100&q=80" alt="Doctor" />
                    </div>
                    <div>
                        <div class="flex items-center gap-1 text-amber-500">
                            <span class="material-symbols-rounded text-lg">star</span>
                            <span class="material-symbols-rounded text-lg">star</span>
                            <span class="material-symbols-rounded text-lg">star</span>
                            <span class="material-symbols-rounded text-lg">star</span>
                            <span class="material-symbols-rounded text-lg">star</span>
                        </div>
                        <p class="text-sm font-bold text-slate-700 mt-1">Trusted by 10,000+ patients</p>
                    </div>
                </div>
            </div>

            <div class="relative hidden lg:block">
                <div class="absolute inset-0 bg-gradient-to-tr from-sky-200 to-emerald-100 rounded-[3rem] transform rotate-3 scale-105 opacity-50"></div>
                <img src="https://images.unsplash.com/photo-1576091160550-2173dba999ef?auto=format&fit=crop&w=800&q=80" 
                     alt="Modern Clinic" 
                     class="relative rounded-[3rem] shadow-2xl object-cover h-[600px] w-full" />
                     
                @* Floating badge *@
                <div class="absolute -left-10 bottom-20 bg-white p-4 rounded-2xl shadow-xl border border-slate-100 flex items-center gap-4 animate-bounce" style="animation-duration: 3s;">
                    <div class="w-12 h-12 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center">
                        <span class="material-symbols-rounded">verified</span>
                    </div>
                    <div>
                        <p class="font-bold text-slate-900">Certified Doctors</p>
                        <p class="text-xs text-slate-500 font-medium">Top medical experts</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* Features/Services Section *@
    <section id="services" class="py-24 bg-white relative">
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <h2 class="text-3xl md:text-5xl font-black text-slate-900 mb-6">Comprehensive Care Features</h2>
                <p class="text-slate-600 text-lg font-medium">Everything you need to manage your health, right at your fingertips through our secure patient portal.</p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
                <div class="feature-card p-8">
                    <div class="w-14 h-14 rounded-2xl bg-sky-100 text-sky-600 flex items-center justify-center mb-6">
                        <span class="material-symbols-rounded text-3xl">event_available</span>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-3">Instant Booking</h3>
                    <p class="text-slate-600 font-medium leading-relaxed">Book appointments with your preferred doctors instantly. No more waiting on hold.</p>
                </div>
                
                <div class="feature-card p-8">
                    <div class="w-14 h-14 rounded-2xl bg-emerald-100 text-emerald-600 flex items-center justify-center mb-6">
                        <span class="material-symbols-rounded text-3xl">clinical_notes</span>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-3">Digital Records</h3>
                    <p class="text-slate-600 font-medium leading-relaxed">Access your medical history, test results, and prescriptions securely online.</p>
                </div>

                <div class="feature-card p-8">
                    <div class="w-14 h-14 rounded-2xl bg-purple-100 text-purple-600 flex items-center justify-center mb-6">
                        <span class="material-symbols-rounded text-3xl">payments</span>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-3">Transparent Billing</h3>
                    <p class="text-slate-600 font-medium leading-relaxed">View detailed invoices and track your payments with our clear billing system.</p>
                </div>
            </div>
        </div>
    </section>

    @* Footer *@
    <footer class="bg-slate-900 pt-20 pb-10 text-slate-400">
        <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-4 gap-12 border-b border-slate-800 pb-12 mb-8">
            <div class="md:col-span-2">
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-10 h-10 rounded-xl bg-sky-500 text-white flex items-center justify-center">
                        <span class="material-symbols-rounded">medical_services</span>
                    </div>
                    <span class="text-xl font-extrabold text-white">ClinicSystem</span>
                </div>
                <p class="text-sm leading-relaxed max-w-sm">Providing world-class healthcare with the help of modern technology. Your health is our top priority.</p>
            </div>
            <div>
                <h4 class="text-white font-bold mb-6">Quick Links</h4>
                <ul class="space-y-4 text-sm font-medium">
                    <li><a href="#" class="hover:text-white transition-colors">About Us</a></li>
                    <li><a href="#" class="hover:text-white transition-colors">Our Doctors</a></li>
                    <li><a href="#" class="hover:text-white transition-colors">Services</a></li>
                </ul>
            </div>
            <div>
                <h4 class="text-white font-bold mb-6">Portals</h4>
                <ul class="space-y-4 text-sm font-medium">
                    <li><a asp-controller="Account" asp-action="Login" class="hover:text-white transition-colors">Patient Portal</a></li>
                    <li><a asp-controller="Account" asp-action="LoginDoctor" class="hover:text-white transition-colors">Staff Login</a></li>
                </ul>
            </div>
        </div>
        <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between text-sm font-medium">
            <p>&copy; @DateTime.Now.Year ClinicSystem. All rights reserved.</p>
            <div class="flex items-center gap-6 mt-4 md:mt-0">
                <a href="#" class="hover:text-white transition-colors">Privacy Policy</a>
                <a href="#" class="hover:text-white transition-colors">Terms of Service</a>
            </div>
        </div>
    </footer>

    <script>
        // Shrink nav on scroll
        window.addEventListener('scroll', () => {
            const nav = document.querySelector('.glass-nav');
            if (window.scrollY > 20) {
                nav.classList.add('shadow-md');
                nav.querySelector('.h-20').classList.replace('h-20', 'h-16');
            } else {
                nav.classList.remove('shadow-md');
                nav.querySelector('.h-16')?.classList.replace('h-16', 'h-20');
            }
        });
    </script>
</body>
</html>
