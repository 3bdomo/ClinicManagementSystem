@model Web.ViewModels.Appointment.BookStep1ViewModel
@using Common.Enums
@using System.Globalization

@{
    ViewData["Title"] = "Book Appointment";
    var culture = CultureInfo.InvariantCulture;
}

@* ── Booking Steps ──────────────────────────────────────────── *@
<div class="bg-white rounded-2xl border border-slate-200 p-5 mb-6">
    <div class="flex flex-col md:flex-row md:items-center gap-4">

        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-blue-600 text-white flex items-center justify-center font-black">
                1
            </div>
            <div>
                <p class="text-sm font-black text-slate-900">Doctor Selection</p>
                <p class="text-xs text-slate-500">Choose doctor and patient</p>
            </div>
        </div>

        <div class="hidden md:block flex-1 h-[2px] bg-slate-200"></div>

        <div class="flex items-center gap-3 opacity-60">
            <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center font-black">
                2
            </div>
            <div>
                <p class="text-sm font-black text-slate-700">Schedule</p>
                <p class="text-xs text-slate-500">Choose date and type</p>
            </div>
        </div>

        <div class="hidden md:block flex-1 h-[2px] bg-slate-200"></div>

        <div class="flex items-center gap-3 opacity-60">
            <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center font-black">
                3
            </div>
            <div>
                <p class="text-sm font-black text-slate-700">Time Slot</p>
                <p class="text-xs text-slate-500">Pick available time</p>
            </div>
        </div>

        <div class="hidden md:block flex-1 h-[2px] bg-slate-200"></div>

        <div class="flex items-center gap-3 opacity-60">
            <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center font-black">
                4
            </div>
            <div>
                <p class="text-sm font-black text-slate-700">Confirm</p>
                <p class="text-xs text-slate-500">Review and book</p>
            </div>
        </div>

    </div>
</div>

@* ── Page Header ────────────────────────────────────────────── *@
<div class="flex flex-wrap items-center justify-between gap-3 mb-4">
    <p class="text-sm text-slate-500">
        Select a doctor to start booking a new appointment.
    </p>

    <a asp-action="Index"
       class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-200 text-slate-600 text-sm font-bold hover:bg-slate-50 transition-colors">
        <span class="material-symbols-outlined text-[18px]">arrow_back</span>
        Back to Appointments
    </a>
</div>

@* ── Specialization Filter ──────────────────────────────────── *@
<form asp-action="BookStep1" method="get"
      class="bg-white rounded-2xl border border-slate-200 p-5 mb-6">

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end">

        <div>
            <label class="block text-xs font-black uppercase tracking-wider text-slate-500 mb-1">
                Specialization
            </label>

            <select name="specialization"
                    class="w-full rounded-xl border-slate-200 text-sm focus:border-blue-500 focus:ring-blue-500">
                <option value="">All Specializations</option>

                @foreach (Specialization specialization in Enum.GetValues(typeof(Specialization)))
                {
                    <option value="@specialization"
                            selected="@(Model.FilterSpecialization == specialization)">
                        @SplitPascal(specialization.ToString())
                    </option>
                }
            </select>
        </div>

        <div class="flex gap-2">
            <button type="submit"
                    class="inline-flex justify-center items-center gap-2 px-4 py-2 rounded-xl bg-slate-900 text-white text-sm font-bold hover:bg-slate-800 transition-colors">
                <span class="material-symbols-outlined text-[18px]">filter_alt</span>
                Filter
            </button>

            <a asp-action="BookStep1"
               class="inline-flex justify-center items-center px-4 py-2 rounded-xl border border-slate-200 text-slate-600 text-sm font-bold hover:bg-slate-50 transition-colors">
                Reset
            </a>
        </div>

    </div>
</form>

<form asp-action="BookStep1" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="FilterSpecialization" />

    <div asp-validation-summary="ModelOnly"
         class="mb-4 text-sm text-red-600 font-semibold"></div>

    <div class="grid grid-cols-1 xl:grid-cols-12 gap-6">

        @* Patient selector for Admin/Receptionist only *@
        <div class="xl:col-span-4 space-y-6">

            @if (Model.CanSelectPatient)
            {
                <div class="bg-white rounded-2xl border border-slate-200 p-6">
                    <h3 class="text-lg font-black text-slate-900 mb-2">
                        Patient
                    </h3>
                    <p class="text-sm text-slate-500 mb-4">
                        Select the patient for this appointment.
                    </p>

                    <label asp-for="SelectedPatientId"
                           class="block text-xs font-black uppercase tracking-wider text-slate-500 mb-1">
                        Patient
                    </label>

                    <select asp-for="SelectedPatientId"
                            class="w-full rounded-xl border-slate-200 text-sm focus:border-blue-500 focus:ring-blue-500">
                        <option value="">Select patient</option>

                        @foreach (var patient in Model.Patients)
                        {
                            <option value="@patient.Id">
                                @patient.FullName
                            </option>
                        }
                    </select>

                    <span asp-validation-for="SelectedPatientId"
                          class="block mt-2 text-sm text-red-600"></span>
                </div>
            }
            else
            {
                <div class="bg-blue-50 rounded-2xl border border-blue-100 p-6">
                    <div class="flex items-start gap-3">
                        <span class="material-symbols-outlined text-blue-600">info</span>
                        <div>
                            <h3 class="font-black text-blue-900">
                                Self booking
                            </h3>
                            <p class="text-sm text-blue-700 mt-1">
                                You are booking this appointment for your own patient profile.
                            </p>
                        </div>
                    </div>
                </div>
            }

            <div class="bg-white rounded-2xl border border-slate-200 p-6">
                <h3 class="text-lg font-black text-slate-900 mb-2">
                    Booking Guide
                </h3>

                <div class="space-y-4 text-sm text-slate-600">
                    <div class="flex gap-3">
                        <span class="material-symbols-outlined text-blue-600">looks_one</span>
                        <p>Select a doctor from the available list.</p>
                    </div>

                    <div class="flex gap-3">
                        <span class="material-symbols-outlined text-blue-600">looks_two</span>
                        <p>Choose a date and appointment type.</p>
                    </div>

                    <div class="flex gap-3">
                        <span class="material-symbols-outlined text-blue-600">looks_3</span>
                        <p>Pick an available time slot and confirm booking.</p>
                    </div>
                </div>
            </div>

        </div>

        @* Doctor cards *@
        <div class="xl:col-span-8">

            <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">

                <div class="p-5 border-b border-slate-100">
                    <h3 class="text-lg font-black text-slate-900">
                        Available Doctors
                    </h3>
                    <p class="text-sm text-slate-500 mt-1">
                        @Model.Doctors.Count() doctor(s) found.
                    </p>
                </div>

                @if (!Model.Doctors.Any())
                {
                    <div class="px-5 py-16 text-center text-slate-400">
                        <span class="material-symbols-outlined block mb-2"
                              style="font-size:42px;opacity:.25">
                            stethoscope
                        </span>
                        No doctors found for the selected specialization.
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 p-5">

                        @foreach (var doctor in Model.Doctors)
                        {
                            var isChecked = Model.SelectedDoctorId == doctor.Id;
                            var initials = GetInitials(doctor.FullName);

                            <label class="doctor-card cursor-pointer rounded-2xl border p-5 transition-all hover:border-blue-300 hover:bg-blue-50/40 @(isChecked ? "border-blue-600 bg-blue-50" : "border-slate-200 bg-white")">

                                <div class="flex items-start gap-4">

                                    <input type="radio"
                                           asp-for="SelectedDoctorId"
                                           value="@doctor.Id"
                                           class="mt-1 text-blue-600 focus:ring-blue-500" />

                                    <div class="w-12 h-12 rounded-2xl bg-blue-600 text-white flex items-center justify-center font-black flex-shrink-0">
                                        @initials
                                    </div>

                                    <div class="min-w-0">
                                        <h4 class="font-black text-slate-900 truncate">
                                            @doctor.FullName
                                        </h4>

                                        <p class="text-xs font-bold text-blue-600 uppercase tracking-wider mt-1">
                                            @SplitPascal(doctor.Specialization.ToString())
                                        </p>

                                        @if (!string.IsNullOrWhiteSpace(doctor.Bio))
                                        {
                                            <p class="text-sm text-slate-500 mt-3">
                                                @doctor.Bio
                                            </p>
                                        }

                                        <div class="mt-4 inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-100 text-slate-600 text-xs font-bold">
                                            <span class="material-symbols-outlined text-[16px]">payments</span>
                                            Fee: @((doctor.ConsultationFee ?? 0).ToString("C", culture))
                                        </div>
                                    </div>

                                </div>
                            </label>
                        }

                    </div>
                }

                <div class="p-5 border-t border-slate-100 flex items-center justify-between gap-3">
                    <span asp-validation-for="SelectedDoctorId"
                          class="text-sm text-red-600"></span>

                    <button type="submit"
                            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-blue-600 text-white text-sm font-bold hover:bg-blue-700 transition-colors">
                        Continue to Schedule
                        <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                    </button>
                </div>

            </div>

        </div>

    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@functions {
    private static string SplitPascal(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return value;

        var result = "";

        for (var i = 0; i < value.Length; i++)
        {
            if (i > 0 && char.IsUpper(value[i]))
                result += " ";

            result += value[i];
        }

        return result;
    }

    private static string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "DR";

        return string.Concat(
            fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                    .Take(2)
                    .Select(w => w[0])
        ).ToUpper();
    }
}