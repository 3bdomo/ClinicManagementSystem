@model Web.ViewModels.Appointment.AppointmentIndexViewModel
@using Common.Enums
@using System.Globalization

@{
    ViewData["Title"] = "Appointments";

    var culture = CultureInfo.InvariantCulture;

    var canBook =
        User.IsInRole("Admin") ||
        User.IsInRole("Receptionist") ||
        User.IsInRole("Patient");

    var canFilterDoctor =
        User.IsInRole("Admin") ||
        User.IsInRole("Receptionist");

    var currentMonth = new DateTime(Model.CalendarYear, Model.CalendarMonth, 1);
    var previousMonth = currentMonth.AddMonths(-1);
    var nextMonth = currentMonth.AddMonths(1);

    var firstDayOfMonth = new DateTime(Model.CalendarYear, Model.CalendarMonth, 1);
    var daysInMonth = DateTime.DaysInMonth(Model.CalendarYear, Model.CalendarMonth);
    var leadingBlanks = (int)firstDayOfMonth.DayOfWeek;

    var busyDays = Model.BusyDays
        .Select(d => d.Date)
        .ToHashSet();
}

@* ── Stats ──────────────────────────────────────────────────── *@
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-6">

    <div class="bg-white rounded-2xl border border-slate-200 p-5 flex items-center gap-4">
        <div class="w-11 h-11 rounded-xl bg-blue-50 flex items-center justify-center flex-shrink-0">
            <span class="material-symbols-outlined text-blue-600">event</span>
        </div>
        <div>
            <p class="text-2xl font-black text-slate-900 leading-none">
                @Model.TotalToday
            </p>
            <p class="text-xs text-slate-500 mt-1">Total Today</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 p-5 flex items-center gap-4">
        <div class="w-11 h-11 rounded-xl bg-amber-50 flex items-center justify-center flex-shrink-0">
            <span class="material-symbols-outlined text-amber-600">pending_actions</span>
        </div>
        <div>
            <p class="text-2xl font-black text-slate-900 leading-none">
                @Model.WaitingCount
            </p>
            <p class="text-xs text-slate-500 mt-1">Waiting</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 p-5 flex items-center gap-4">
        <div class="w-11 h-11 rounded-xl bg-indigo-50 flex items-center justify-center flex-shrink-0">
            <span class="material-symbols-outlined text-indigo-600">play_circle</span>
        </div>
        <div>
            <p class="text-2xl font-black text-slate-900 leading-none">
                @Model.InProgressCount
            </p>
            <p class="text-xs text-slate-500 mt-1">In Progress</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 p-5 flex items-center gap-4">
        <div class="w-11 h-11 rounded-xl bg-emerald-50 flex items-center justify-center flex-shrink-0">
            <span class="material-symbols-outlined text-emerald-600">check_circle</span>
        </div>
        <div>
            <p class="text-2xl font-black text-slate-900 leading-none">
                @Model.CompletedCount
            </p>
            <p class="text-xs text-slate-500 mt-1">Completed</p>
        </div>
    </div>

</div>

@* ── Header Actions ─────────────────────────────────────────── *@
<div class="flex flex-wrap items-center justify-between gap-3 mb-4">
    <div>
        @if (User.IsInRole("Doctor"))
        {
            <p class="text-sm text-slate-500">Your appointments for the selected day.</p>
        }
        else if (User.IsInRole("Patient"))
        {
            <p class="text-sm text-slate-500">Your appointment history and upcoming visits.</p>
        }
        else
        {
            <p class="text-sm text-slate-500">Manage clinic appointments and daily schedule.</p>
        }
    </div>

    @if (canBook)
    {
        <a asp-action="BookStep1"
           class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-blue-600 text-white text-sm font-bold hover:bg-blue-700 transition-colors whitespace-nowrap">
            <span class="material-symbols-outlined text-[18px]">event_available</span>
            Book Appointment
        </a>
    }
</div>

@* ── Filters ────────────────────────────────────────────────── *@
<form asp-action="Index" method="get"
      class="bg-white rounded-2xl border border-slate-200 p-5 mb-6">

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-5 gap-4 items-end">

        <div>
            <label class="block text-xs font-black uppercase tracking-wider text-slate-500 mb-1">
                Date
            </label>
            <input type="date"
                   name="date"
                   value="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                   class="w-full rounded-xl border-slate-200 text-sm focus:border-blue-500 focus:ring-blue-500" />
        </div>

        @if (canFilterDoctor)
        {
            <div>
                <label class="block text-xs font-black uppercase tracking-wider text-slate-500 mb-1">
                    Doctor
                </label>
                <select name="doctorId"
                        class="w-full rounded-xl border-slate-200 text-sm focus:border-blue-500 focus:ring-blue-500">
                    <option value="">All Doctors</option>

                    @foreach (var doctor in Model.Doctors)
                    {
                        <option value="@doctor.Id" selected="@(Model.FilterDoctorId == doctor.Id)">
                            @doctor.FullName
                        </option>
                    }
                </select>
            </div>
        }

        <div>
            <label class="block text-xs font-black uppercase tracking-wider text-slate-500 mb-1">
                Status
            </label>
            <select name="status"
                    class="w-full rounded-xl border-slate-200 text-sm focus:border-blue-500 focus:ring-blue-500">
                <option value="">All Statuses</option>

                @foreach (AppointmentStatus value in Enum.GetValues(typeof(AppointmentStatus)))
                {
                    <option value="@value" selected="@(Model.FilterStatus == value)">
                        @SplitPascal(value.ToString())
                    </option>
                }
            </select>
        </div>

        <div>
            <label class="block text-xs font-black uppercase tracking-wider text-slate-500 mb-1">
                Type
            </label>
            <select name="type"
                    class="w-full rounded-xl border-slate-200 text-sm focus:border-blue-500 focus:ring-blue-500">
                <option value="">All Types</option>

                @foreach (AppointmentType value in Enum.GetValues(typeof(AppointmentType)))
                {
                    <option value="@value" selected="@(Model.FilterType == value)">
                        @SplitPascal(value.ToString())
                    </option>
                }
            </select>
        </div>

        <div class="flex gap-2">
            <button type="submit"
                    class="inline-flex justify-center items-center gap-2 px-4 py-2 rounded-xl bg-slate-900 text-white text-sm font-bold hover:bg-slate-800 transition-colors w-full">
                <span class="material-symbols-outlined text-[18px]">filter_alt</span>
                Apply
            </button>

            <a asp-action="Index"
               class="inline-flex justify-center items-center px-4 py-2 rounded-xl border border-slate-200 text-slate-600 text-sm font-bold hover:bg-slate-50 transition-colors">
                Reset
            </a>
        </div>

    </div>
</form>

@* ── Main Grid ──────────────────────────────────────────────── *@
<div class="grid grid-cols-1 xl:grid-cols-12 gap-6">

    @* Calendar card *@
    <div class="xl:col-span-4">
        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">

            <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                <div>
                    <h3 class="text-lg font-black text-slate-900">
                        @currentMonth.ToString("MMMM yyyy", culture)
                    </h3>
                    <p class="text-xs text-slate-500 mt-1">
                        Days with dots have appointments.
                    </p>
                </div>

                <div class="flex items-center gap-1">
                    <a asp-action="Index"
                       asp-route-date="@previousMonth.ToString("yyyy-MM-dd")"
                       asp-route-month="@previousMonth.Month"
                       asp-route-year="@previousMonth.Year"
                       asp-route-doctorId="@Model.FilterDoctorId"
                       asp-route-status="@Model.FilterStatus"
                       asp-route-type="@Model.FilterType"
                       class="w-9 h-9 rounded-lg border border-slate-200 flex items-center justify-center text-slate-600 hover:bg-slate-50">
                        <span class="material-symbols-outlined text-[20px]">chevron_left</span>
                    </a>

                    <a asp-action="Index"
                       asp-route-date="@nextMonth.ToString("yyyy-MM-dd")"
                       asp-route-month="@nextMonth.Month"
                       asp-route-year="@nextMonth.Year"
                       asp-route-doctorId="@Model.FilterDoctorId"
                       asp-route-status="@Model.FilterStatus"
                       asp-route-type="@Model.FilterType"
                       class="w-9 h-9 rounded-lg border border-slate-200 flex items-center justify-center text-slate-600 hover:bg-slate-50">
                        <span class="material-symbols-outlined text-[20px]">chevron_right</span>
                    </a>
                </div>
            </div>

            <div class="p-5">
                <div class="grid grid-cols-7 gap-2 mb-3">
                    <div class="text-center text-[10px] font-black uppercase text-slate-400">Sun</div>
                    <div class="text-center text-[10px] font-black uppercase text-slate-400">Mon</div>
                    <div class="text-center text-[10px] font-black uppercase text-slate-400">Tue</div>
                    <div class="text-center text-[10px] font-black uppercase text-slate-400">Wed</div>
                    <div class="text-center text-[10px] font-black uppercase text-slate-400">Thu</div>
                    <div class="text-center text-[10px] font-black uppercase text-slate-400">Fri</div>
                    <div class="text-center text-[10px] font-black uppercase text-slate-400">Sat</div>
                </div>

                <div class="grid grid-cols-7 gap-2">

                    @* Empty cells before first day *@
                    @for (var i = 0; i < leadingBlanks; i++)
                    {
                        <div class="h-10"></div>
                    }

                    @for (var day = 1; day <= daysInMonth; day++)
                    {
                        var currentDate = new DateTime(Model.CalendarYear, Model.CalendarMonth, day);
                        var isSelected = currentDate.Date == Model.SelectedDate.Date;
                        var isToday = currentDate.Date == DateTime.Today;
                        var hasAppointments = busyDays.Contains(currentDate.Date);

                        var dayClasses = isSelected
                        ? "bg-blue-600 text-white shadow-sm"
                        : isToday && hasAppointments
                        ? "bg-blue-50 text-blue-700 ring-2 ring-blue-300"
                        : isToday
                        ? "bg-blue-50 text-blue-700"
                        : hasAppointments
                        ? "bg-emerald-50 text-emerald-700 font-black"
                        : "text-slate-700 hover:bg-slate-50";

                        <a asp-action="Index"
                           asp-route-date="@currentDate.ToString("yyyy-MM-dd")"
                           asp-route-month="@Model.CalendarMonth"
                           asp-route-year="@Model.CalendarYear"
                           asp-route-doctorId="@Model.FilterDoctorId"
                           asp-route-status="@Model.FilterStatus"
                           asp-route-type="@Model.FilterType"
                           class="relative h-10 rounded-xl flex items-center justify-center text-sm font-bold transition-colors @dayClasses">

                            @day

                            @if (hasAppointments)
                            {
                                <span class="absolute bottom-1 left-1/2 -translate-x-1/2 w-1.5 h-1.5 rounded-full @(isSelected ? "bg-white" : "bg-blue-500")"></span>
                            }
                        </a>
                    }

                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 p-5 mt-6">
            <h4 class="text-sm font-black text-slate-900 mb-3">Legend</h4>

            <div class="space-y-3 text-sm">
                <div class="flex items-center gap-3 text-slate-600">
                    <span class="w-3 h-3 rounded-full bg-blue-500"></span>
                    Day has appointments
                </div>

                <div class="flex items-center gap-3 text-slate-600">
                    <span class="w-3 h-3 rounded-full bg-blue-600"></span>
                    Selected day
                </div>

                <div class="flex items-center gap-3 text-slate-600">
                    <span class="w-3 h-3 rounded-full bg-blue-50 border border-blue-200"></span>
                    Today
                </div>
            </div>
        </div>
    </div>

    @* Appointments list *@
    <div class="xl:col-span-8">
        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">

            <div class="p-5 border-b border-slate-100 flex flex-wrap items-center justify-between gap-3">
                <div>
                    <h3 class="text-lg font-black text-slate-900">
                        @Model.SelectedDate.ToString("dddd, MMM dd, yyyy", culture)
                    </h3>
                    <p class="text-sm text-slate-500 mt-1">
                        @Model.DayAppointments.Count() appointment(s) scheduled.
                    </p>
                </div>
            </div>

            @if (!Model.DayAppointments.Any())
            {
                <div class="px-5 py-16 text-center text-slate-400">
                    <span class="material-symbols-outlined block mb-2"
                          style="font-size:42px;opacity:.25">
                        event_busy
                    </span>
                    <p class="font-semibold">No appointments found for this date.</p>

                    @if (canBook)
                    {
                        <a asp-action="BookStep1"
                           class="inline-flex items-center gap-2 mt-4 px-4 py-2 rounded-xl bg-blue-600 text-white text-sm font-bold hover:bg-blue-700">
                            <span class="material-symbols-outlined text-[18px]">add</span>
                            Book Appointment
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="divide-y divide-slate-100">

                    @foreach (var appointment in Model.DayAppointments)
                    {
                        var statusClasses = GetStatusBadgeClasses(appointment.Status);
                        var typeClasses = GetTypeBadgeClasses(appointment.AppointmentType);

                        <div class="p-5 hover:bg-slate-50 transition-colors">

                            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">

                                <div class="flex items-start gap-4 min-w-0">

                                    <div class="w-14 h-14 rounded-2xl bg-slate-100 flex flex-col items-center justify-center flex-shrink-0">
                                        <span class="text-[10px] font-black text-slate-500 uppercase">
                                            @appointment.AppointmentDate.ToString("tt", culture)
                                        </span>
                                        <span class="text-sm font-black text-slate-900">
                                            @appointment.AppointmentDate.ToString("hh:mm", culture)
                                        </span>
                                    </div>

                                    <div class="min-w-0">
                                        <div class="flex flex-wrap items-center gap-2 mb-1">
                                            <h4 class="font-black text-slate-900 truncate">
                                                @appointment.PatientName
                                            </h4>

                                            <span class="@statusClasses">
                                                @SplitPascal(appointment.Status.ToString())
                                            </span>

                                            <span class="@typeClasses">
                                                @SplitPascal(appointment.AppointmentType.ToString())
                                            </span>
                                        </div>

                                        <p class="text-sm text-slate-500">
                                            <span class="font-semibold text-slate-700">Doctor:</span>
                                            @appointment.DoctorName
                                        </p>

                                        <div class="flex flex-wrap items-center gap-4 mt-2 text-xs text-slate-400">
                                            <span class="inline-flex items-center gap-1">
                                                <span class="material-symbols-outlined text-[16px]">schedule</span>
                                                @appointment.DurationMinutes min
                                            </span>

                                            @if (appointment.HasMedicalRecord)
                                            {
                                                <span class="inline-flex items-center gap-1 text-emerald-600">
                                                    <span class="material-symbols-outlined text-[16px]">clinical_notes</span>
                                                    Medical record
                                                </span>
                                            }

                                            @if (appointment.HasInvoice)
                                            {
                                                <span class="inline-flex items-center gap-1 text-blue-600">
                                                    <span class="material-symbols-outlined text-[16px]">receipt_long</span>
                                                    Invoice
                                                </span>
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(appointment.Notes))
                                        {
                                            <p class="text-xs text-slate-500 mt-2 line-clamp-1">
                                                @appointment.Notes
                                            </p>
                                        }
                                    </div>
                                </div>

                                <div class="flex items-center justify-end gap-2 flex-shrink-0">
                                    <a asp-action="Details"
                                       asp-route-id="@appointment.Id"
                                       class="px-3 py-2 rounded-xl border border-slate-200 text-slate-600 text-xs font-bold hover:bg-slate-50 transition-colors">
                                        Details
                                    </a>
                                </div>

                            </div>
                        </div>
                    }

                </div>
            }
        </div>
    </div>
</div>

@functions {
    // Converts "InProgress" to "In Progress"
    private static string SplitPascal(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return value;

        var result = "";

        for (var i = 0; i < value.Length; i++)
        {
            if (i > 0 && char.IsUpper(value[i]))
                result += " ";

            result += value[i];
        }

        return result;
    }

    // Static classes are safer with Tailwind CDN.
    private static string GetStatusBadgeClasses(AppointmentStatus status)
    {
        return status switch
        {
            AppointmentStatus.Waiting =>
                "inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-700",

            AppointmentStatus.InProgress =>
                "inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700",

            AppointmentStatus.Completed =>
                "inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700",

            AppointmentStatus.Cancelled =>
                "inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-red-50 text-red-700",

            _ =>
                "inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-600"
        };
    }

    private static string GetTypeBadgeClasses(AppointmentType type)
    {
        return type switch
        {
            AppointmentType.Surgery =>
                "inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-purple-50 text-purple-700",

            AppointmentType.Consultation =>
                "inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-700",

            _ =>
                "inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-600"
        };
    }
}