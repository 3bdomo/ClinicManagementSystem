@model Web.ViewModels.Appointment.BookConfirmViewModel
@using Common.Enums
@using System.Globalization

@{
    ViewData["Title"] = "Confirm Appointment";
    var culture = CultureInfo.InvariantCulture;
}

@* ── Booking Steps ──────────────────────────────────────────── *@
<div class="bg-white rounded-2xl border border-slate-200 p-5 mb-6">
    <div class="flex flex-col md:flex-row md:items-center gap-4">

        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-emerald-600 text-white flex items-center justify-center font-black">
                <span class="material-symbols-outlined text-[18px]">check</span>
            </div>
            <div>
                <p class="text-sm font-black text-emerald-700">Doctor Selection</p>
                <p class="text-xs text-slate-500">Completed</p>
            </div>
        </div>

        <div class="hidden md:block flex-1 h-[2px] bg-emerald-500"></div>

        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-emerald-600 text-white flex items-center justify-center font-black">
                <span class="material-symbols-outlined text-[18px]">check</span>
            </div>
            <div>
                <p class="text-sm font-black text-emerald-700">Schedule</p>
                <p class="text-xs text-slate-500">Completed</p>
            </div>
        </div>

        <div class="hidden md:block flex-1 h-[2px] bg-emerald-500"></div>

        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-emerald-600 text-white flex items-center justify-center font-black">
                <span class="material-symbols-outlined text-[18px]">check</span>
            </div>
            <div>
                <p class="text-sm font-black text-emerald-700">Time Slot</p>
                <p class="text-xs text-slate-500">Completed</p>
            </div>
        </div>

        <div class="hidden md:block flex-1 h-[2px] bg-emerald-500"></div>

        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-blue-600 text-white flex items-center justify-center font-black">
                4
            </div>
            <div>
                <p class="text-sm font-black text-slate-900">Confirm</p>
                <p class="text-xs text-slate-500">Review and book</p>
            </div>
        </div>

    </div>
</div>

<div class="grid grid-cols-1 xl:grid-cols-12 gap-6">

    <div class="xl:col-span-8">

        <form asp-action="BookConfirm" method="post"
              class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
            @Html.AntiForgeryToken()

            @* Hidden values are used by the POST action to create the appointment. *@
            <input type="hidden" asp-for="DoctorId" />
            <input type="hidden" asp-for="PatientId" />
            <input type="hidden" asp-for="AppointmentDate" value="@Model.AppointmentDate.ToString("yyyy-MM-ddTHH:mm:ss")" />
            <input type="hidden" asp-for="DurationMinutes" />
            <input type="hidden" asp-for="ScheduleType" />
            <input type="hidden" asp-for="AppointmentType" />

            <input type="hidden" asp-for="DoctorName" />
            <input type="hidden" asp-for="PatientName" />
            <input type="hidden" asp-for="DoctorSpecialization" />
            <input type="hidden" asp-for="ConsultationFee" />

            <div class="p-6 border-b border-slate-100">
                <h3 class="text-xl font-black text-slate-900">
                    Confirm Appointment
                </h3>
                <p class="text-sm text-slate-500 mt-1">
                    Please review the details before saving this appointment.
                </p>
            </div>

            <div class="p-6">

                <div asp-validation-summary="ModelOnly"
                     class="mb-4 text-sm text-red-600 font-semibold"></div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">

                    <div class="rounded-2xl bg-slate-50 border border-slate-100 p-5">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center">
                                <span class="material-symbols-outlined text-blue-600">stethoscope</span>
                            </div>
                            <div>
                                <p class="text-xs font-black uppercase tracking-wider text-slate-400">
                                    Doctor
                                </p>
                                <p class="font-black text-slate-900">
                                    @Model.DoctorName
                                </p>
                                <p class="text-xs font-bold text-blue-600 uppercase tracking-wider mt-1">
                                    @SplitPascal(Model.DoctorSpecialization.ToString())
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="rounded-2xl bg-slate-50 border border-slate-100 p-5">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center">
                                <span class="material-symbols-outlined text-emerald-600">person</span>
                            </div>
                            <div>
                                <p class="text-xs font-black uppercase tracking-wider text-slate-400">
                                    Patient
                                </p>
                                <p class="font-black text-slate-900">
                                    @Model.PatientName
                                </p>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="rounded-2xl border border-slate-200 overflow-hidden mb-6">

                    <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-slate-100">

                        <div class="p-5">
                            <p class="text-xs font-black uppercase tracking-wider text-slate-400 mb-1">
                                Date
                            </p>
                            <p class="font-black text-slate-900">
                                @Model.AppointmentDate.ToString("dddd, MMM dd, yyyy", culture)
                            </p>
                        </div>

                        <div class="p-5">
                            <p class="text-xs font-black uppercase tracking-wider text-slate-400 mb-1">
                                Time
                            </p>
                            <p class="font-black text-slate-900">
                                @Model.AppointmentDate.ToString("hh:mm tt", culture)
                            </p>
                        </div>

                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-slate-100 border-t border-slate-100">

                        <div class="p-5">
                            <p class="text-xs font-black uppercase tracking-wider text-slate-400 mb-1">
                                Duration
                            </p>
                            <p class="font-black text-slate-900">
                                @Model.DurationMinutes minutes
                            </p>
                        </div>

                        <div class="p-5">
                            <p class="text-xs font-black uppercase tracking-wider text-slate-400 mb-1">
                                Type
                            </p>
                            <p class="font-black text-slate-900">
                                @SplitPascal(Model.AppointmentType.ToString())
                            </p>
                        </div>

                        <div class="p-5">
                            <p class="text-xs font-black uppercase tracking-wider text-slate-400 mb-1">
                                Fee
                            </p>
                            <p class="font-black text-slate-900">
                                @Model.ConsultationFee.ToString("C", culture)
                            </p>
                        </div>

                    </div>

                </div>

                <div class="rounded-2xl bg-blue-50 border border-blue-100 p-5 mb-6">
                    <div class="flex gap-3">
                        <span class="material-symbols-outlined text-blue-600">info</span>
                        <p class="text-sm text-blue-700 leading-relaxed">
                            Once confirmed, the appointment will be saved as Waiting and can be managed from the appointment details page.
                        </p>
                    </div>
                </div>

                <div class="flex flex-wrap items-center justify-between gap-3 pt-6 border-t border-slate-100">

                    <a asp-action="BookStep3"
                       asp-route-doctorId="@Model.DoctorId"
                       asp-route-patientId="@Model.PatientId"
                       asp-route-date="@Model.AppointmentDate.ToString("yyyy-MM-dd")"
                       asp-route-scheduleType="@Model.ScheduleType"
                       class="inline-flex items-center gap-2 px-4 py-3 rounded-xl border border-slate-200 text-slate-600 text-sm font-bold hover:bg-slate-50 transition-colors">
                        <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                        Back to Time Slots
                    </a>

                    <button type="submit"
                            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-blue-600 text-white text-sm font-bold hover:bg-blue-700 transition-colors">
                        Confirm & Book
                        <span class="material-symbols-outlined text-[18px]">check_circle</span>
                    </button>

                </div>

            </div>
        </form>

    </div>

    <div class="xl:col-span-4">

        <div class="bg-white rounded-2xl border border-slate-200 p-6 sticky top-28">
            <h3 class="text-lg font-black text-slate-900 mb-2">
                Final Review
            </h3>

            <p class="text-sm text-slate-500 mb-6">
                Make sure the appointment information is correct before confirming.
            </p>

            <div class="space-y-4 text-sm">

                <div class="flex items-center gap-3 text-slate-600">
                    <span class="material-symbols-outlined text-blue-600">event</span>
                    Appointment will be created immediately.
                </div>

                <div class="flex items-center gap-3 text-slate-600">
                    <span class="material-symbols-outlined text-amber-600">pending_actions</span>
                    Initial status will be Waiting.
                </div>

                <div class="flex items-center gap-3 text-slate-600">
                    <span class="material-symbols-outlined text-emerald-600">verified</span>
                    Slot availability is checked again by the service.
                </div>

            </div>
        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@functions {
    private static string SplitPascal(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return value;

        var result = "";

        for (var i = 0; i < value.Length; i++)
        {
            if (i > 0 && char.IsUpper(value[i]))
                result += " ";

            result += value[i];
        }

        return result;
    }
}