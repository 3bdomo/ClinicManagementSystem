@model Web.ViewModels.Appointment.BookStep3ViewModel
@using Common.Enums
@using System.Globalization

@{
    ViewData["Title"] = "Choose Time Slot";
    var culture = CultureInfo.InvariantCulture;
}

@* ── Booking Steps ──────────────────────────────────────────── *@
<div class="bg-white rounded-2xl border border-slate-200 p-5 mb-6">
    <div class="flex flex-col md:flex-row md:items-center gap-4">

        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-emerald-600 text-white flex items-center justify-center font-black">
                <span class="material-symbols-outlined text-[18px]">check</span>
            </div>
            <div>
                <p class="text-sm font-black text-emerald-700">Doctor Selection</p>
                <p class="text-xs text-slate-500">Completed</p>
            </div>
        </div>

        <div class="hidden md:block flex-1 h-[2px] bg-emerald-500"></div>

        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-emerald-600 text-white flex items-center justify-center font-black">
                <span class="material-symbols-outlined text-[18px]">check</span>
            </div>
            <div>
                <p class="text-sm font-black text-emerald-700">Schedule</p>
                <p class="text-xs text-slate-500">Completed</p>
            </div>
        </div>

        <div class="hidden md:block flex-1 h-[2px] bg-emerald-500"></div>

        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-blue-600 text-white flex items-center justify-center font-black">
                3
            </div>
            <div>
                <p class="text-sm font-black text-slate-900">Time Slot</p>
                <p class="text-xs text-slate-500">Pick available time</p>
            </div>
        </div>

        <div class="hidden md:block flex-1 h-[2px] bg-slate-200"></div>

        <div class="flex items-center gap-3 opacity-60">
            <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center font-black">
                4
            </div>
            <div>
                <p class="text-sm font-black text-slate-700">Confirm</p>
                <p class="text-xs text-slate-500">Review and book</p>
            </div>
        </div>

    </div>
</div>

<form asp-action="BookStep3" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="DoctorId" />
    <input type="hidden" asp-for="PatientId" />
    <input type="hidden" asp-for="SelectedDate" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
    <input type="hidden" asp-for="ScheduleType" />
    <input type="hidden" asp-for="SelectedSlotStart" id="SelectedSlotStart" />

    <div asp-validation-summary="ModelOnly"
         class="mb-4 text-sm text-red-600 font-semibold"></div>

    <div class="grid grid-cols-1 xl:grid-cols-12 gap-6">

        @* Summary card *@
        <div class="xl:col-span-4 space-y-6">

            <div class="bg-white rounded-2xl border border-slate-200 p-6">
                <h3 class="text-lg font-black text-slate-900 mb-4">
                    Selection Summary
                </h3>

                <div class="space-y-4">

                    <div class="rounded-2xl bg-slate-50 border border-slate-100 p-4">
                        <p class="text-xs font-black uppercase tracking-wider text-slate-400">
                            Doctor
                        </p>
                        <p class="font-black text-slate-900 mt-1">
                            @Model.DoctorName
                        </p>
                        <p class="text-xs font-bold text-blue-600 uppercase tracking-wider mt-1">
                            @SplitPascal(Model.DoctorSpecialization.ToString())
                        </p>
                    </div>

                    <div class="rounded-2xl bg-slate-50 border border-slate-100 p-4">
                        <p class="text-xs font-black uppercase tracking-wider text-slate-400">
                            Patient
                        </p>
                        <p class="font-black text-slate-900 mt-1">
                            @Model.PatientName
                        </p>
                    </div>

                    <div class="rounded-2xl border border-slate-200 p-4">
                        <div class="flex justify-between gap-3 py-2 border-b border-slate-100">
                            <span class="text-sm text-slate-500">Date</span>
                            <span class="text-sm font-black text-slate-900">
                                @Model.SelectedDate.ToString("MMM dd, yyyy", culture)
                            </span>
                        </div>

                        <div class="flex justify-between gap-3 py-2 border-b border-slate-100">
                            <span class="text-sm text-slate-500">Type</span>
                            <span class="text-sm font-black text-slate-900">
                                @SplitPascal(Model.ScheduleType.ToString())
                            </span>
                        </div>

                        <div class="flex justify-between gap-3 py-2">
                            <span class="text-sm text-slate-500">Slot Duration</span>
                            <span class="text-sm font-black text-slate-900">
                                @Model.SlotDurationMinutes min
                            </span>
                        </div>
                    </div>

                    <div class="rounded-2xl bg-blue-50 border border-blue-100 p-4 text-sm text-blue-700">
                        <div class="flex gap-3">
                            <span class="material-symbols-outlined">info</span>
                            <p>
                                Please select one available slot before continuing to confirmation.
                            </p>
                        </div>
                    </div>

                </div>
            </div>

        </div>

        @* Slot picker *@
        <div class="xl:col-span-8">

            <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">

                <div class="p-6 border-b border-slate-100">
                    <h3 class="text-lg font-black text-slate-900">
                        Available Time Slots
                    </h3>
                    <p class="text-sm text-slate-500 mt-1">
                        Showing slots for @Model.SelectedDate.ToString("dddd, MMM dd, yyyy", culture).
                    </p>
                </div>

                <div class="p-6">

                    <span asp-validation-for="SelectedSlotStart"
                          class="block mb-4 text-sm text-red-600"></span>

                    @if (!Model.MorningSlots.Any() && !Model.AfternoonSlots.Any())
                    {
                        <div class="py-16 text-center text-slate-400">
                            <span class="material-symbols-outlined block mb-2"
                                  style="font-size:42px;opacity:.25">
                                event_busy
                            </span>
                            No available slots for this date.
                        </div>
                    }
                    else
                    {
                        @if (Model.MorningSlots.Any())
                        {
                            <div class="mb-8">
                                <div class="flex items-center gap-2 mb-4">
                                    <span class="material-symbols-outlined text-amber-500">light_mode</span>
                                    <h4 class="text-xs font-black uppercase tracking-wider text-slate-500">
                                        Morning Slots
                                    </h4>
                                </div>

                                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
                                    @foreach (var slot in Model.MorningSlots)
                                    {
                                        <button type="button"
                                                class="slot-button py-4 rounded-xl border border-slate-200 text-slate-700 text-sm font-black hover:border-blue-500 hover:text-blue-600 hover:bg-blue-50 transition-all"
                                                data-slot="@slot.SlotStart.ToString("yyyy-MM-ddTHH:mm:ss")">
                                            @slot.SlotStart.ToString("hh:mm tt", culture)
                                        </button>
                                    }
                                </div>
                            </div>
                        }

                        @if (Model.AfternoonSlots.Any())
                        {
                            <div class="mb-8">
                                <div class="flex items-center gap-2 mb-4">
                                    <span class="material-symbols-outlined text-blue-500">wb_sunny</span>
                                    <h4 class="text-xs font-black uppercase tracking-wider text-slate-500">
                                        Afternoon Slots
                                    </h4>
                                </div>

                                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
                                    @foreach (var slot in Model.AfternoonSlots)
                                    {
                                        <button type="button"
                                                class="slot-button py-4 rounded-xl border border-slate-200 text-slate-700 text-sm font-black hover:border-blue-500 hover:text-blue-600 hover:bg-blue-50 transition-all"
                                                data-slot="@slot.SlotStart.ToString("yyyy-MM-ddTHH:mm:ss")">
                                            @slot.SlotStart.ToString("hh:mm tt", culture)
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    }

                    <div class="flex flex-wrap items-center justify-between gap-3 pt-6 border-t border-slate-100">

                        <a asp-action="BookStep2"
                           asp-route-doctorId="@Model.DoctorId"
                           asp-route-patientId="@Model.PatientId"
                           class="inline-flex items-center gap-2 px-4 py-3 rounded-xl border border-slate-200 text-slate-600 text-sm font-bold hover:bg-slate-50 transition-colors">
                            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                            Back to Schedule
                        </a>

                        <button type="submit"
                                class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-blue-600 text-white text-sm font-bold hover:bg-blue-700 transition-colors">
                            Continue to Confirm
                            <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                        </button>

                    </div>

                </div>
            </div>

        </div>

    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Simple slot selection UI.
        document.addEventListener("DOMContentLoaded", function () {
            const hiddenInput = document.getElementById("SelectedSlotStart");
            const buttons = document.querySelectorAll(".slot-button");

            buttons.forEach(button => {
                button.addEventListener("click", function () {
                    buttons.forEach(b => {
                        b.classList.remove("bg-blue-600", "text-white", "border-blue-600", "ring-2", "ring-blue-600", "ring-offset-2");
                        b.classList.add("border-slate-200", "text-slate-700");
                    });

                    this.classList.remove("border-slate-200", "text-slate-700");
                    this.classList.add("bg-blue-600", "text-white", "border-blue-600", "ring-2", "ring-blue-600", "ring-offset-2");

                    hiddenInput.value = this.dataset.slot;
                });
            });
        });
    </script>
}

@functions {
    private static string SplitPascal(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return value;

        var result = "";

        for (var i = 0; i < value.Length; i++)
        {
            if (i > 0 && char.IsUpper(value[i]))
                result += " ";

            result += value[i];
        }

        return result;
    }
}