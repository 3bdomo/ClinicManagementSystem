@model ProcedureFormViewModel
@{
    ViewData["Title"] = "Add Medical Procedure";
}
<div class="space-y-6">
    <div>
        <div class="flex items-center gap-2 text-sm font-semibold text-sky-600">
            <span class="material-symbols-outlined text-[20px]">medical_information</span>
            <span>Procedures</span>
            <span class="text-slate-300">/</span>
            <span>Create</span>
        </div>
        <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Add Medical Procedure</h2>
    </div>

    <form asp-action="Create" method="post" class="space-y-6">
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <div class="grid gap-5 md:grid-cols-2">
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="MedicalRecordId">Medical record</label>
                    <select asp-for="MedicalRecordId" asp-items="Model.MedicalRecords"
                            class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600">
                        <option value="">Select medical record...</option>
                    </select>
                    <span asp-validation-for="MedicalRecordId" class="text-xs font-semibold text-red-600 mt-1 block"></span>
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="ProcedureTypeId">Procedure type</label>
                    <select asp-for="ProcedureTypeId" asp-items="Model.AvailableTypes"
                            class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600">
                        <option value="">Select type...</option>
                    </select>
                    <span asp-validation-for="ProcedureTypeId" class="text-xs font-semibold text-red-600 mt-1 block"></span>
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="PerformedAt">Performed at</label>
                    <input asp-for="PerformedAt" type="datetime-local"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="Cost">Cost (EGP)</label>
                    <input asp-for="Cost" type="number" min="0" step="10"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                    <span asp-validation-for="Cost" class="text-xs font-semibold text-red-600 mt-1 block"></span>
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="DurationMinutes">Duration (minutes)</label>
                    <input asp-for="DurationMinutes" type="number" min="1"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                </div>
                <div class="md:col-span-2">
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="Notes">Procedure notes</label>
                    <textarea asp-for="Notes" rows="3" placeholder="What was done during the procedure"
                              class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600"></textarea>
                </div>
                <div class="md:col-span-2">
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="AfterCareNotes">After-care instructions</label>
                    <textarea asp-for="AfterCareNotes" rows="3" placeholder="Instructions for patient after the procedure"
                              class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600"></textarea>
                </div>
            </div>
        </div>

        <div class="flex justify-end gap-3 border-t border-slate-200 pt-5">
            <a asp-action="Details" class="rounded-lg px-5 py-3 text-sm font-bold text-slate-600 hover:bg-slate-100">Cancel</a>
            <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-sky-600 px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-sky-700">
                <span class="material-symbols-outlined text-[18px]">add</span>
                Add procedure
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScripts")
}
