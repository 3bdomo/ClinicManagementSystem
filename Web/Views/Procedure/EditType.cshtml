@model ProcedureTypeFormViewModel
@{
    ViewData["Title"] = "Edit Procedure Type";
}
<div class="space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <div class="flex items-center gap-2 text-sm font-semibold text-sky-600">
                <span class="material-symbols-outlined text-[20px]">edit_note</span>
                <span>Procedure catalog</span>
            </div>
            <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Edit Procedure Type</h2>
        </div>
        <a asp-action="ManageTypes" class="inline-flex items-center gap-2 rounded-lg border border-slate-300 px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            Back to types
        </a>
    </div>

    <form asp-action="EditType" method="post" class="space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <div class="grid gap-5 md:grid-cols-2">
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="Name">Type name</label>
                    <input asp-for="Name" type="text" placeholder="e.g. Wound dressing"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                    <span asp-validation-for="Name" class="mt-1 text-xs text-red-500"></span>
                </div>
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="DefaultCost">Default cost (EGP)</label>
                    <input asp-for="DefaultCost" type="number" step="0.01"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                    <span asp-validation-for="DefaultCost" class="mt-1 text-xs text-red-500"></span>
                </div>
                <div class="md:col-span-2">
                    <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="Description">Description</label>
                    <textarea asp-for="Description" rows="3"
                              class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600"></textarea>
                </div>
                <div class="md:col-span-2">
                    <label class="flex items-center gap-3 text-sm font-semibold text-slate-700 cursor-pointer">
                        <input asp-for="IsActive" type="checkbox"
                               class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-600" />
                        Active type (visible when adding procedures)
                    </label>
                </div>
            </div>
        </div>

        <div class="flex justify-end gap-3 border-t border-slate-200 pt-5">
            <a asp-action="ManageTypes" class="rounded-lg px-5 py-3 text-sm font-bold text-slate-600 hover:bg-slate-100">Cancel</a>
            <button type="submit"
                    class="inline-flex items-center gap-2 rounded-lg bg-sky-600 px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-sky-700">
                <span class="material-symbols-outlined text-[18px]">save</span>
                Save type
            </button>
        </div>
    </form>
</div>
