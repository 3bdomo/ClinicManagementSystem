@model ProcedureDetailsViewModel
@{
    ViewData["Title"] = "Procedure Details";
    var proc = Model.Procedure;
}
<div class="space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div>
            <div class="flex items-center gap-2 text-sm font-semibold text-sky-600">
                <span class="material-symbols-outlined text-[20px]">medical_information</span>
                <span>Procedures</span>
                <span class="text-slate-300">/</span>
                <span>@proc.ProcedureTypeName</span>
            </div>
            <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Procedure Details</h2>
        </div>
        <div class="flex gap-2">
            @if (User.IsInRole("Doctor") || User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@proc.Id"
                   class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-700 shadow-sm hover:bg-slate-50">
                    <span class="material-symbols-outlined text-[16px]">edit</span>
                    Edit
                </a>
            }
            <a asp-controller="MedicalRecord" asp-action="Details" asp-route-id="@proc.MedicalRecordId"
               class="inline-flex items-center gap-2 rounded-lg bg-sky-600 px-4 py-2 text-sm font-bold text-white shadow-sm">
                <span class="material-symbols-outlined text-[16px]">clinical_notes</span>
                View record
            </a>
        </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
        @* Procedure Card *@
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-black">Procedure information</h3>
            <dl class="mt-4 space-y-4 text-sm">
                <div>
                    <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Type</dt>
                    <dd class="mt-0.5 text-base font-black text-slate-900">@proc.ProcedureTypeName</dd>
                </div>
                <div>
                    <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Patient</dt>
                    <dd class="mt-0.5">
                        <a asp-controller="Patient" asp-action="Details" asp-route-id="@proc.PatientId"
                           class="font-semibold text-sky-600 hover:underline">@proc.PatientName</a>
                    </dd>
                </div>
                <div>
                    <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Cost</dt>
                    <dd class="mt-0.5 text-xl font-black text-slate-900">@proc.Cost.ToString("N0") EGP</dd>
                </div>
                <div>
                    <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Performed at</dt>
                    <dd class="mt-0.5 text-slate-700">@proc.PerformedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                </div>
                <div>
                    <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Duration</dt>
                    <dd class="mt-0.5 text-slate-700">@(proc.DurationMinutes.HasValue ? $"{proc.DurationMinutes} minutes" : "Not recorded")</dd>
                </div>
                @if (!string.IsNullOrWhiteSpace(proc.Notes))
                {
                    <div>
                        <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Notes</dt>
                        <dd class="mt-1 rounded-lg bg-slate-50 p-3 text-slate-700 leading-relaxed">@proc.Notes</dd>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(proc.AfterCareNotes))
                {
                    <div>
                        <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">After-care instructions</dt>
                        <dd class="mt-1 rounded-lg bg-amber-50 p-3 text-amber-800 leading-relaxed">@proc.AfterCareNotes</dd>
                    </div>
                }
            </dl>
        </div>

        @* Related Medical Record *@
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-black">Related medical record</h3>
            <dl class="mt-4 space-y-4 text-sm">
                <div>
                    <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Doctor</dt>
                    <dd class="mt-0.5 font-semibold text-slate-900">@Model.MedicalRecord.DoctorName</dd>
                </div>
                <div>
                    <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Visit date</dt>
                    <dd class="mt-0.5 text-slate-700">@Model.MedicalRecord.VisitDate.ToString("yyyy-MM-dd")</dd>
                </div>
                <div>
                    <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Diagnosis</dt>
                    <dd class="mt-1 rounded-lg bg-slate-50 p-3 text-slate-700 leading-relaxed">@Model.MedicalRecord.Diagnosis</dd>
                </div>
                @if (Model.MedicalRecord.FollowUpDate.HasValue)
                {
                    <div>
                        <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Follow-up date</dt>
                        <dd class="mt-0.5 font-semibold text-amber-600">@Model.MedicalRecord.FollowUpDate.Value.ToString("yyyy-MM-dd")</dd>
                    </div>
                }
            </dl>
            <div class="mt-5">
                <a asp-controller="MedicalRecord" asp-action="Details" asp-route-id="@proc.MedicalRecordId"
                   class="inline-flex items-center gap-2 rounded-lg border border-sky-600 px-4 py-2 text-sm font-bold text-sky-600 hover:bg-sky-50">
                    <span class="material-symbols-outlined text-[16px]">open_in_new</span>
                    Open full record
                </a>
            </div>
        </div>
    </div>

    @* Audit Info *@
    <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        <h3 class="text-lg font-black mb-4">Audit information</h3>
        @await Html.PartialAsync("_AuditInfo", Model.AuditInfo)
    </div>
</div>