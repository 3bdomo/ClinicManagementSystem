@model ProcedureTypeListViewModel
@{
    ViewData["Title"] = "Procedure Types & Reports";
}
<div class="space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <div class="flex items-center gap-2 text-sm font-semibold text-sky-600">
                <span class="material-symbols-outlined text-[20px]">analytics</span>
                <span>Procedure catalog</span>
            </div>
            <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Procedure Types &amp; Reports</h2>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="CreateType" class="inline-flex items-center gap-2 rounded-lg bg-sky-600 px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-sky-700">
                <span class="material-symbols-outlined text-[18px]">playlist_add</span>
                Add procedure type
            </a>
        }
    </div>

    @* Stats *@
    <div class="grid gap-4 md:grid-cols-3">
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <span class="material-symbols-outlined text-2xl text-sky-600">medical_information</span>
            <h3 class="mt-3 text-sm font-bold text-slate-500">Today's procedures</h3>
            <p class="mt-1 text-3xl font-black text-slate-900">@Model.TotalProceduresToday</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <span class="material-symbols-outlined text-2xl text-emerald-500">payments</span>
            <h3 class="mt-3 text-sm font-bold text-slate-500">Procedure revenue (today)</h3>
            <p class="mt-1 text-3xl font-black text-slate-900">@Model.TotalRevenueToday.ToString("N0") EGP</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <span class="material-symbols-outlined text-2xl text-sky-600">category</span>
            <h3 class="mt-3 text-sm font-bold text-slate-500">Active procedure types</h3>
            <p class="mt-1 text-3xl font-black text-slate-900">@Model.ActiveTypesCount</p>
        </div>
    </div>

    @* Procedure Types Table *@
    <div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-100 px-6 py-4">
            <h3 class="text-lg font-black">Procedure type catalog</h3>
        </div>
        @if (Model.Types.Any())
        {
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Name</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Description</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Default cost</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Status</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th class="px-4 py-3"></th>
                        }
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var t in Model.Types)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-4 py-4 text-sm font-semibold text-slate-900">@t.Name</td>
                            <td class="px-4 py-4 text-sm text-slate-600 max-w-xs truncate">
                                @(string.IsNullOrWhiteSpace(t.Description) ? "—" : t.Description)
                            </td>
                            <td class="px-4 py-4 text-sm font-bold text-slate-900">@t.DefaultCost.ToString("N0") EGP</td>
                            <td class="px-4 py-4">
                                @if (t.IsActive)
                                {
                                    <span class="inline-flex rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-bold text-emerald-700">Active</span>
                                }
                                else
                                {
                                    <span class="inline-flex rounded-full bg-slate-100 px-2 py-0.5 text-xs font-bold text-slate-500">Inactive</span>
                                }
                            </td>
                            @if (User.IsInRole("Admin"))
                            {
                                <td class="px-4 py-4 text-right">
                                    <a asp-action="EditType" asp-route-id="@t.Id"
                                       class="text-sm font-bold text-sky-600 hover:underline">Edit</a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="p-8 text-center">
                <span class="material-symbols-outlined text-5xl text-slate-300">category</span>
                <p class="mt-3 text-sm font-semibold text-slate-500">No procedure types defined yet.</p>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="CreateType" class="mt-4 inline-flex items-center gap-2 rounded-lg bg-sky-600 px-4 py-2 text-sm font-bold text-white">
                        Add first type
                    </a>
                }
            </div>
        }
    </div>
</div>
