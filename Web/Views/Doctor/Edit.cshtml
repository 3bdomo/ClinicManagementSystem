@model DoctorFormViewModel
@{
    ViewData["Title"] = "Edit Doctor Profile";
}
<div class="space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <div class="flex items-center gap-2 text-sm font-semibold text-sky-600">
                <span class="material-symbols-outlined text-[20px]">edit</span>
                <a asp-action="Index" class="hover:underline">Doctors</a>
                <span class="text-slate-300">/</span>
                <a asp-action="Details" asp-route-id="@Model.Id" class="hover:underline">@Model.FullName</a>
                <span class="text-slate-300">/</span>
                <span>Edit</span>
            </div>
            <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Edit Doctor Profile</h2>
        </div>
    </div>

    <form asp-action="Edit" method="post" class="space-y-6">
        <input type="hidden" asp-for="Id" />
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <div class="mb-5 rounded-lg bg-blue-50 p-4 text-sm font-semibold text-blue-800 flex items-start gap-2">
                <span class="material-symbols-outlined text-[18px] mt-0.5">info</span>
                Edit the doctor's clinical profile, fees, bio, and booking availability.
            </div>
            <div class="grid gap-5 md:grid-cols-2">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2" asp-for="FullName">Full name</label>
                    <input asp-for="FullName" type="text"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                    <span asp-validation-for="FullName" class="text-xs font-semibold text-red-600 mt-1 block"></span>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2" asp-for="Specialization">Specialization</label>
                    <select asp-for="Specialization" asp-items="Html.GetEnumSelectList<Common.Enums.Specialization>()"
                            class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600">
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2" asp-for="ConsultationFee">Consultation fee (EGP)</label>
                    <input asp-for="ConsultationFee" type="number" min="0" step="50"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                    <span asp-validation-for="ConsultationFee" class="text-xs font-semibold text-red-600 mt-1 block"></span>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2" asp-for="Phone">Phone number</label>
                    <input asp-for="Phone" type="tel"
                           class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                </div>
                <div class="flex items-center gap-3 self-end pb-1">
                    <input asp-for="IsAvailable" type="checkbox"
                           class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-600" />
                    <label asp-for="IsAvailable" class="text-sm font-semibold text-slate-700">Available for booking</label>
                </div>
                <div class="md:col-span-2">
                    <label class="block text-sm font-semibold text-slate-700 mb-2" asp-for="Bio">Bio</label>
                    <textarea asp-for="Bio" rows="4" placeholder="Doctor profile and expertise"
                              class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600"></textarea>
                </div>
            </div>
        </div>

        <div class="flex justify-end gap-3 border-t border-slate-200 pt-5">
            <a asp-action="Details" asp-route-id="@Model.Id"
               class="rounded-lg px-5 py-3 text-sm font-bold text-slate-600 hover:bg-slate-100">Cancel</a>
            <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-sky-600 px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-sky-700">
                <span class="material-symbols-outlined text-[18px]">save</span>
                Save changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScripts")
}
