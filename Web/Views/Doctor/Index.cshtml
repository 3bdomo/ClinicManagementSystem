@model DoctorListViewModel
@{
    ViewData["Title"] = "Doctors";
}
<div class="space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <div class="flex items-center gap-2 text-sm font-semibold text-sky-600">
                <span class="material-symbols-outlined text-[20px]">stethoscope</span>
                <span>Doctors</span>
            </div>
            <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Doctors</h2>
            <p class="mt-1 text-sm text-slate-500">@Model.Doctors.Count() registered doctor(s)</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="User" asp-action="Create"
               class="inline-flex items-center gap-2 rounded-lg bg-sky-600 px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-sky-700">
                <span class="material-symbols-outlined text-[18px]">person_add</span>
                Add doctor
            </a>
        }
    </div>

    <form method="get" asp-action="Index" class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
        <div class="flex gap-4 items-end">
            <div class="flex-1">
                <label class="mb-2 block text-sm font-semibold text-slate-700" for="SearchQuery">Search doctors</label>
                <input id="SearchQuery" name="SearchQuery" value="@Model.SearchQuery" type="search"
                       placeholder="Doctor name or specialization"
                       class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
            </div>
            <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-slate-950 px-5 py-3 text-sm font-bold text-white hover:bg-slate-800">
                <span class="material-symbols-outlined text-[18px]">search</span>
                Search
            </button>
        </div>
    </form>

    @if (Model.Doctors.Any())
    {
        <div class="grid gap-5 xl:grid-cols-2">
            @foreach (var doc in Model.Doctors)
            {
                <article class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md transition-shadow">
                    <div class="flex items-start justify-between gap-4">
                        <div class="flex items-center gap-4">
                            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-sky-100 text-xl font-black text-sky-600">
                                @doc.FullName.FirstOrDefault()
                            </div>
                            <div>
                                <h3 class="text-lg font-black text-slate-950">@doc.FullName</h3>
                                <p class="text-sm font-semibold text-sky-600">@doc.Specialization</p>
                            </div>
                        </div>
                        @if (doc.IsAvailable)
                        {
                            <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">Available</span>
                        }
                        else
                        {
                            <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-600">Unavailable</span>
                        }
                    </div>
                    <dl class="mt-5 grid gap-4 sm:grid-cols-2">
                        @if (!string.IsNullOrWhiteSpace(doc.Phone))
                        {
                            <div>
                                <dt class="text-xs font-black uppercase text-slate-500">Phone</dt>
                                <dd class="mt-1 text-sm text-slate-700">@doc.Phone</dd>
                            </div>
                        }
                        <div>
                            <dt class="text-xs font-black uppercase text-slate-500">Consultation fee</dt>
                            <dd class="mt-1 text-sm font-bold text-slate-900">@doc.ConsultationFee.ToString("N0") EGP</dd>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(doc.Bio))
                        {
                            <div class="sm:col-span-2">
                                <dt class="text-xs font-black uppercase text-slate-500">Bio</dt>
                                <dd class="mt-1 text-sm text-slate-600 line-clamp-2">@doc.Bio</dd>
                            </div>
                        }
                    </dl>
                    <div class="mt-5 flex justify-end gap-2">
                        <a asp-action="Details" asp-route-id="@doc.Id"
                           class="rounded-lg px-4 py-2 text-sm font-bold text-sky-600 hover:bg-sky-50">
                            Details
                        </a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@doc.Id"
                               class="rounded-lg px-4 py-2 text-sm font-bold text-slate-600 hover:bg-slate-100">
                                Edit
                            </a>
                        }
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="rounded-lg border border-slate-200 bg-white p-10 text-center shadow-sm">
            <span class="material-symbols-outlined text-5xl text-slate-300">stethoscope</span>
            <p class="mt-3 text-sm font-semibold text-slate-500">
                @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                {
                    <text>No doctors found for "@Model.SearchQuery".</text>
                }
                else
                {
                    <text>No doctors registered yet.</text>
                }
            </p>
        </div>
    }
</div>
