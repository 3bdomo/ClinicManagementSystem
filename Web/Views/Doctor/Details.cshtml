@model DoctorDetailsViewModel
@{
    ViewData["Title"] = "Doctor Details";
    var doc = Model?.Doctor ?? new DoctorFormViewModel();
    var schedules = Model?.Schedules ?? Enumerable.Empty<DoctorScheduleFormViewModel>();
    var todayAppointments = Model?.TodayAppointments ?? Enumerable.Empty<AppointmentRowViewModel>();
}
<div class="space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div>
            <div class="flex items-center gap-2 text-sm font-semibold text-sky-600">
                <span class="material-symbols-outlined text-[20px]">stethoscope</span>
                <a asp-action="Index" class="hover:underline">Doctors</a>
                <span class="text-slate-300">/</span>
                <span>@doc.FullName</span>
            </div>
            <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">@doc.FullName</h2>
            <p class="mt-1 text-sm font-semibold text-sky-600">@doc.Specialization</p>
        </div>
        <div class="flex flex-wrap gap-2">
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@doc.Id"
                   class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-700 shadow-sm hover:bg-slate-50">
                    <span class="material-symbols-outlined text-[16px]">edit</span>
                    Edit profile
                </a>
                <a asp-controller="DoctorSchedule" asp-action="Create"
                   class="inline-flex items-center gap-2 rounded-lg bg-sky-600 px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-sky-700">
                    <span class="material-symbols-outlined text-[16px]">calendar_add_on</span>
                    Add schedule
                </a>
            }
        </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
        @* Doctor Profile Card *@
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-4 border-b border-slate-100 pb-4">
                <div class="flex h-14 w-14 items-center justify-center rounded-full bg-sky-100 text-2xl font-black text-sky-600">
                    @doc.FullName?.FirstOrDefault()
                </div>
                <div>
                    <h3 class="text-base font-black text-slate-950">@doc.FullName</h3>
                    @if (doc.IsAvailable)
                    {
                        <span class="inline-flex rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-bold text-emerald-700">
                            Available
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex rounded-full bg-slate-100 px-2 py-0.5 text-xs font-bold text-slate-500">
                            Unavailable
                        </span>
                    }
                </div>
            </div>
            <dl class="mt-4 space-y-3 text-sm">
                <div>
                    <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Specialization</dt>
                    <dd class="mt-0.5 font-semibold text-sky-600">@doc.Specialization</dd>
                </div>
                <div>
                    <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Consultation fee</dt>
                    <dd class="mt-0.5 text-xl font-black text-slate-900">@doc.ConsultationFee.ToString("N0") EGP</dd>
                </div>
                @if (!string.IsNullOrWhiteSpace(doc.Phone))
                {
                    <div>
                        <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Phone</dt>
                        <dd class="mt-0.5 font-semibold text-slate-700">@doc.Phone</dd>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(doc.Bio))
                {
                    <div>
                        <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Bio</dt>
                        <dd class="mt-0.5 text-slate-600 leading-relaxed">@doc.Bio</dd>
                    </div>
                }
            </dl>
        </div>

        @* Stats *@
        <div class="lg:col-span-2 grid gap-4 sm:grid-cols-3 content-start">
            <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm text-center">
                <span class="material-symbols-outlined text-2xl text-sky-600">event</span>
                <p class="mt-2 text-2xl font-black">@todayAppointments.Count()</p>
                <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Today's Appointments</p>
            </div>
            <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm text-center">
                <span class="material-symbols-outlined text-2xl text-sky-600">calendar_month</span>
                <p class="mt-2 text-2xl font-black">@schedules.Count(s => s.IsActive)</p>
                <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Active Schedules</p>
            </div>
            <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm text-center">
                <span class="material-symbols-outlined text-2xl text-sky-600">history</span>
                <p class="mt-2 text-2xl font-black">@Model.TotalAppointmentsCount</p>
                <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Total Appointments</p>
            </div>
        </div>
    </div>

    @* Schedules Table *@
    <div class="rounded-lg border border-slate-200 bg-white shadow-sm">
        <div class="flex items-center justify-between border-b border-slate-100 px-6 py-4">
            <h3 class="text-lg font-black">Work Schedules</h3>
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="DoctorSchedule" asp-action="Create"
                   class="inline-flex items-center gap-2 rounded-lg bg-sky-600 px-3 py-1.5 text-xs font-bold text-white">
                    <span class="material-symbols-outlined text-[14px]">add</span>
                    Add schedule
                </a>
            }
        </div>
        @if (schedules.Any())
        {
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Type</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Day / Date</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Time</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Slot</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Status</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th class="px-4 py-3"></th>
                        }
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var s in schedules)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-4 py-4 text-sm font-semibold text-slate-900">@s.ScheduleType</td>
                            <td class="px-4 py-4 text-sm text-slate-700">
                                @if (s.DayOfWeek.HasValue)
                                {
                                    @s.DayOfWeek.Value.ToString()
                                }
                                else if (s.SpecificDate.HasValue)
                                {
                                    @s.SpecificDate.Value.ToString("yyyy-MM-dd")
                                }
                                else
                                {
                                    <span class="text-slate-400">—</span>
                                }
                            </td>
                            <td class="px-4 py-4 text-sm text-slate-700">@s.StartTime.ToString("HH:mm") – @s.EndTime.ToString("HH:mm")</td>
                            <td class="px-4 py-4 text-sm text-slate-600">@s.SlotMinutes min</td>
                            <td class="px-4 py-4">
                                @if (s.IsActive)
                                {
                                    <span class="inline-flex rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-bold text-emerald-700">Active</span>
                                }
                                else
                                {
                                    <span class="inline-flex rounded-full bg-slate-100 px-2 py-0.5 text-xs font-bold text-slate-500">Inactive</span>
                                }
                            </td>
                            @if (User.IsInRole("Admin"))
                            {
                                <td class="px-4 py-4 text-right">
                                    <a asp-controller="DoctorSchedule" asp-action="Edit" asp-route-id="@s.Id"
                                       class="text-sm font-bold text-sky-600 hover:underline">Edit</a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="p-8 text-center text-sm text-slate-500">No schedules assigned to this doctor yet.</div>
        }
    </div>

    @* Today's Appointments *@
    @if (todayAppointments.Any())
    {
        <div class="rounded-lg border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-100 px-6 py-4">
                <h3 class="text-lg font-black">Today's Appointments</h3>
            </div>
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Patient</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Time</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Type</th>
                        <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-wider text-slate-500">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var a in todayAppointments)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-4 py-4">
                                <a asp-controller="Patient" asp-action="Details" asp-route-id="@a.PatientId"
                                   class="text-sm font-semibold text-slate-900 hover:text-sky-600">
                                    @a.PatientName
                                </a>
                            </td>
                            <td class="px-4 py-4 text-sm text-slate-700">@a.AppointmentDate.ToString("HH:mm")</td>
                            <td class="px-4 py-4 text-sm text-slate-600">@a.AppointmentType</td>
                            <td class="px-4 py-4">
                                <span class="inline-flex rounded-full px-2 py-0.5 text-xs font-bold
                                            @(a.Status == Common.Enums.AppointmentStatus.Completed ? "bg-emerald-50 text-emerald-700" :
                                                                            a.Status == Common.Enums.AppointmentStatus.InProgress ? "bg-blue-50 text-blue-700" :
                                                                            "bg-amber-50 text-amber-700")">
                                    @a.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>