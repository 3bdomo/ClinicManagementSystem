@model Web.ViewModels.Receptionist.ReceptionistFormViewModel
@{
    ViewData["Title"] = "Edit Receptionist";
}

@* Breadcrumb *@
<nav class="flex items-center gap-2 text-sm mb-6">
    <a asp-action="Index" class="text-blue-600 font-semibold hover:underline">
        Receptionists
    </a>
    <span class="text-slate-300 material-symbols-outlined text-[16px]">chevron_right</span>
    <a asp-action="Details" asp-route-id="@Model.Id"
       class="text-blue-600 font-semibold hover:underline">
        @Model.FullName
    </a>
    <span class="text-slate-300 material-symbols-outlined text-[16px]">chevron_right</span>
    <span class="text-slate-500">Edit</span>
</nav>

<div class="max-w-xl">
    <p class="text-slate-500 text-sm mb-6">
        Updating profile for <strong class="text-slate-900">@Model.FullName</strong>
    </p>

    <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">

        @* Card header *@
        <div class="px-6 py-4 border-b border-slate-100 flex items-center gap-2">
            <span class="material-symbols-outlined text-blue-600">person_edit</span>
            <span class="font-bold text-slate-900">Personal Information</span>
        </div>

        <div class="p-6">

            @* Email-change notice *@
            <div class="flex gap-3 items-start bg-amber-50 border border-amber-200
                        rounded-xl p-4 mb-6 text-sm text-amber-800">
                <span class="material-symbols-outlined text-amber-500 flex-shrink-0
                             text-[20px] mt-0.5">
                    info
                </span>
                <span>
                    Email address cannot be changed here. Use
                    <a asp-controller="User" asp-action="Index"
                       class="font-bold underline">User Management</a>
                    to update it.
                </span>
            </div>

            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                @* Full Name *@
                <div class="mb-5">
                    <label asp-for="FullName"
                           class="block text-xs font-black uppercase tracking-wider
                                  text-slate-500 mb-1.5">
                    </label>
                    <input asp-for="FullName"
                           class="w-full px-4 py-2.5 rounded-xl border border-slate-200
                                  text-sm text-slate-900 bg-white
                                  focus:outline-none focus:ring-2 focus:ring-blue-500
                                  focus:border-transparent transition"
                           placeholder="e.g. Sara Ahmed"
                           maxlength="100"
                           autocomplete="name" />
                    <span asp-validation-for="FullName"
                          class="text-xs text-red-600 mt-1 block"></span>
                </div>

                @* Email — display only, NOT inside asp-for so it won't post *@
                <div class="mb-5">
                    <label asp-for="Email"
                           class="block text-xs font-black uppercase tracking-wider
                                  text-slate-500 mb-1.5">
                    </label>
                    <input value="@Model.Email" type="email" readonly tabindex="-1"
                           class="w-full px-4 py-2.5 rounded-xl border border-slate-100
                                  text-sm text-slate-400 bg-slate-50 cursor-not-allowed" />
                    <p class="text-xs text-slate-400 mt-1">Read-only — managed via User Management.</p>
                </div>

                @* Phone *@
                <div class="mb-5">
                    <label asp-for="PhoneNumber"
                           class="block text-xs font-black uppercase tracking-wider
                                  text-slate-500 mb-1.5">
                    </label>
                    <input asp-for="PhoneNumber"
                           class="w-full px-4 py-2.5 rounded-xl border border-slate-200
                                  text-sm text-slate-900 bg-white
                                  focus:outline-none focus:ring-2 focus:ring-blue-500
                                  focus:border-transparent transition"
                           placeholder="e.g. +20 100 123 4567"
                           maxlength="20"
                           inputmode="tel" />
                    <span asp-validation-for="PhoneNumber"
                          class="text-xs text-red-600 mt-1 block"></span>
                </div>

                @* IsActive toggle *@
                <div class="flex items-center justify-between bg-slate-50 border
                            border-slate-200 rounded-xl px-4 py-3 mb-6">
                    <div>
                        <p class="text-sm font-bold text-slate-900">Active Account</p>
                        <p class="text-xs text-slate-400 mt-0.5">
                            Inactive accounts cannot log in to the system.
                        </p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer ml-4">
                        <input asp-for="IsActive" type="checkbox" class="sr-only peer" />
                        <div class="w-11 h-6 bg-slate-200 rounded-full peer
                                    peer-checked:bg-blue-600 peer-focus:ring-2
                                    peer-focus:ring-blue-300 transition-colors
                                    after:content-[''] after:absolute after:top-[2px]
                                    after:left-[2px] after:bg-white after:rounded-full
                                    after:h-5 after:w-5 after:transition-all
                                    peer-checked:after:translate-x-5">
                        </div>
                    </label>
                </div>

                @* Footer *@
                <div class="flex items-center justify-between pt-2">
                    <a asp-action="Details" asp-route-id="@Model.Id"
                       class="px-5 py-2.5 rounded-xl border border-slate-200
                              text-slate-600 text-sm font-semibold
                              hover:bg-slate-50 transition-colors">
                        Cancel
                    </a>
                    <button type="submit"
                            class="inline-flex items-center gap-2 px-5 py-2.5
                                   rounded-xl bg-blue-600 text-white text-sm font-bold
                                   hover:bg-blue-700 transition-colors">
                        <span class="material-symbols-outlined text-[18px]">check</span>
                        Save Changes
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}