@model RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Patient Registration";
}
<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Patient Registration - ClinicSystem</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-slate-50 text-slate-900" style="font-family:Inter,sans-serif">
    <main class="min-h-screen p-6 lg:p-10">
        <div class="mx-auto max-w-6xl">
            <div class="mb-8 flex items-center justify-between">
                <div>
                    <a asp-action="Login" class="inline-flex items-center gap-2 text-sm font-bold text-sky-600">
                        <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                        Back to Login
                    </a>
                    <h1 class="mt-3 text-4xl font-black">Patient registration</h1>
                    <p class="mt-2 text-slate-600">Create your portal account and link it to your patient file by National ID.</p>
                </div>
                <span class="material-symbols-outlined rounded-lg bg-sky-600 p-4 text-4xl text-white">person_add</span>
            </div>
            
            <form asp-action="Register" method="post" class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
                @Html.AntiForgeryToken()
                
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="mb-6 rounded-lg bg-red-50 p-4 text-sm text-red-600">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <div class="grid gap-5 md:grid-cols-2">
                    <div>
                        <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="FullName">Full name</label>
                        <input asp-for="FullName" class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                        <span asp-validation-for="FullName" class="text-xs text-red-500"></span>
                    </div>
                    <div>
                        <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="Email">Email</label>
                        <input asp-for="Email" class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                        <span asp-validation-for="Email" class="text-xs text-red-500"></span>
                    </div>
                    <div>
                        <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="Password">Password</label>
                        <input asp-for="Password" class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                        <span asp-validation-for="Password" class="text-xs text-red-500"></span>
                    </div>
                    <div>
                        <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="ConfirmPassword">Confirm password</label>
                        <input asp-for="ConfirmPassword" class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                        <span asp-validation-for="ConfirmPassword" class="text-xs text-red-500"></span>
                    </div>
                    <div>
                        <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="NationalId">National ID</label>
                        <input asp-for="NationalId" class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" placeholder="14 digits" />
                        <span asp-validation-for="NationalId" class="text-xs text-red-500"></span>
                    </div>
                    <div>
                        <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="Phone">Phone</label>
                        <input asp-for="Phone" class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                        <span asp-validation-for="Phone" class="text-xs text-red-500"></span>
                    </div>
                    <div>
                        <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="DateOfBirth">Date of birth</label>
                        <input asp-for="DateOfBirth" class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                        <span asp-validation-for="DateOfBirth" class="text-xs text-red-500"></span>
                    </div>
                    <div>
                        <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="Gender">Gender</label>
                        <select asp-for="Gender" class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" asp-items="Html.GetEnumSelectList<Common.Enums.Gender>()"></select>
                    </div>
                    <div>
                        <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="BloodType">Blood type (Optional)</label>
                        <select asp-for="BloodType" class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" asp-items="ViewBag.BloodTypes">
                            <option value="">Select Blood Type...</option>
                        </select>
                    </div>
                    <div>
                        <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="EmergencyContact">Emergency contact (Optional)</label>
                        <input asp-for="EmergencyContact" class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600" />
                    </div>
                    <div class="md:col-span-2">
                        <label class="mb-2 block text-sm font-semibold text-slate-700" asp-for="Address">Address (Optional)</label>
                        <textarea asp-for="Address" rows="3" class="w-full rounded-lg border-slate-300 focus:border-sky-600 focus:ring-sky-600"></textarea>
                    </div>
                </div>
                <div class="mt-6 flex justify-end gap-3 border-t border-slate-200 pt-5">
                    <a asp-action="Login" class="rounded-lg px-5 py-3 text-sm font-bold text-slate-600 hover:bg-slate-100">Cancel</a>
                    <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-sky-600 px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-sky-700">
                        <span class="material-symbols-outlined text-[18px]">person_add</span>
                        Create Account
                    </button>
                </div>
            </form>
        </div>
    </main>
</body>
</html>
