@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Admin Access";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Access Control</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Inter:wght@400;600;700;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        :root { color-scheme: dark; }
        body { font-family: 'Inter', sans-serif; background: #09090b; }
        .mono { font-family: 'JetBrains Mono', monospace; }

        .scanline {
            position: fixed; inset: 0; pointer-events: none; z-index: 1;
            background: repeating-linear-gradient(
                0deg,
                transparent,
                transparent 2px,
                rgba(0,0,0,0.03) 2px,
                rgba(0,0,0,0.03) 4px
            );
        }

        .terminal-border {
            border: 1px solid rgba(255,255,255,0.06);
            box-shadow:
                0 0 0 1px rgba(255,255,255,0.03),
                0 24px 80px rgba(0,0,0,0.7),
                inset 0 1px 0 rgba(255,255,255,0.05);
        }

        .input-dark {
            background: rgba(255,255,255,0.03) !important;
            border-color: rgba(255,255,255,0.07) !important;
            color: #e2e8f0 !important;
            font-family: 'JetBrains Mono', monospace;
            letter-spacing: 0.02em;
            transition: all 0.2s;
        }
        .input-dark::placeholder { color: #27272a !important; }
        .input-dark:focus {
            background: rgba(255,255,255,0.05) !important;
            border-color: rgba(255,255,255,0.15) !important;
            box-shadow: 0 0 0 3px rgba(255,255,255,0.04) !important;
            outline: none !important;
        }

        .submit-admin {
            background: #18181b;
            border: 1px solid rgba(255,255,255,0.10);
            transition: all 0.2s;
        }
        .submit-admin:hover {
            background: #27272a;
            border-color: rgba(255,255,255,0.18);
            box-shadow: 0 0 20px rgba(255,255,255,0.04);
        }

        .warning-stripe {
            background: repeating-linear-gradient(
                45deg,
                transparent,
                transparent 8px,
                rgba(234,179,8,0.06) 8px,
                rgba(234,179,8,0.06) 16px
            );
        }

        @@keyframes blink {
            0%, 100% { opacity: 1; }
            50%  { opacity: 0; }
        }
        .cursor-blink { animation: blink 1.1s step-end infinite; }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(16px) scale(0.98); }
            to   { opacity: 1; transform: translateY(0) scale(1); }
        }
        .fade-in { animation: fadeIn 0.5s ease both; }

        @@keyframes typewrite {
            from { width: 0; }
            to   { width: 100%; }
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-6">
    <div class="scanline"></div>

    @* Subtle grid *@
    <div class="fixed inset-0 pointer-events-none" style="background-image: linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px), linear-gradient(90deg,rgba(255,255,255,0.015) 1px,transparent 1px); background-size: 64px 64px;"></div>

    @* Single glow *@
    <div class="fixed pointer-events-none" style="width:400px;height:400px;top:50%;left:50%;transform:translate(-50%,-50%);background:radial-gradient(circle,rgba(255,255,255,0.025) 0%,transparent 70%);border-radius:50%;"></div>

    <div class="relative z-10 w-full max-w-sm fade-in">

        @* Top status bar *@
        <div class="mb-6 flex items-center justify-between">
            <span class="mono text-[11px] text-zinc-700">CLINICSYS :: ADMIN PORTAL</span>
            <span class="mono text-[11px] text-zinc-700 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-zinc-700"></span>
                RESTRICTED
            </span>
        </div>

        <div class="terminal-border rounded-2xl overflow-hidden">

            @* Warning header *@
            <div class="warning-stripe border-b border-white/5 px-6 py-4">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-amber-500/80 text-xl">admin_panel_settings</span>
                    <div>
                        <p class="text-xs font-black uppercase tracking-widest text-amber-500/80">Restricted access</p>
                        <p class="text-[10px] text-zinc-600 mono mt-0.5">Authorized personnel only</p>
                    </div>
                </div>
            </div>

            @* Form body *@
            <div class="bg-zinc-950/80 px-6 py-8">

                @* Terminal header *@
                <div class="mb-8">
                    <div class="mono text-zinc-600 text-[11px] mb-3">
                        <span class="text-zinc-500">$</span>
                        <span class="ml-2 text-zinc-400">authenticate --role=admin</span>
                        <span class="cursor-blink ml-1 text-zinc-400">▌</span>
                    </div>
                    <h1 class="text-xl font-black text-white tracking-tight">System Administrator</h1>
                    <p class="text-xs text-zinc-600 mt-1">Enter your credentials to access the admin panel.</p>
                </div>

                @* Error message *@
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="mb-5 rounded-lg border border-red-900/50 bg-red-950/30 px-4 py-3">
                        <p class="text-xs mono text-red-400">
                            <span class="text-red-600">ERR</span> Authentication failed — invalid credentials.
                        </p>
                    </div>
                }

                <form asp-action="Login" asp-controller="Account" method="post" class="space-y-5">
                    @Html.AntiForgeryToken()

                    <div>
                        <label class="mb-2 block text-[11px] font-black uppercase tracking-widest text-zinc-600" asp-for="Email">
                            Identifier
                        </label>
                        <input asp-for="Email" type="email"
                               placeholder="admin@clinic.com"
                               autocomplete="username"
                               class="input-dark w-full rounded-lg border px-4 py-3 text-sm focus:outline-none" />
                        <span asp-validation-for="Email" class="mt-1 block text-[11px] text-red-500 mono"></span>
                    </div>

                    <div>
                        <label class="mb-2 block text-[11px] font-black uppercase tracking-widest text-zinc-600" asp-for="Password">
                            Passphrase
                        </label>
                        <div class="relative">
                            <input asp-for="Password" type="password" id="adminPass"
                                   placeholder="••••••••••••"
                                   autocomplete="current-password"
                                   class="input-dark w-full rounded-lg border px-4 pr-11 py-3 text-sm focus:outline-none" />
                            <button type="button" onclick="toggleAdminPass()"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-zinc-700 hover:text-zinc-500 transition-colors">
                                <span id="adminEye" class="material-symbols-outlined text-[18px]">visibility</span>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="mt-1 block text-[11px] text-red-500 mono"></span>
                    </div>

                    <input asp-for="RememberMe" type="hidden" value="false" />

                    <button type="submit"
                            class="submit-admin w-full flex items-center justify-center gap-2 rounded-lg py-3.5 text-sm font-bold text-zinc-300 mt-2">
                        <span class="material-symbols-outlined text-[18px] text-zinc-500">lock_open</span>
                        Authenticate
                    </button>
                </form>

                @* Bottom mono footer *@
                <div class="mt-8 pt-5 border-t border-white/5">
                    <p class="mono text-[10px] text-zinc-800 text-center">
                        SESSION :: ENCRYPTED · LOGGED · MONITORED
                    </p>
                </div>
            </div>
        </div>

        @* Bottom bar *@
        <div class="mt-5 flex items-center justify-between">
            <span class="mono text-[10px] text-zinc-800">v2.0.0-admin</span>
            <span class="mono text-[10px] text-zinc-800">@DateTime.Now.ToString("yyyy-MM-dd HH:mm")</span>
        </div>
    </div>

    <script>
        function toggleAdminPass() {
            const pass = document.getElementById('adminPass');
            const eye  = document.getElementById('adminEye');
            pass.type  = pass.type === 'password' ? 'text' : 'password';
            eye.textContent = pass.type === 'password' ? 'visibility' : 'visibility_off';
        }

        // Security: clear URL from browser history after load (no referrer)
        if (window.history && window.history.replaceState) {
            window.history.replaceState(null, '', window.location.pathname);
        }

        // Disable right-click (basic deterrent)
        document.addEventListener('contextmenu', e => e.preventDefault());
    </script>
</body>
</html>
