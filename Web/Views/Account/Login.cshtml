<link href="/css/site.css" rel="stylesheet"/><link href="/css/dashboard.css" rel="stylesheet"/></head>
<body class="bg-background text-on-background min-h-screen flex items-center justify-center p-md login-gradient"><input id="CurrentMvcView" type="hidden" value="Views/Account/Login.cshtml"/>
<div class="w-full max-w-md">
<!-- Logo Branding Header (Outside card for impact) -->
<div class="flex flex-col items-center mb-xl">
<div class="bg-white/10 backdrop-blur-md p-md rounded-xl mb-md">
<span class="material-symbols-outlined text-white text-[48px]" data-icon="medical_services">medical_services</span>
</div>
<h1 class="font-h1 text-h1 text-white tracking-tighter">ClinicSystem</h1>
<p class="font-body-md text-body-md text-blue-100/80 mt-xs">Professional Medical Management</p>
</div>
<!-- Main Login Card -->
<div class="bg-white rounded-xl shadow-2xl p-xl border border-white/10 overflow-hidden relative">
<!-- Subtle Background Texture -->
<div class="absolute top-0 right-0 p-lg opacity-[0.03] pointer-events-none">
<span class="material-symbols-outlined text-[120px]" data-icon="health_and_safety">health_and_safety</span>
</div>
<div class="relative z-10">
<div class="mb-lg">
<h2 class="font-h2 text-h2 text-on-background">Sign In</h2>
<p class="font-body-md text-body-md text-outline">Enter your credentials to access your dashboard</p>
</div>
<form class="space-y-lg" onsubmit="return false;">
<!-- Email Input -->
<div class="space-y-xs">
<label class="font-label-md text-label-md text-on-surface" for="email">Email Address</label>
<div class="relative">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]" data-icon="mail">mail</span>
<input class="w-full pl-10 pr-md py-3 rounded-lg border border-outline-variant bg-surface-container-lowest focus:ring-2 focus:ring-primary focus:border-primary transition-all font-body-md text-body-md outline-none" id="email" name="email" placeholder="doctor&#64;clinicsystem.com" type="email"/>
</div>
</div>
<!-- Password Input -->
<div class="space-y-xs">
<div class="flex justify-between items-center">
<label class="font-label-md text-label-md text-on-surface" for="password">Password</label>
<a class="font-label-sm text-label-sm text-primary hover:underline" href="#">Forgot password?</a>
</div>
<div class="relative">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]" data-icon="lock">lock</span>
<input class="w-full pl-10 pr-md py-3 rounded-lg border border-outline-variant bg-surface-container-lowest focus:ring-2 focus:ring-primary focus:border-primary transition-all font-body-md text-body-md outline-none" id="password" name="password" placeholder="••••••••" type="password"/>
<button class="absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-on-surface-variant" type="button">
<span class="material-symbols-outlined text-[20px]" data-icon="visibility">visibility</span>
</button>
</div>
</div>
<!-- Remember Me -->
<div class="flex items-center space-x-xs">
<input class="w-4 h-4 rounded border-outline-variant text-primary focus:ring-primary" id="remember" type="checkbox"/>
<label class="font-body-sm text-body-sm text-on-surface-variant select-none" for="remember">Keep me signed in for 30 days</label>
</div>
<!-- Sign In Button -->
<button class="w-full bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md py-4 rounded-lg shadow-lg shadow-primary/20 transition-all active:scale-[0.98] flex items-center justify-center space-x-xs" type="submit">
<span>Sign In</span>
<span class="material-symbols-outlined text-[18px]" data-icon="arrow_forward">arrow_forward</span>
</button>
</form>
<div class="mt-xl pt-lg border-t border-surface-variant text-center">
<p class="font-body-md text-body-md text-on-surface-variant mb-sm">New to our clinic?</p>
<a class="inline-flex items-center space-x-xs font-label-md text-label-md text-primary hover:text-primary-container transition-colors" href="#">
<span>Register as Patient</span>
<span class="material-symbols-outlined text-[18px]" data-icon="person_add">person_add</span>
</a>
</div>
</div>
</div>
<!-- Footer Links -->
<div class="mt-lg flex justify-center space-x-lg">
<a class="font-body-sm text-body-sm text-blue-200/60 hover:text-white transition-colors" href="#">Privacy Policy</a>
<span class="text-blue-200/20">•</span>
<a class="font-body-sm text-body-sm text-blue-200/60 hover:text-white transition-colors" href="#">Terms of Service</a>
<span class="text-blue-200/20">•</span>
<a class="font-body-sm text-body-sm text-blue-200/60 hover:text-white transition-colors" href="#">Contact Support</a>
</div>
</div>
<!-- Background Decorative Image (Subtle) -->
<div class="fixed inset-0 z-[-1] opacity-10 pointer-events-none">
<img class="w-full h-full object-cover" data-alt="A clean, professional medical facility hallway with soft, high-key lighting. The scene is rendered in a minimalist, corporate modern style with blue and white tones. The atmosphere is calm and sterile, reflecting medical precision and reliability, perfectly aligned with a professional healthcare management system interface." src="https://lh3.googleusercontent.com/aida-public/AB6AXuAc6qoZPYr1DPg56NPWdQ2Tq718rJ97Bt_Lk6rIcoDOldkZvloYIyMhiVOSpoZmUFANVPh1csHwdaDbyhGE-oxyYTAK0dnucb2UuC6RIlKUNW2o20rfMJduz4fDhQb0nRC5oC_DzyEDiI-26sihkskZhZ-GHxWLI2pD6PYqm2Gzjgi7mChU6LMpRDcpTZ6CrTeN3btgjtCk-WJ3A9SAkl72BvQbOTdKM0aYPbf7uF4tYK3_XTO7lrhNiOBbtHgQ-skYzTTXozXmPwo"/>
</div>
<script src="/js/site.js"></script><script src="/js/schedule-form.js"></script><script src="/js/slot-picker.js"></script><script src="/js/invoice-builder.js"></script><script src="/js/appointment-calendar.js"></script></body></html>
