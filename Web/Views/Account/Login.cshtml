@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Patient Login";
}
<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="ClinicSystem — Patient Portal Login." />
    <title>Patient Portal – ClinicSystem</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        body { font-family: 'Outfit', sans-serif; background-color: #f8fafc; }
        
        .blob-bg {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            z-index: -1; overflow: hidden;
            background: linear-gradient(135deg, #f0fdf4 0%, #e0f2fe 100%);
        }

        .blob {
            position: absolute;
            filter: blur(80px);
            opacity: 0.6;
            animation: moveBlob 20s infinite alternate cubic-bezier(0.4, 0, 0.2, 1);
        }

        @@keyframes moveBlob {
            0% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(50px, -50px) scale(1.1); }
            100% { transform: translate(-30px, 40px) scale(0.9); }
        }

        .glass-panel {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.6);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.05), 0 0 0 1px rgba(255, 255, 255, 0.5) inset;
        }

        .input-field {
            background-color: rgba(255,255,255,0.9) !important;
            border: 1px solid #e2e8f0 !important;
            color: #334155 !important;
            transition: all 0.2s ease;
        }
        .input-field:focus {
            background-color: #ffffff !important;
            border-color: #0ea5e9 !important;
            box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.1) !important;
        }

        .btn-primary {
            background: linear-gradient(135deg, #0ea5e9, #0284c7);
            box-shadow: 0 4px 14px rgba(14, 165, 233, 0.3);
            transition: all 0.3s ease;
        }
        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(14, 165, 233, 0.4);
            background: linear-gradient(135deg, #0284c7, #0369a1);
        }

        .feature-card {
            background: rgba(255,255,255,0.6);
            border: 1px solid rgba(255,255,255,0.8);
            border-radius: 20px;
            padding: 1.5rem;
            transition: transform 0.3s ease;
        }
        .feature-card:hover {
            transform: translateY(-5px);
            background: rgba(255,255,255,0.9);
        }
    </style>
</head>
<body class="min-h-screen text-slate-800 antialiased selection:bg-sky-100 selection:text-sky-900">

    @* Friendly background *@
    <div class="blob-bg">
        <div class="blob bg-sky-300 w-[600px] h-[600px] rounded-full top-[-10%] left-[-10%]"></div>
        <div class="blob bg-emerald-200 w-[500px] h-[500px] rounded-full bottom-[-10%] right-[-5%] animation-delay-2000"></div>
        <div class="blob bg-teal-200 w-[400px] h-[400px] rounded-full top-[30%] left-[40%] animation-delay-4000 opacity-40"></div>
    </div>

    <div class="min-h-screen flex flex-col md:flex-row">
        
        @* Left Side - Welcome Info *@
        <div class="hidden md:flex flex-col justify-center p-12 lg:p-20 w-full md:w-5/12 lg:w-1/2">
            <div class="max-w-md">
                <div class="flex items-center gap-3 mb-8">
                    <div class="w-12 h-12 rounded-2xl bg-white shadow-sm flex items-center justify-center text-sky-500 border border-sky-100">
                        <span class="material-symbols-rounded text-3xl">favorite</span>
                    </div>
                    <div>
                        <h1 class="text-2xl font-bold text-slate-800">ClinicSystem</h1>
                        <p class="text-sm font-medium text-sky-600">Patient Care Portal</p>
                    </div>
                </div>

                <h2 class="text-4xl lg:text-5xl font-extrabold text-slate-900 leading-tight mb-6">
                    Your health journey, <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-500 to-emerald-500">simplified.</span>
                </h2>
                
                <p class="text-lg text-slate-600 mb-10 leading-relaxed">
                    Access your medical records, book appointments, and communicate with your doctors securely from the comfort of your home.
                </p>

                <div class="grid gap-4">
                    <div class="feature-card flex items-start gap-4">
                        <div class="bg-sky-100 p-2 rounded-xl text-sky-600 mt-1">
                            <span class="material-symbols-rounded">calendar_month</span>
                        </div>
                        <div>
                            <h3 class="font-bold text-slate-800">Easy Booking</h3>
                            <p class="text-sm text-slate-500 mt-1">Schedule appointments with your preferred doctors in just a few clicks.</p>
                        </div>
                    </div>
                    <div class="feature-card flex items-start gap-4">
                        <div class="bg-emerald-100 p-2 rounded-xl text-emerald-600 mt-1">
                            <span class="material-symbols-rounded">medical_information</span>
                        </div>
                        <div>
                            <h3 class="font-bold text-slate-800">Health Records</h3>
                            <p class="text-sm text-slate-500 mt-1">View your test results, prescriptions, and past visit summaries anytime.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Right Side - Login Form *@
        <div class="flex-1 flex items-center justify-center p-6 md:p-12">
            <div class="w-full max-w-md">
                
                @* Mobile Logo (Hidden on md and up) *@
                <div class="md:hidden flex items-center justify-center gap-2 mb-8">
                     <div class="w-10 h-10 rounded-xl bg-white shadow-sm flex items-center justify-center text-sky-500">
                        <span class="material-symbols-rounded text-2xl">favorite</span>
                    </div>
                    <h1 class="text-xl font-bold text-slate-800">ClinicSystem</h1>
                </div>

                <div class="glass-panel rounded-3xl p-8 sm:p-10">
                    <div class="text-center mb-8">
                        <h2 class="text-2xl font-extrabold text-slate-900 mb-2">Welcome Back</h2>
                        <p class="text-slate-500 font-medium">Log in to manage your health</p>
                    </div>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="mb-6 rounded-2xl bg-red-50 border border-red-100 p-4 flex items-start gap-3">
                            <span class="material-symbols-rounded text-red-500 mt-0.5">error</span>
                            <p class="text-sm font-medium text-red-800">We couldn't log you in. Please check your email and password and try again.</p>
                        </div>
                    }

                    <form asp-action="Login" asp-controller="Account" method="post" class="space-y-5">
                        @Html.AntiForgeryToken()

                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2" asp-for="Email">Email Address</label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-rounded text-slate-400">mail</span>
                                <input asp-for="Email" type="email" placeholder="you@example.com" class="input-field w-full rounded-2xl py-3.5 pl-12 pr-4 outline-none focus:ring-0" />
                            </div>
                            <span asp-validation-for="Email" class="text-xs text-red-500 mt-1 block font-medium"></span>
                        </div>

                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2" asp-for="Password">Password</label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-rounded text-slate-400">lock</span>
                                <input asp-for="Password" type="password" id="patientPassword" placeholder="••••••••" class="input-field w-full rounded-2xl py-3.5 pl-12 pr-12 outline-none focus:ring-0" />
                                <button type="button" onclick="togglePatientPassword()" class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-sky-600 transition-colors">
                                    <span id="patientEye" class="material-symbols-rounded">visibility</span>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-xs text-red-500 mt-1 block font-medium"></span>
                        </div>

                        <div class="flex items-center justify-between pt-1">
                            <label class="flex items-center gap-2 cursor-pointer group">
                                <input asp-for="RememberMe" type="checkbox" class="w-4 h-4 rounded text-sky-500 border-slate-300 focus:ring-sky-500" />
                                <span class="text-sm font-medium text-slate-600 group-hover:text-slate-900 transition-colors">Remember me</span>
                            </label>
                            <a asp-action="ResetPassword" asp-controller="User" class="text-sm font-bold text-sky-600 hover:text-sky-700 transition-colors">Forgot Password?</a>
                        </div>

                        <button type="submit" class="btn-primary w-full rounded-2xl py-4 font-bold text-white flex items-center justify-center gap-2 mt-4 text-lg">
                            Sign In
                            <span class="material-symbols-rounded text-xl">arrow_forward</span>
                        </button>
                    </form>

                    <div class="mt-8 text-center">
                        <p class="text-slate-600 font-medium">
                            New to our clinic? 
                            <a asp-action="Register" asp-controller="Account" class="font-bold text-sky-600 hover:text-sky-700 transition-colors underline decoration-2 underline-offset-4 decoration-sky-200 hover:decoration-sky-500">Create an account</a>
                        </p>
                    </div>
                </div>
                
                <div class="text-center mt-8">
                     <a asp-action="LoginDoctor" asp-controller="Account" class="text-sm font-medium text-slate-500 hover:text-slate-800 transition-colors flex items-center justify-center gap-1">
                         <span class="material-symbols-rounded text-[16px]">admin_panel_settings</span>
                         Staff Login
                     </a>
                </div>
            </div>
        </div>
    </div>

    <script>
        function togglePatientPassword() {
            const input = document.getElementById('patientPassword');
            const icon = document.getElementById('patientEye');
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility_off';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility';
            }
        }
    </script>
</body>
</html>
