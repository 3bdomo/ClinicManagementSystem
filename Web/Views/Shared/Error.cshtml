@model UI.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="flex items-center justify-center min-h-[70vh] px-4">
    <div class="max-w-lg w-full bg-white rounded-3xl shadow-xl ring-1 ring-slate-200/50 p-8 sm:p-12 text-center relative overflow-hidden">
        
        <!-- Background decorative elements -->
        <div class="absolute -top-24 -right-24 w-48 h-48 bg-red-50 rounded-full blur-3xl opacity-60"></div>
        <div class="absolute -bottom-24 -left-24 w-48 h-48 bg-rose-50 rounded-full blur-3xl opacity-60"></div>

        <div class="relative z-10">
            <div class="mx-auto flex items-center justify-center h-20 w-20 rounded-full bg-red-100 mb-6">
                <span class="material-symbols-outlined text-red-600 text-4xl">error</span>
            </div>

            <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight mb-3">Oops! Something went wrong.</h1>
            <p class="text-slate-500 mb-8 leading-relaxed">
                We're sorry, but an unexpected error occurred while processing your request. Please try again later.
            </p>

            @if (Model.ShowRequestId)
            {
                <div class="bg-slate-50 rounded-2xl p-4 mb-8 text-left border border-slate-100">
                    <p class="text-sm text-slate-500 font-medium mb-1">Request ID</p>
                    <code class="text-slate-800 text-sm font-mono break-all">@Model.RequestId</code>
                </div>
            }

            <div class="flex flex-col sm:flex-row gap-3 justify-center">
                <a href="~/" class="inline-flex justify-center items-center px-6 py-3 border border-transparent text-sm font-semibold rounded-xl text-white bg-slate-900 hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-900 transition-colors shadow-sm">
                    <span class="material-symbols-outlined text-sm mr-2">home</span>
                    Back to Dashboard
                </a>
                <button onclick="window.history.back()" class="inline-flex justify-center items-center px-6 py-3 border border-slate-200 text-sm font-semibold rounded-xl text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-200 transition-colors">
                    <span class="material-symbols-outlined text-sm mr-2">arrow_back</span>
                    Go Back
                </button>
            </div>
        </div>
    </div>
</div>
