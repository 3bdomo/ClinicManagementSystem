<header class="h-20 bg-white/80 backdrop-blur border-b border-slate-200 flex items-center justify-between px-8 sticky top-0 z-30">
    <div>
        <p class="text-sm text-slate-500">ClinicSystem</p>
        <h2 class="text-2xl font-black tracking-tight">@ViewData["Title"]</h2>
    </div>
    <div class="flex items-center gap-3">

        @* زرار New Appointment - يظهر فقط للأدمن والريسبشنست *@
        @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
        {
            <a class="px-4 py-2 rounded-lg bg-blue-600 text-white font-bold flex items-center gap-2"
               asp-controller="Appointment" asp-action="Book">
                <span class="material-symbols-outlined text-[18px]">add</span>
                New Appointment
            </a>
        }

        @* زرار Book للدكتور *@
        @if (User.IsInRole("Doctor"))
        {
            <a class="px-4 py-2 rounded-lg bg-blue-600 text-white font-bold flex items-center gap-2"
               asp-controller="Appointment" asp-action="Index">
                <span class="material-symbols-outlined text-[18px]">event</span>
                My Appointments
            </a>
        }

        @* زرار Book Slot للمريض *@
        @if (User.IsInRole("Patient"))
        {
            <a class="px-4 py-2 rounded-lg bg-blue-600 text-white font-bold flex items-center gap-2"
               asp-controller="Appointment" asp-action="BookSlot">
                <span class="material-symbols-outlined text-[18px]">event_available</span>
                Book Appointment
            </a>
        }

        @* أيقونة الپروفايل - فقط للمريض *@
        @if (User.IsInRole("Patient"))
        {
            <a class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center hover:bg-slate-200 transition-colors"
               asp-controller="Patient" asp-action="MyProfile"
               title="My Profile">
                <span class="material-symbols-outlined">account_circle</span>
            </a>
        }

    </div>
</header>
