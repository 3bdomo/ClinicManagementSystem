<div class="rounded-xl border border-outline-variant bg-white p-4 text-sm text-slate-600">
    <h4 class="font-black text-slate-900 mb-2">Audit Info</h4>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <p><strong>Created By:</strong> System Admin</p>
        <p><strong>Created At:</strong> @DateTime.Now.AddDays(-7).ToString("yyyy-MM-dd HH:mm")</p>
        <p><strong>Updated By:</strong> System Admin</p>
        <p><strong>Updated At:</strong> @DateTime.Now.ToString("yyyy-MM-dd HH:mm")</p>
    </div>
</div>
