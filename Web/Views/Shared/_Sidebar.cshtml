<style>
    .sidebar-scroll-left {
        direction: rtl;
        scrollbar-width: thin;
        scrollbar-color: #334155 transparent;
    }
    
    .sidebar-scroll-left > * {
        direction: ltr;
    }

    /* Custom Scrollbar for Chrome/Safari/Edge */
    .sidebar-scroll-left::-webkit-scrollbar {
        width: 5px;
    }
    
    .sidebar-scroll-left::-webkit-scrollbar-track {
        background: transparent;
    }
    
    .sidebar-scroll-left::-webkit-scrollbar-thumb {
        background: #1e293b;
        border-radius: 10px;
    }

    .sidebar-scroll-left::-webkit-scrollbar-thumb:hover {
        background: #334155;
    }
</style>

<aside class="fixed left-0 top-0 h-full w-[260px] z-50 bg-slate-950 border-r border-slate-800 flex flex-col py-6">


    <div class="px-6 mb-8 flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-blue-600 flex items-center justify-center">
            <span class="material-symbols-outlined text-white">medical_services</span>
        </div>
        <div>
            <h1 class="text-lg font-black text-white leading-tight">ClinicSystem</h1>
            <p class="text-[10px] uppercase tracking-widest text-slate-500 font-bold">Medical Management</p>
        </div>
    </div>

    
    <nav class="flex-1 overflow-y-auto sidebar-scroll-left px-2">
        <div class="space-y-1">

        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <a class="clinic-nav-link" asp-controller="Home" asp-action="Dashboard">
                <span class="material-symbols-outlined">dashboard</span>Dashboard
            </a>
        }

        <p class="mt-4 mb-1 px-3 text-[10px] font-black uppercase tracking-widest text-blue-500">AI Features 🔬</p>
        <a class="clinic-nav-link" asp-controller="LabAnalyzer" asp-action="Index">
            <span class="material-symbols-outlined text-blue-400">science</span>Medical Lab Analyst
        </a>

       
        @if (User.IsInRole("Admin"))
        {
            <p class="mt-4 mb-1 px-3 text-[10px] font-black uppercase tracking-widest text-slate-500">Patients</p>
            <a class="clinic-nav-link" asp-controller="Patient" asp-action="Index">
                <span class="material-symbols-outlined">manage_search</span>Patient Search
            </a>
            <a class="clinic-nav-link" asp-controller="Patient" asp-action="Deleted">
                <span class="material-symbols-outlined">restore_from_trash</span>Deleted Patients
            </a>

            <p class="mt-4 mb-1 px-3 text-[10px] font-black uppercase tracking-widest text-slate-500">Scheduling</p>
            <a class="clinic-nav-link" asp-controller="Appointment" asp-action="Index">
                <span class="material-symbols-outlined">event</span>Appointments
            </a>
            <a class="clinic-nav-link" asp-controller="Doctor" asp-action="Index">
                <span class="material-symbols-outlined">stethoscope</span>Doctors
            </a>
                <a class="clinic-nav-link" asp-controller="Receptionist" asp-action="Index">
                    <span class="material-symbols-outlined">stethoscope</span>Receptionist
                </a>
            <a class="clinic-nav-link" asp-controller="DoctorSchedule" asp-action="Index">
                <span class="material-symbols-outlined">calendar_month</span>Doctor Schedules
            </a>

            <p class="mt-4 mb-1 px-3 text-[10px] font-black uppercase tracking-widest text-slate-500">Finance</p>
            <a class="clinic-nav-link" asp-controller="Billing" asp-action="Index">
                <span class="material-symbols-outlined">receipt_long</span>Billing
            </a>
            <a class="clinic-nav-link" asp-controller="Billing" asp-action="DailyReport">
                <span class="material-symbols-outlined">summarize</span>Billing Reports
            </a>

            <p class="mt-4 mb-1 px-3 text-[10px] font-black uppercase tracking-widest text-slate-500">System</p>
            <a class="clinic-nav-link" asp-controller="User" asp-action="Index">
                <span class="material-symbols-outlined">group</span>Staff Users
            </a>
            <a class="clinic-nav-link" asp-controller="Procedure" asp-action="ManageTypes">
                <span class="material-symbols-outlined">analytics</span>Procedure Types
            </a>
        }

  
        @if (User.IsInRole("Doctor"))
        {
            <p class="mt-4 mb-1 px-3 text-[10px] font-black uppercase tracking-widest text-slate-500">My Work</p>

            <a class="clinic-nav-link" asp-controller="Appointment" asp-action="Index">
                <span class="material-symbols-outlined">event</span>My Appointments
            </a>

            <a class="clinic-nav-link" asp-controller="MedicalRecord" asp-action="Index">
                <span class="material-symbols-outlined">clinical_notes</span>Medical Records
            </a>

            <a class="clinic-nav-link" asp-controller="DoctorSchedule" asp-action="Index">
                <span class="material-symbols-outlined">calendar_month</span>My Schedule
            </a>

            <a class="clinic-nav-link" asp-controller="FollowUp" asp-action="Index">
                <span class="material-symbols-outlined">notification_important</span>Follow Ups
            </a>

            <p class="mt-4 mb-1 px-3 text-[10px] font-black uppercase tracking-widest text-slate-500">Clinical</p>

            <a class="clinic-nav-link" asp-controller="MedicalRecord" asp-action="Create">
                <span class="material-symbols-outlined">clinical_notes</span>Add Medical Record
            </a>

            <a class="clinic-nav-link" asp-controller="Procedure" asp-action="Create">
                <span class="material-symbols-outlined">medical_information</span>Add Procedure
            </a>

            <a class="clinic-nav-link" asp-controller="Patient" asp-action="Index">
                <span class="material-symbols-outlined">manage_search</span>Patient Search
            </a>
        }
        @if (User.IsInRole("Receptionist"))
        {
            <p class="mt-4 mb-1 px-3 text-[10px] font-black uppercase tracking-widest text-slate-500">Front desk</p>
            <a class="clinic-nav-link" asp-controller="Appointment" asp-action="Index">
                <span class="material-symbols-outlined">event</span>Appointments
            </a>
            <a class="clinic-nav-link" asp-controller="Appointment" asp-action="BookStep1">
                <span class="material-symbols-outlined">event_available</span>Book Appointment
            </a>
            <a class="clinic-nav-link" asp-controller="Patient" asp-action="Index">
                <span class="material-symbols-outlined">manage_search</span>Patient Search
            </a>
            <a class="clinic-nav-link" asp-controller="Patient" asp-action="Create">
                <span class="material-symbols-outlined">person_add</span>New Patient
            </a>
            <a class="clinic-nav-link" asp-controller="FollowUp" asp-action="Index">
                <span class="material-symbols-outlined">notification_important</span>Follow Ups
            </a>

            <p class="mt-4 mb-1 px-3 text-[10px] font-black uppercase tracking-widest text-slate-500">Billing</p>
            <a class="clinic-nav-link" asp-controller="Billing" asp-action="Index">
                <span class="material-symbols-outlined">receipt_long</span>Billing
            </a>
            <a class="clinic-nav-link" asp-controller="Billing" asp-action="Create">
                <span class="material-symbols-outlined">add_card</span>Create Invoice
            </a>
        }

     
        @if (User.IsInRole("Patient"))
        {
            <p class="mt-4 mb-1 px-3 text-[10px] font-black uppercase tracking-widest text-slate-500">My portal</p>
            <a class="clinic-nav-link" asp-controller="Patient" asp-action="MyProfile">
                <span class="material-symbols-outlined">account_circle</span>My Profile
            </a>
            <a class="clinic-nav-link" asp-controller="Appointment" asp-action="Index">
                <span class="material-symbols-outlined">event_note</span>My Appointments
            </a>
            <a class="clinic-nav-link" asp-controller="Appointment" asp-action="BookStep1">
                <span class="material-symbols-outlined">event_available</span>Book Appointment
            </a>
            <a class="clinic-nav-link" asp-controller="Doctor" asp-action="Index">
                <span class="material-symbols-outlined">stethoscope</span>Our Doctors
            </a>
        }

        @if (!(User.Identity?.IsAuthenticated ?? false))
        {
            <a class="clinic-nav-link" asp-controller="Account" asp-action="Login">
                <span class="material-symbols-outlined">login</span>Login
            </a>
            <a class="clinic-nav-link" asp-controller="Account" asp-action="Register">
                <span class="material-symbols-outlined">person_add</span>Register
            </a>
        }
        </div>
    </nav>


  
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <div class="px-4 pt-4 border-t border-slate-800">
            <div class="mb-2 px-3 py-2">
                <p class="text-xs font-bold text-slate-400 truncate">@User.Identity.Name</p>
                @if (User.IsInRole("Admin"))
                {
                    <p class="text-[10px] text-slate-600">Admin</p>
                }
                else if (User.IsInRole("Doctor"))
                {
                    <p class="text-[10px] text-slate-600">Doctor</p>
                }
                else if (User.IsInRole("Receptionist"))
                {
                    <p class="text-[10px] text-slate-600">Receptionist</p>
                }
                else if (User.IsInRole("Patient"))
                {
                    <p class="text-[10px] text-slate-600">Patient</p>
                }
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="clinic-nav-link w-full text-left">
                    <span class="material-symbols-outlined">logout</span>Logout
                </button>
            </form>
        </div>
    }
</aside>
